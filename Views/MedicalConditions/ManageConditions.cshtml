@model IEnumerable<Wellness_Wardens_Project.Models.AdministrationSubsystem.MedicalCondition>

@{
    ViewData["Title"] = "Manage Medical Conditions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/admin.css" rel="stylesheet" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-primary"><i class="bi bi-heart-pulse me-2"></i>Medical Conditions Master List</h2>
    <div>
        <a asp-controller="Administration" asp-action="Dashboard" class="btn btn-outline-primary me-2">
            <i class="bi bi-house-door me-1"></i> Dashboard
        </a>
        <a asp-action="AddCondition" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add Condition
        </a>
    </div>
</div>

<div class="mb-3">
    <input type="text" id="conditionSearch" class="form-control" placeholder="Search medical conditions by name or description...">
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle text-center" id="conditionTable">
        <thead class="table-primary">
            <tr>
                <th>Condition Name</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var condition in Model)
            {
                <tr>
                    <td class="text-primary fw-bold">@condition.Name</td>
                    <td>@(string.IsNullOrEmpty(condition.Description) ? "No description" : condition.Description)</td>
                    <td>
                        <a href="@Url.Action("EditCondition", new { id = condition.MedicalConditionId })"
                           class="btn btn-sm btn-outline-primary me-2">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#deleteModal-@condition.MedicalConditionId">
                            <i class="bi bi-trash3-fill"></i> Delete
                        </button>
                    </td>
                </tr>

                <!-- Delete Confirmation Modal -->
                <div class="modal fade" id="deleteModal-@condition.MedicalConditionId" tabindex="-1"
                     aria-labelledby="deleteModalLabel-@condition.MedicalConditionId" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form asp-action="DeleteCondition" method="post">
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", condition.MedicalConditionId)

                                <div class="modal-header bg-danger text-white">
                                    <h5 class="modal-title" id="deleteModalLabel-@condition.MedicalConditionId">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Medical Condition
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>

                                <div class="modal-body">
                                    <p class="fw-bold">Are you sure you want to delete this medical condition?</p>
                                    <ul class="list-group">
                                        <li class="list-group-item"><strong>Name:</strong> @condition.Name</li>
                                        <li class="list-group-item"><strong>Description:</strong> @(string.IsNullOrEmpty(condition.Description) ? "No description" : condition.Description)</li>
                                    </ul>
                                </div>

                                <div class="modal-footer">
                                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Search functionality
        $(document).ready(function () {
            $("#conditionSearch").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#conditionTable tbody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });

        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: '@TempData["SuccessMessage"]',
                    showConfirmButton: false,
                    timer: 3000
                });
            </text>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            foreach (var modelState in ViewData.ModelState.Values)
            {
                foreach (var error in modelState.Errors)
                {
                    <text>
                                Swal.fire({
                                    toast: true,
                                    position: 'top-end',
                                    icon: 'error',
                                    title: '@error.ErrorMessage',
                                    showConfirmButton: false,
                                    timer: 3000
                                });
                    </text>
                }
            }
        }
    </script>
}