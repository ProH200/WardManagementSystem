@model IEnumerable<Wellness_Wardens_Project.ViewModels.ConsumableViewModel>
@{
    ViewData["Title"] = "Weekly Stock Take";
    Layout = "_Layout";
    var reportDate = ViewBag.ReportDate as string ?? DateTime.Now.ToString("yyyy-MM-dd");
    var totalItems = Model.Count();
    var lowStockCount = Model.Count(c => c.QuantityAvailable < 20);
    var criticalCount = Model.Count(c => c.QuantityAvailable < 5);
    var outOfStockCount = Model.Count(c => c.QuantityAvailable == 0);
}
<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="dashboard-header bg-info text-white p-4 rounded-3">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h1 class="display-6 fw-bold">Weekly Stock Take</h1>
                        <p class="lead mb-0">Inventory report generated on @DateTime.Now.ToString("MMM dd, yyyy")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <a asp-controller="Dashboard" asp-action="StockManager" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>
    <!-- Stock Take Report -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Complete Inventory List</h5>
                    <span class="badge bg-light text-dark">Generated: @DateTime.Now.ToString("MMM dd, yyyy HH:mm")</span>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <!-- Sorting Controls - MOVED TO TOP -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="card bg-light">
                                    <div class="card-body py-3">
                                        <div class="d-flex align-items-center">
                                            <span class="me-3"><strong>Sort by:</strong></span>
                                            <div class="btn-group" role="group">
                                                <button type="button" class="btn btn-outline-primary active" data-sort="name-asc">
                                                    <i class="fas fa-sort-alpha-down me-2"></i>Name (A-Z)
                                                </button>
                                                <button type="button" class="btn btn-outline-primary" data-sort="status-priority">
                                                    <i class="fas fa-exclamation-triangle me-2"></i>Stock Status
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="stockTakeTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Name</th>
                                        <th>Ward</th>
                                        <th>Quantity Available</th>
                                        <th>Status</th>
                                        <th>Action Required</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.OrderBy(c => c.WardName).ThenBy(c => c.Name))
                                    {
                                        <tr class="align-middle @(item.QuantityAvailable == 0 ? "table-danger"
                                : item.QuantityAvailable < 5 ? "table-warning"
                                : item.QuantityAvailable < 20 ? "table-light" : "")">
                                            <td><strong>@item.Name</strong></td>
                                            <td>@item.WardName</td>
                                            <td>
                                                <span class="badge bg-@item.StatusColor fs-6">@item.QuantityAvailable</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-@item.StatusColor">@item.StockStatus</span>
                                            </td>
                                            <td>
                                                @if (item.QuantityAvailable < 20)
                                                {
                                                    <a href="@Url.Action("Create", "ConsumablesRequest")"
                                                       class="btn btn-sm btn-outline-warning"
                                                       data-bs-toggle="tooltip"
                                                       title="Send a request to restock this item">
                                                        <i class="fas fa-cart-plus me-1"></i> Order More
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">None</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Summary Section -->
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6>📈 Stock Level Summary</h6>
                                        <canvas id="stockChart" height="250"></canvas>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <!-- Priority Actions Card -->
                                <div class="card bg-light mb-3">
                                    <div class="card-body">
                                        <h6>Comments</h6>
                                        @if (criticalCount > 0)
                                        {
                                            <div class="alert alert-danger">
                                                <i class="fas fa-exclamation-circle me-2"></i>
                                                <strong>@criticalCount critical items</strong> need immediate attention!
                                            </div>
                                        }
                                        @if (lowStockCount > 0)
                                        {
                                            <div class="alert alert-warning">
                                                <i class="fas fa-exclamation-triangle me-2"></i>
                                                <strong>@lowStockCount items</strong> are running low. Consider reordering.
                                            </div>
                                        }
                                        @if (criticalCount == 0 && lowStockCount == 0)
                                        {
                                            <div class="alert alert-success">
                                                <i class="fas fa-check-circle me-2"></i>
                                                <strong>All stock levels are in stock.</strong>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                            <h4 class="text-muted">No consumables found</h4>
                            <p class="text-muted">There are no consumable items in the system.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            initializeSorting();
            initializeChart();
        });

        function initializeSorting() {
            const sortButtons = document.querySelectorAll('[data-sort]');
            let currentSort = 'name-asc'; // Default sort

            sortButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const sortType = this.getAttribute('data-sort');

                    // Update active button state
                    sortButtons.forEach(btn => {
                        btn.classList.remove('active');
                        btn.classList.add('btn-outline-primary');
                        btn.classList.remove('btn-primary');
                    });

                    this.classList.add('active');
                    this.classList.remove('btn-outline-primary');
                    this.classList.add('btn-primary');

                    // Perform sorting
                    sortTable(sortType);
                    currentSort = sortType;
                });
            });

            function sortTable(sortType) {
                const table = document.getElementById('stockTakeTable');
                const tbody = table.querySelector('tbody');
                const rows = Array.from(tbody.querySelectorAll('tr'));

                rows.sort((a, b) => {
                    if (sortType === 'name-asc') {
                        return sortByName(a, b, 'asc');
                    } else if (sortType === 'status-priority') {
                        return sortByStatusPriority(a, b);
                    }
                    return 0;
                });

                // Reappend sorted rows
                rows.forEach(row => tbody.appendChild(row));
            }

            function sortByName(a, b, direction) {
                const aName = a.cells[0].textContent.trim().toLowerCase();
                const bName = b.cells[0].textContent.trim().toLowerCase();

                if (aName < bName) return direction === 'asc' ? -1 : 1;
                if (aName > bName) return direction === 'asc' ? 1 : -1;
                return 0;
            }

            function sortByStatusPriority(a, b) {
                // Define status priority order: Critical → Out of Stock → Low Stock → In Stock
                const statusPriority = {
                    'Critical': 0,
                    'Out of Stock': 1,
                    'Low Stock': 2,
                    'In Stock': 3
                };

                const aStatus = a.cells[3].querySelector('.badge').textContent.trim();
                const bStatus = b.cells[3].querySelector('.badge').textContent.trim();

                const aPriority = statusPriority[aStatus] || 4;
                const bPriority = statusPriority[bStatus] || 4;

                // If same status, sort by name A-Z
                if (aPriority === bPriority) {
                    return sortByName(a, b, 'asc');
                }

                return aPriority - bPriority;
            }

            // Apply default sort on load
            sortTable(currentSort);
        }

        function initializeChart() {
            const ctx = document.getElementById('stockChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['In Stock', 'Low Stock', 'Critical Stock', 'Out of Stock'],
                    datasets: [{
                        data: [@(totalItems - lowStockCount), @(lowStockCount - criticalCount), @criticalCount, @outOfStockCount],
                        backgroundColor: ['#28a745', '#ffc107', '#fd7e14', '#dc3545']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: { enabled: true }
                    }
                },
                plugins: [{
                    id: 'centerText',
                    afterDraw: function(chart) {
                        const { ctx, width } = chart;
                        ctx.save();
                        ctx.font = 'bold 16px sans-serif';
                        ctx.textAlign = 'center';
                        ctx.textBaseline = 'middle';
                        ctx.fillText('Total', width / 2, chart.chartArea.top + (chart.chartArea.bottom - chart.chartArea.top) / 2 - 10);
                        ctx.fillText(@totalItems.ToString(), width / 2, chart.chartArea.top + (chart.chartArea.bottom - chart.chartArea.top) / 2 + 10);
                        ctx.restore();
                    }
                }]
            });
        }
    </script>

    <style>
        .btn-group .btn {
            border-radius: 0.375rem;
            margin-right: 0.5rem;
        }

            .btn-group .btn:last-child {
                margin-right: 0;
            }

        .btn-primary {
            border-color: #0d6efd;
        }
    </style>
}