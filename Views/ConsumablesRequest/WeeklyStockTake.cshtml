@model IEnumerable<Wellness_Wardens_Project.ViewModels.ConsumableViewModel>
@{
    ViewData["Title"] = "Weekly Stock Take";
    Layout = "_Layout";
    var reportDate = ViewBag.ReportDate as string ?? DateTime.Now.ToString("yyyy-MM-dd");
    var totalItems = Model.Count();
    var lowStockCount = Model.Count(c => c.QuantityAvailable < 20);
    var criticalCount = Model.Count(c => c.QuantityAvailable < 5);
    var outOfStockCount = Model.Count(c => c.QuantityAvailable == 0);
}
<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="dashboard-header bg-info text-white p-4 rounded-3">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h1 class="display-6 fw-bold">Weekly Stock Take</h1>
                        <p class="lead mb-0">Inventory report generated on @DateTime.Now.ToString("MMM dd, yyyy")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <a asp-controller="Dashboard" asp-action="StockManager" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>
    <!-- Stock Take Report -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Complete Inventory List</h5>
                    <span class="badge bg-light text-dark">Generated: @DateTime.Now.ToString("MMM dd, yyyy HH:mm")</span>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="stockTakeTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Name</th>
                                        <th>Ward</th>
                                        <th>Quantity Available</th>
                                        <th>Status</th>
                                        <th>Last Updated</th>
                                        <th>Action Required</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.OrderBy(c => c.WardName).ThenBy(c => c.Name))
                                    {
                                        <tr class="align-middle @(item.QuantityAvailable == 0 ? "table-danger"
                                                        : item.QuantityAvailable < 5 ? "table-warning"
                                                        : item.QuantityAvailable < 20 ? "table-light" : "")">
                                            <td><strong>@item.Name</strong></td>
                                            <td>@item.WardName</td>
                                            <td>
                                                <span class="badge bg-@item.StatusColor fs-6">@item.QuantityAvailable</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-@item.StatusColor">@item.StockStatus</span>
                                            </td>
                                            <td>@DateTime.Now.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                @if (item.QuantityAvailable < 20)
                                                {
                                                    <a href="@Url.Action("Create", "ConsumablesRequest")"
                                                       class="btn btn-sm btn-outline-warning"
                                                       data-bs-toggle="tooltip"
                                                       title="Send a request to restock this item">
                                                        <i class="fas fa-cart-plus me-1"></i> Order More
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">None</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Summary Section -->
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6>📈 Stock Level Summary</h6>
                                        <canvas id="stockChart" height="250"></canvas>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <!-- Priority Actions Card -->
                                <div class="card bg-light mb-3">
                                    <div class="card-body">
                                        <h6>Comments</h6>
                                        @if (criticalCount > 0)
                                        {
                                            <div class="alert alert-danger">
                                                <i class="fas fa-exclamation-circle me-2"></i>
                                                <strong>@criticalCount critical items</strong> need immediate attention!
                                            </div>
                                        }
                                        @if (lowStockCount > 0)
                                        {
                                            <div class="alert alert-warning">
                                                <i class="fas fa-exclamation-triangle me-2"></i>
                                                <strong>@lowStockCount items</strong> are running low. Consider reordering.
                                            </div>
                                        }
                                        @if (criticalCount == 0 && lowStockCount == 0)
                                        {
                                            <div class="alert alert-success">
                                                <i class="fas fa-check-circle me-2"></i>
                                                <strong>All stock levels are in stock.</strong>
                                            </div>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>

                        
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                            <h4 class="text-muted">No consumables found</h4>
                            <p class="text-muted">There are no consumable items in the system.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
        function exportToPDF() {
            try {
                const pdf = new jspdf.jsPDF('p', 'mm', 'a4');

                // Header
                pdf.setFontSize(18);
                pdf.text('Weekly Stock Take Report', 105, 20, { align: 'center' });

                pdf.setFontSize(11);
                pdf.text(`Generated: ${new Date().toLocaleDateString()}`, 105, 28, { align: 'center' });

                // Table Headers
                pdf.setFontSize(10);
                pdf.setFillColor(240, 240, 240);
                pdf.rect(10, 40, 190, 8, 'F');

                pdf.text('Name', 15, 46);
                pdf.text('Ward', 70, 46);
                pdf.text('Quantity', 120, 46);
                pdf.text('Status', 160, 46);

                // Table Rows
                let y = 55;
                const items = @Json.Serialize(Model.Select(c => new
            {
                Name = c.Name,
                WardName = c.WardName,
                QuantityAvailable = c.QuantityAvailable,
                StockStatus = c.StockStatus
            }));

                items.forEach(item => {
                    if (y > 270) { // page break
                        pdf.addPage();
                        y = 20;
                    }

                    pdf.text(item.name, 15, y);
                    pdf.text(item.wardName, 70, y);
                    pdf.text(item.quantityAvailable.toString(), 120, y);
                    pdf.text(item.stockStatus, 160, y);

                    y += 8;
                });

                // Footer summary
                pdf.setFontSize(11);
                pdf.text(`Total: ${@totalItems} | In Stock: ${totalItems - lowStockCount} | Low: ${@lowStockCount} | Critical: ${@criticalCount} | Out: ${@outOfStockCount}`,
                    105, y + 10, { align: 'center' });

                pdf.save(`weekly-stock-take-${new Date().toISOString().split('T')[0]}.pdf`);
            } catch (err) {
                console.error('PDF export failed', err);
                alert('Failed to generate PDF.');
            }
        }

        // Doughnut Chart with center label
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('stockChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['In Stock', 'Low Stock', 'Critical Stock', 'Out of Stock'],
                    datasets: [{
                        data: [@(totalItems - lowStockCount), @(lowStockCount - criticalCount), @criticalCount, @outOfStockCount],
                        backgroundColor: ['#28a745', '#ffc107', '#fd7e14', '#dc3545']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: { enabled: true },
                        // Custom plugin for center text
                        datalabels: false
                    }
                },
                plugins: [{
                    id: 'centerText',
                    afterDraw: function(chart) {
                        const { ctx, width } = chart;
                        ctx.save();
                        ctx.font = 'bold 16px sans-serif';
                        ctx.textAlign = 'center';
                        ctx.textBaseline = 'middle';
                        ctx.fillText('Total', width / 2, chart.chartArea.top + (chart.chartArea.bottom - chart.chartArea.top) / 2 - 10);
                        ctx.fillText(@totalItems.ToString(), width / 2, chart.chartArea.top + (chart.chartArea.bottom - chart.chartArea.top) / 2 + 10);
                        ctx.restore();
                    }
                }]
            });
        });
    </script>

    <style>
        @@media print {
            .btn, .card-header .badge, .navbar, footer {
                display: none !important;
            }

            .card {
                border: 1px solid #000 !important;
                box-shadow: none !important;
            }

            .table-responsive {
                overflow: visible !important;
            }
        }
    </style>
}
