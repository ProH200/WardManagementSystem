@model Wellness_Wardens_Project.ViewModels.CreateConsumableRequestViewModel
@{
    ViewData["Title"] = "New Consumable Request";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-cart-plus me-2"></i>Create Consumable Request
                    </h4>
                </div>
                <div class="card-body">
                    <!-- Low Stock Suggestions Section -->
                    @if (Model.LowStockSuggestions.Any())
                    {
                        <div class="card mb-4">
                            <div class="card-header bg-warning text-dark">
                                <h5 class="mb-0">⚠️ Low Stock Suggestions</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    @foreach (var suggestion in Model.LowStockSuggestions)
                                    {
                                        <div class="col-md-6 mb-2">
                                            <div class="card">
                                                <div class="card-body py-2">
                                                    <h6 class="card-title">@suggestion.Name</h6>
                                                    <p class="mb-1">Ward: @suggestion.WardName</p>
                                                    <p class="mb-1">Available: <span class="text-danger">@suggestion.QuantityAvailable</span></p>
                                                    <p class="mb-2">Suggested: @suggestion.SuggestedQuantity</p>
                                                    <a href="@Url.Action("UseSuggestion", new { consumableId = suggestion.ConsumableId })"
                                                       class="btn btn-sm btn-warning">Use This</a>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Main Form -->
                    <form asp-action="Create" method="post" id="requestForm">
                        @Html.AntiForgeryToken()

                        <div class="form-group mb-3">
                            <label asp-for="SelectedConsumableId" class="form-label">Consumable</label><span class="text-danger">*</span>
                            <select asp-for="SelectedConsumableId" asp-items="Model.AvailableConsumables"
                                    class="form-control" id="consumableSelect">
                                <option value="">-- Select Consumable --</option>
                            </select>
                            <span asp-validation-for="SelectedConsumableId" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Ward</label>
                            <div class="form-control" id="wardDisplay" style="background-color: #f8f9fa; min-height: 38px; display: flex; align-items: center; padding: 6px 12px;">
                                <span id="wardText" class="text-muted">-- Select a consumable to auto-fill ward --</span>
                            </div>
                            <input type="hidden" asp-for="SelectedWardId" id="selectedWardId" />
                            <span asp-validation-for="SelectedWardId" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="QuantityRequested" class="form-label">Quantity Requested</label><span class="text-danger">*</span>
                            <input asp-for="QuantityRequested" class="form-control" id="quantityInput" min="1" />
                            <span asp-validation-for="QuantityRequested" class="text-danger"></span>
                            <small class="form-text text-muted" id="quantitySuggestion"></small>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Requested Date</label>
                            <input type="text" class="form-control" value="@DateTime.Now.ToString("MMM dd, yyyy")" readonly />
                            <small class="form-text text-muted">Automatically set to current date</small>
                        </div>

                        <div class="row mt-4">
                            <div class="col-md-6">
                                <a asp-action="Index" class="btn btn-secondary w-100">
                                    <i class="fas fa-arrow-left me-2"></i>Back to List
                                </a>
                            </div>
                            <div class="col-md-6">
                                <button type="submit" class="btn btn-primary w-100" id="submitButton">
                                    <i class="fas fa-save me-2"></i>Create Request
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Include SweetAlert2 CSS & JS -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

@section Scripts {
    <!-- Include SweetAlert2 CSS & JS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Form elements
            const consumableSelect = document.getElementById('consumableSelect');
            const wardDisplay = document.getElementById('wardDisplay');
            const wardText = document.getElementById('wardText');
            const selectedWardId = document.getElementById('selectedWardId');
            const quantityInput = document.getElementById('quantityInput');
            const quantitySuggestion = document.getElementById('quantitySuggestion');
            const requestForm = document.getElementById('requestForm');
            const submitButton = document.getElementById('submitButton');

            // Show SweetAlert notifications for TempData messages
            showTempDataAlerts();

            // Initialize form based on pre-selected values
            initializeForm();

            // Event listeners
            consumableSelect.addEventListener('change', handleConsumableChange);
            requestForm.addEventListener('submit', handleFormSubmit);

            function showTempDataAlerts() {
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: '@TempData["SuccessMessage"]',
                            confirmButtonColor: '#3085d6',
                            confirmButtonText: 'View Requests'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = '@Url.Action("Index")';
                            }
                        });
            </text>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: '@TempData["ErrorMessage"]',
                            confirmButtonColor: '#d33',
                            confirmButtonText: 'OK'
                        });
            </text>
        }

        @if (TempData["WarningMessage"] != null)
        {
            <text>
                        Swal.fire({
                            icon: 'warning',
                            title: 'Warning!',
                            text: '@TempData["WarningMessage"]',
                            confirmButtonColor: '#f0ad4e',
                            confirmButtonText: 'OK'
                        });
            </text>
        }

        @if (TempData["InfoMessage"] != null)
        {
            <text>
                        Swal.fire({
                            icon: 'info',
                            title: 'Information',
                            text: '@TempData["InfoMessage"]',
                            confirmButtonColor: '#17a2b8',
                            confirmButtonText: 'OK'
                        });
            </text>
        }
            }

            function initializeForm() {
                // If the form is pre-filled (from UseSuggestion), trigger the change event
                if (consumableSelect.value) {
                    handleConsumableChange();
                }
            }

            function handleConsumableChange() {
                const consumableId = consumableSelect.value;

                if (!consumableId) {
                    resetForm();
                    return;
                }

                loadConsumableDetails(consumableId);
            }

            function resetForm() {
                wardText.textContent = '-- Select a consumable to auto-fill ward --';
                wardText.className = 'text-muted';
                selectedWardId.value = '';
                quantityInput.value = '';
                quantitySuggestion.textContent = '';
                quantitySuggestion.className = 'form-text text-muted';
            }

            function loadConsumableDetails(consumableId) {
                // Show loading state
                wardText.textContent = 'Loading ward information...';
                wardText.className = 'text-info';

                fetch('@Url.Action("GetWardForConsumable", "ConsumablesRequest")?consumableId=' + consumableId)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Network response was not ok');
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            updateFormWithConsumableData(data);
                        } else {
                            showFormError(data.message || 'Could not load ward information for selected consumable.');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showFormError('Error loading consumable details. Please try again.');
                    });
            }

            function updateFormWithConsumableData(data) {
                // Update ward information
                wardText.textContent = data.wardName;
                wardText.className = 'text-dark fw-bold';
                selectedWardId.value = data.wardId;

                // Update quantity information
                quantityInput.value = data.suggestedQuantity;
                quantitySuggestion.textContent = `Suggested quantity to reach minimum stock (currently ${data.currentQuantity} available)`;
                quantitySuggestion.className = 'form-text text-info';

                // Enable submit button if it was disabled
                submitButton.disabled = false;
            }

            function showFormError(message) {
                wardText.textContent = '-- Error loading ward --';
                wardText.className = 'text-danger';
                selectedWardId.value = '';
                quantityInput.value = '';
                quantitySuggestion.textContent = message;
                quantitySuggestion.className = 'form-text text-danger';
            }

            function handleFormSubmit(e) {
                e.preventDefault();

                if (!validateForm()) {
                    return;
                }

                showConfirmationDialog();
            }

            function validateForm() {
                // Check if consumable is selected
                if (!consumableSelect.value) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Missing Information',
                        text: 'Please select a consumable.',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'OK'
                    });
                    consumableSelect.focus();
                    return false;
                }

                // Check if ward is loaded
                if (!selectedWardId.value) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Missing Information',
                        text: 'Please wait for ward information to load or select a different consumable.',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'OK'
                    });
                    return false;
                }

                // Check if quantity is valid
                const quantity = parseInt(quantityInput.value);
                if (!quantity || quantity < 1) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid Quantity',
                        text: 'Please enter a valid quantity (minimum 1).',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'OK'
                    });
                    quantityInput.focus();
                    return false;
                }

                return true;
            }

            function showConfirmationDialog() {
                const consumableName = getSelectedConsumableName();
                const quantity = quantityInput.value;
                const wardName = wardText.textContent;

                Swal.fire({
                    title: 'Confirm Request',
                    html: `
                        <div class="text-start">
                            <p class="mb-3"><strong>Please confirm your request details:</strong></p>
                            <div class="alert alert-info">
                                <div class="mb-2"><strong>Consumable:</strong> ${consumableName}</div>
                                <div class="mb-2"><strong>Quantity:</strong> ${quantity}</div>
                                <div class="mb-0"><strong>Ward:</strong> ${wardName}</div>
                            </div>
                            <p class="text-muted mt-2 mb-0"><small>This request will be submitted for processing and delivery.</small></p>
                        </div>
                    `,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: '<i class="fas fa-check me-2"></i>Create Request',
                    cancelButtonText: '<i class="fas fa-times me-2"></i>Cancel',
                    reverseButtons: true,
                    width: '600px'
                }).then((result) => {
                    if (result.isConfirmed) {
                        submitForm();
                    }
                });
            }

            function getSelectedConsumableName() {
                const selectedOption = consumableSelect.options[consumableSelect.selectedIndex];
                if (!selectedOption) return 'Selected item';

                // Extract just the consumable name (remove ward and quantity info)
                const fullText = selectedOption.text;
                return fullText.split(' (')[0] || 'Selected item';
            }

            function submitForm() {
                // Show loading state
                submitButton.disabled = true;
                submitButton.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Creating Request...';

                // Submit the form
                requestForm.submit();
            }
        });
    </script>

    <style>
        .swal2-popup {
            font-size: 1rem;
            border-radius: 0.5rem;
        }

        .swal2-title {
            font-size: 1.5rem;
            font-weight: 600;
        }

        .btn:disabled {
            cursor: not-allowed;
            opacity: 0.6;
        }

        .fa-spinner {
            animation: spin 1s linear infinite;
        }

        #wardDisplay {
            transition: all 0.3s ease;
            border: 1px solid #ced4da;
        }

            #wardDisplay:hover {
                border-color: #86b7fe;
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
            }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }
    </style>
}

    <style>
        .swal2-popup {
            font-size: 1rem;
        }

        .btn:disabled {
            cursor: not-allowed;
            opacity: 0.6;
        }

        .fa-spinner {
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }
    </style>