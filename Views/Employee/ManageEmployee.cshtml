@model IEnumerable<Wellness_Wardens_Project.Models.AdministrationSubsystem.Employee>

@{
    ViewData["Title"] = "Manage Employees";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg rounded-3 border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0"><i class="bi bi-people-fill me-2"></i> Manage Employees</h3>
            <div class="d-flex gap-2">
                <a asp-controller="Administration" asp-action="Dashboard" class="btn btn-light">
                    <i class="bi bi-house-door me-1"></i> Dashboard
                </a>
                <a asp-action="AddEmployee" asp-controller="Employee" class="btn btn-light">
                    <i class="bi bi-person-plus-fill me-1"></i> Add Employee
                </a>
            </div>
        </div>

        <div class="card-body">
            <!-- Search / Filter / Sort Controls -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <input type="text" id="employeeSearch" class="form-control" placeholder="Search employees by name, role, or title...">
                </div>
                <div class="col-md-4">
                    <select id="sortSelect" class="form-select">
                        <option value="name-asc">Sort by: Name (A-Z)</option>
                        <option value="name-desc">Sort by: Name (Z-A)</option>
                        <option value="role-asc">Sort by: Role (A-Z)</option>
                        <option value="role-desc">Sort by: Role (Z-A)</option>
                        <option value="title-asc">Sort by: Title (A-Z)</option>
                        <option value="title-desc">Sort by: Title (Z-A)</option>
                        <option value="gender-asc">Sort by: Gender (A-Z)</option>
                        <option value="gender-desc">Sort by: Gender (Z-A)</option>
                        <option value="specialization-asc">Sort by: Specialization (A-Z)</option>
                        <option value="specialization-desc">Sort by: Specialization (Z-A)</option>
                    </select>
                </div>
                <div class="col-md-4 text-end">
                    <span class="badge bg-success me-2">@Model.Count(e => !e.IsDeleted) Employees</span>
                    <button id="resetSort" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-clockwise"></i> Reset
                    </button>
                </div>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th data-sort="name">
                                Name <i class="bi bi-arrow-down-up sort-icon"></i>
                            </th>
                            <th data-sort="role">
                                Role <i class="bi bi-arrow-down-up sort-icon"></i>
                            </th>
                            <th data-sort="title">
                                Title <i class="bi bi-arrow-down-up sort-icon"></i>
                            </th>
                            <th data-sort="gender">
                                Gender <i class="bi bi-arrow-down-up sort-icon"></i>
                            </th>
                            <th>Phone</th>
                            <th data-sort="specialization">
                                Specialization <i class="bi bi-arrow-down-up sort-icon"></i>
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="employeeTable">
                        @foreach (var emp in Model)
                        {
                            <tr data-name="@emp.FirstName @emp.LastName"
                                data-role="@emp.Role"
                                data-title="@emp.Title"
                                data-gender="@emp.Gender"
                                data-specialization="@emp.Specialization">
                                <td>
                                    <strong>@emp.FirstName @emp.LastName</strong>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">@emp.Role</span>
                                </td>
                                <td>@emp.Title</td>
                                <td>@emp.Gender</td>
                                <td>@emp.PhoneNumber</td>
                                <td>@emp.Specialization</td>
                                <td>
                                    <a href="@Url.Action("EditEmployee", "Employee", new { id = emp.Id })"
                                       class="btn btn-sm btn-outline-primary me-2">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@emp.Id">
                                        <i class="bi bi-trash3-fill"></i> Delete
                                    </button>
                                </td>
                            </tr>

                            <!-- Delete Confirmation Modal -->
                            <div class="modal fade" id="deleteModal-@emp.Id" tabindex="-1" aria-labelledby="deleteModalLabel-@emp.Id" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form asp-action="SoftDeleteEmployee" method="post">
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", emp.Id)

                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title" id="deleteModalLabel-@emp.Id"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Employee</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>

                                            <div class="modal-body">
                                                <p class="fw-bold">Are you sure you want to delete this employee?</p>

                                                <ul class="list-group">
                                                    <li class="list-group-item"><strong>Name:</strong> @emp.FirstName @emp.LastName</li>
                                                    <li class="list-group-item"><strong>Role:</strong> @emp.Role</li>
                                                    <li class="list-group-item"><strong>Phone:</strong> @emp.PhoneNumber</li>
                                                </ul>
                                            </div>

                                            <div class="modal-footer">
                                                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Help Animation-->
<style>
    /* Container fixed bottom right */
    #doctor-note {
        position: fixed;
        bottom: 70px;
        right: 20px;
        z-index: 1050;
        display: flex;
        align-items: center;
        background: #f8f9fa;
        border: 2px solid #0d6efd;
        border-radius: 12px;
        padding: 8px 12px;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
        max-width: 260px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        animation: floatUpDown 4s ease-in-out infinite;
        cursor: default;
        user-select: none;
    }

        /* Doctor SVG size */
        #doctor-note svg {
            width: 40px;
            height: 40px;
            margin-right: 10px;
            flex-shrink: 0;
        }

    /* Floating animation */
    @@keyframes floatUpDown {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-6px);
        }
    }

    /* Message styling */
    #doctor-note p {
        margin: 0;
        color: #0d6efd;
        font-weight: 600;
        font-size: 13px;
        line-height: 1.2;
        font-family: 'Montserrat', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        letter-spacing: 0.03em;
        text-shadow: 0 0 1px rgba(0,0,0,0.1);
    }

    /* Sort icon styling */
    .sort-icon {
        font-size: 0.8em;
        margin-left: 5px;
        opacity: 0.6;
        cursor: pointer;
    }

    th[data-sort]:hover {
        background-color: #f8f9fa;
        cursor: pointer;
    }

    .sort-asc::after {
        content: " ↑";
        font-weight: bold;
        color: #0d6efd;
    }

    .sort-desc::after {
        content: " ↓";
        font-weight: bold;
        color: #0d6efd;
    }
</style>

<div id="doctor-note" role="alert" aria-live="polite" aria-atomic="true" title="Need help? Click the '?' on the bottom right.">
    <!-- Simple cartoon doctor SVG -->
    <svg xmlns="http://www.w3.org/2000/svg" fill="#0d6efd" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <circle cx="32" cy="14" r="12" fill="#0d6efd" />
        <rect x="18" y="26" width="28" height="30" rx="8" ry="8" fill="#0d6efd" />
        <rect x="28" y="34" width="8" height="12" fill="#f8f9fa" />
        <line x1="32" y1="20" x2="32" y2="14" stroke="#f8f9fa" stroke-width="2" />
        <line x1="28" y1="24" x2="36" y2="24" stroke="#f8f9fa" stroke-width="2" />
    </svg>

    <p>If you are unsure about anything,<br>please click the small '?' bellow.</p>
</div>

@section Scripts {
    <script>
        // Simple search filter
        document.getElementById("employeeSearch").addEventListener("keyup", function () {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll("#employeeTable tr");

            rows.forEach(row => {
                let text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? "" : "none";
            });
        });

        // Sorting functionality
        let currentSort = {
            field: 'name',
            direction: 'asc'
        };

        // Sort by dropdown
        document.getElementById('sortSelect').addEventListener('change', function (e) {
            const [field, direction] = e.target.value.split('-');
            sortTable(field, direction);
            updateHeaderClasses(field, direction);
            currentSort = { field, direction };
        });

        // Header click sorting
        document.querySelectorAll('th[data-sort]').forEach(th => {
            th.addEventListener('click', function () {
                const field = this.getAttribute('data-sort');
                let direction = 'asc';

                if (currentSort.field === field) {
                    direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
                }

                sortTable(field, direction);
                updateHeaderClasses(field, direction);
                updateSelectValue(field, direction);
                currentSort = { field, direction };
            });
        });

        // Reset sort button
        document.getElementById('resetSort').addEventListener('click', function () {
            sortTable('name', 'asc');
            updateHeaderClasses('name', 'asc');
            document.getElementById('sortSelect').value = 'name-asc';
            currentSort = { field: 'name', direction: 'asc' };
        });

        function sortTable(field, direction) {
            const tbody = document.getElementById('employeeTable');
            const rows = Array.from(tbody.querySelectorAll('tr'));

            rows.sort((a, b) => {
                let aValue = a.getAttribute(`data-${field}`) || '';
                let bValue = b.getAttribute(`data-${field}`) || '';

                // For badge elements (like role), get the text content
                if (field === 'role') {
                    aValue = a.querySelector('.badge')?.textContent || aValue;
                    bValue = b.querySelector('.badge')?.textContent || bValue;
                }

                aValue = aValue.toString().toLowerCase().trim();
                bValue = bValue.toString().toLowerCase().trim();

                let comparison = 0;
                if (aValue > bValue) {
                    comparison = 1;
                } else if (aValue < bValue) {
                    comparison = -1;
                }

                return direction === 'desc' ? comparison * -1 : comparison;
            });

            // Clear and re-append sorted rows
            tbody.innerHTML = '';
            rows.forEach(row => tbody.appendChild(row));
        }

        function updateHeaderClasses(field, direction) {
            // Remove all sort classes
            document.querySelectorAll('th[data-sort]').forEach(th => {
                th.classList.remove('sort-asc', 'sort-desc');
            });

            // Add class to current sorted header
            const currentHeader = document.querySelector(`th[data-sort="${field}"]`);
            if (currentHeader) {
                currentHeader.classList.add(direction === 'asc' ? 'sort-asc' : 'sort-desc');
            }
        }

        function updateSelectValue(field, direction) {
            document.getElementById('sortSelect').value = `${field}-${direction}`;
        }

        // Initialize with default sort
        document.addEventListener('DOMContentLoaded', function () {
            sortTable('name', 'asc');
            updateHeaderClasses('name', 'asc');
        });
    </script>

    <!-- Toast -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        @if (TempData["SuccessMessage"] != null)
        {
                <text>
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: '@TempData["SuccessMessage"]',
                        showConfirmButton: false,
                        timer: 3000
                    });
                </text>
        }
    </script>
}