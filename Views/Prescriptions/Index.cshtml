@model IEnumerable<Wellness_Wardens_Project.Models.ConsumablesSubsystem.Prescription>

<!-- Back Button -->
<div class="mb-3">
    <a asp-controller="Dashboard" asp-action="ScriptManager" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
    </a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Reference</th>
            <th>Date Written</th>
            <th>Doctor</th>
            <th>Medications</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var prescription in Model)
        {
            <tr>
                <td>
                    @{
                        var datePart = prescription.DateWritten.ToString("MMdd");
                        var initials = prescription.Employee.FirstName[0].ToString() + prescription.Employee.LastName[0].ToString();
                        var idPart = (prescription.PrescriptionId % 1000).ToString("D3");
                    }
                    @($"{datePart}-{initials}-{idPart}")
                </td>
                <td>@prescription.DateWritten.ToString("MMM dd, yyyy")</td>
                <td>@prescription.Employee.FirstName @prescription.Employee.LastName</td>
                <td>
                    @if (prescription.PrescriptionMedications != null && prescription.PrescriptionMedications.Any())
                    {
                        @foreach (var pm in prescription.PrescriptionMedications)
                        {
                            @pm.Medication.Name <br />
                        }
                    }
                    else
                    {
                        <span class="text-muted">No medications linked</span>
                    }
                </td>
                <td>
                    <span class="badge bg-@(prescription.IsDelivered ? "success" : prescription.IsProcessed ? "info" : "warning")">
                        @(prescription.IsDelivered ? "Delivered" : prescription.IsProcessed ? "In Pharmacy" : "Pending")
                    </span>
                </td>
                <td>
                    @if (!prescription.IsProcessed)
                    {
                        <button class="btn btn-sm btn-success send-to-pharmacy" data-id="@prescription.PrescriptionId" data-reference="@($"{datePart}-{initials}-{idPart}")">
                            <i class="fas fa-paper-plane"></i> Send
                        </button>
                    }
                    else if (!prescription.IsDelivered)
                    {
                        <button class="btn btn-sm btn-primary mark-delivered" data-id="@prescription.PrescriptionId" data-reference="@($"{datePart}-{initials}-{idPart}")">
                            <i class="fas fa-check"></i> Deliver
                        </button>
                        <button class="btn btn-sm btn-warning return-pending" data-id="@prescription.PrescriptionId" data-reference="@($"{datePart}-{initials}-{idPart}")">
                            <i class="fas fa-undo"></i> Undo
                        </button>
                    }
                    else
                    {
                        <span class="text-success">Completed</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Send to Pharmacy
            document.querySelectorAll('.send-to-pharmacy').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const reference = this.getAttribute('data-reference');
                    showConfirmation(
                        'Send to Pharmacy?',
                        `Are you sure you want to send prescription <strong>${reference}</strong> to pharmacy?`,
                        'question',
                        'Send to Pharmacy',
                        () => submitForm('SendToPharmacy', id, `Prescription ${reference} sent to pharmacy successfully!`)
                    );
                });
            });

            // Mark as Delivered
            document.querySelectorAll('.mark-delivered').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const reference = this.getAttribute('data-reference');
                    showConfirmation(
                        'Mark as Delivered?',
                        `Are you sure you want to mark prescription <strong>${reference}</strong> as delivered to the ward?`,
                        'question',
                        'Mark Delivered',
                        () => submitForm('MarkAsDelivered', id, `Prescription ${reference} marked as delivered successfully!`)
                    );
                });
            });

            // Return to Pending
            document.querySelectorAll('.return-pending').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const reference = this.getAttribute('data-reference');
                    showConfirmation(
                        'Return to Pending?',
                        `Are you sure you want to return prescription <strong>${reference}</strong> to pending status?`,
                        'warning',
                        'Return to Pending',
                        () => submitForm('ReturnToPending', id, `Prescription ${reference} returned to pending status!`)
                    );
                });
            });

            function showConfirmation(title, html, icon, confirmText, onConfirm) {
                Swal.fire({
                    title: title,
                    html: html,
                    icon: icon,
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: confirmText,
                    cancelButtonText: 'Cancel',
                    showLoaderOnConfirm: true,
                    preConfirm: () => {
                        return new Promise((resolve) => {
                            onConfirm();
                            resolve();
                        });
                    }
                });
            }

            function submitForm(action, id, successMessage) {
                const form = document.createElement('form');
                form.method = 'post';
                form.action = `/Prescriptions/${action}/${id}`;

                const token = document.querySelector('input[name="__RequestVerificationToken"]').cloneNode();
                form.appendChild(token);

                document.body.appendChild(form);
                form.submit();

                // Show success notification
                setTimeout(() => {
                    Swal.fire({
                        title: 'Success!',
                        html: successMessage,
                        icon: 'success',
                        confirmButtonColor: '#28a745',
                        timer: 3000,
                        timerProgressBar: true
                    });
                }, 500);
            }

            // Show success/error messages from TempData (backup for page reloads)
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                    Swal.fire({
                        title: 'Success!',
                        text: '@TempData["SuccessMessage"]',
                        icon: 'success',
                        confirmButtonColor: '#28a745',
                        timer: 3000,
                        timerProgressBar: true
                    });
            </text>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                    Swal.fire({
                        title: 'Error!',
                        text: '@TempData["ErrorMessage"]',
                        icon: 'error',
                        confirmButtonColor: '#d33'
                    });
            </text>
        }
        });
    </script>
}