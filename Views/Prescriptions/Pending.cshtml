@model IEnumerable<Wellness_Wardens_Project.Models.ConsumablesSubsystem.Prescription>
@{
    ViewData["Title"] = "Pending Prescriptions";
    Layout = "_Layout";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <h2 class="card-title mb-0">
                    <i class="fas fa-clock me-2"></i>Pending Prescriptions
                </h2>
                <p class="card-text mb-0">Prescriptions waiting to be sent to pharmacy</p>
            </div>
        </div>
    </div>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Reference</th>
            <th>Date Written</th>
            <th>Doctor</th>
            <th>Medications</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var prescription in Model)
        {
            <tr>
                <td>
                    @{
                        var datePart = prescription.DateWritten.ToString("MMdd");
                        var initials = prescription.Employee.FirstName[0].ToString() + prescription.Employee.LastName[0].ToString();
                        var idPart = (prescription.PrescriptionId % 1000).ToString("D3");
                    }
                    @($"{datePart}-{initials}-{idPart}")
                </td>
                <td>@prescription.DateWritten.ToString("MMM dd, yyyy")</td>
                <td>@prescription.Employee.FirstName @prescription.Employee.LastName</td>
                <td>
                    @if (prescription.PrescriptionMedications != null && prescription.PrescriptionMedications.Any())
                    {
                        @foreach (var pm in prescription.PrescriptionMedications)
                        {
                            @pm.Medication.Name <br />
                        }
                    }
                    else
                    {
                        <span class="text-muted">No medications linked</span>
                    }
                </td>
                <td>
                    <span class="badge bg-warning">Pending</span>
                </td>
                <td>
                    <button class="btn btn-sm btn-success send-to-pharmacy" data-id="@prescription.PrescriptionId" data-reference="@($"{datePart}-{initials}-{idPart}")">
                        <i class="fas fa-paper-plane"></i> Send to Pharmacy
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Empty State -->
@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
        <h3 class="text-muted">No Pending Prescriptions!</h3>
        <p class="text-muted">All prescriptions have been processed.</p>
        <a href="@Url.Action("ScriptManagerDashboard", "Prescriptions")" class="btn btn-primary mt-3">
            <i class="fas fa-home me-2"></i>Return to Dashboard
        </a>
    </div>
}

<div class="mb-3">
    <a asp-controller="Dashboard" asp-action="ScriptManager" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
    </a>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const buttons = document.querySelectorAll('.send-to-pharmacy');
            buttons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const prescriptionId = this.getAttribute('data-id');
                    const reference = this.getAttribute('data-reference');

                    showConfirmation(
                        'Send to Pharmacy?',
                        `Are you sure you want to send prescription <strong>${reference}</strong> to pharmacy?`,
                        'question',
                        'Send to Pharmacy',
                        () => submitForm('SendToPharmacy', prescriptionId, `Prescription ${reference} sent to pharmacy successfully!`)
                    );
                });
            });

            function showConfirmation(title, html, icon, confirmText, onConfirm) {
                Swal.fire({
                    title: title,
                    html: html,
                    icon: icon,
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: confirmText,
                    cancelButtonText: 'Cancel',
                    showLoaderOnConfirm: true,
                    preConfirm: () => {
                        return new Promise((resolve) => {
                            onConfirm();
                            resolve();
                        });
                    }
                });
            }

            function submitForm(action, id, successMessage) {
                const form = document.createElement('form');
                form.method = 'post';
                form.action = `/Prescriptions/${action}/${id}`;

                const token = document.querySelector('input[name="__RequestVerificationToken"]').cloneNode();
                form.appendChild(token);

                document.body.appendChild(form);
                form.submit();

                // Show success notification
                setTimeout(() => {
                    Swal.fire({
                        title: 'Success!',
                        html: successMessage,
                        icon: 'success',
                        confirmButtonColor: '#28a745',
                        timer: 3000,
                        timerProgressBar: true
                    });
                }, 500);
            }

            // Show success/error messages from TempData (backup for page reloads)
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                    Swal.fire({
                        title: 'Success!',
                        text: '@TempData["SuccessMessage"]',
                        icon: 'success',
                        confirmButtonColor: '#28a745',
                        timer: 3000,
                        timerProgressBar: true
                    });
            </text>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                    Swal.fire({
                        title: 'Error!',
                        text: '@TempData["ErrorMessage"]',
                        icon: 'error',
                        confirmButtonColor: '#d33'
                    });
            </text>
        }
        });
    </script>
}