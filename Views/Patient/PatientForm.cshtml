@model Wellness_Wardens_Project.Models.PatientManagementSubsystem.Patient

@{
    bool isEdit = Model != null && Model.PatientId > 0;
    ViewData["Title"] = isEdit ? "Edit Patient" : "Add Patient";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <!-- Left side -->
        <div class="col-lg-7">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header text-white text-center py-4"
                     style="background: linear-gradient(90deg, #0d6efd, #0dcaf0); border-top-left-radius: 12px; border-top-right-radius: 12px;">
                    <h3 class="mb-1">
                        <i class="bi bi-person-plus-fill me-2"></i>
                        @(isEdit ? "Edit Patient" : "Add New Patient")
                    </h3>
                    <p class="mb-0 text-light">
                        @(isEdit ? "Update the details of this patient" : "Fill in the details to register a new patient")
                    </p>
                </div>

                <div class="card-body p-4 bg-light">
                    <form id="patientForm" asp-action="@(isEdit ? "EditPatient" : "AddPatient")" method="post" class="needs-validation" novalidate>
                        @if (isEdit)
                        {
                            @Html.HiddenFor(m => m.PatientId)
                        }

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3 position-relative">
                                    <label asp-for="FirstName" class="form-label fw-bold">First name:</label><span class="text-danger"> *</span>
                                    <input asp-for="FirstName" class="form-control"
                                           placeholder="Enter first name"
                                           pattern="^[A-Za-z\s\-']+$"
                                           minlength="2"
                                           maxlength="50"
                                           required />
                                    <div class="invalid-feedback">
                                        Please enter a valid first name.
                                    </div>
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3 position-relative">
                                    <label asp-for="LastName" class="form-label fw-bold">Last name:</label><span class="text-danger"> *</span>
                                    <input asp-for="LastName" class="form-control"
                                           placeholder="Enter last name"
                                           pattern="^[A-Za-z\s\-']+$"
                                           minlength="2"
                                           maxlength="50"
                                           required />
                                    <div class="invalid-feedback">
                                        Please enter a valid last name.
                                    </div>
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3 position-relative">
                            <label asp-for="Gender" class="form-label fw-bold">Gender:</label><span class="text-danger"> *</span>
                            <select asp-for="Gender" class="form-select" asp-items="@(new SelectList(ViewBag.Genders))" required>
                                <option value="">-- Select Gender --</option>
                            </select>
                            <div class="invalid-feedback">
                                Please select a gender.
                            </div>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>

                        <div class="mb-3 position-relative">
                            <label class="form-label fw-bold" asp-for="DateOfBirth">Date of birth:</label><span class="text-danger"> *</span>
                            <div class="input-group">
                                <input type="date" asp-for="DateOfBirth" class="form-control"
                                       id="dateOfBirth"
                                       max="@DateTime.Now.ToString("yyyy-MM-dd")"
                                       min="@DateTime.Now.AddYears(-120).ToString("yyyy-MM-dd")"
                                       required />
                                <button type="button" class="btn btn-outline-secondary" onclick="clearDate()">
                                    <i class="bi bi-x-circle"></i> Clear
                                </button>
                            </div>
                            <div class="invalid-feedback">
                                Please enter a valid date of birth.
                            </div>
                            <small class="form-text text-muted">Format: YYYY-MM-DD</small>
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>

                        <div class="mb-3 position-relative">
                            <label asp-for="IdentityNumber" class="form-label fw-bold">ID number:</label><span class="text-danger"> *</span>
                            <input asp-for="IdentityNumber" class="form-control"
                                   placeholder="Enter ID number"
                                   pattern="^[0-9]{13}$"
                                   minlength="13"
                                   maxlength="13"
                                   required />
                            <div class="invalid-feedback">
                                Please enter a valid 13-digit ID number (numbers only).
                            </div>
                            <span asp-validation-for="IdentityNumber" class="text-danger"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3 position-relative">
                                    <label asp-for="PhoneNumber" class="form-label fw-bold">Phone number:</label><span class="text-danger"> *</span>
                                    <input asp-for="PhoneNumber" class="form-control"
                                           placeholder="Enter phone number"
                                           pattern="^[0-9+]{10,15}$"
                                           minlength="10"
                                           maxlength="15"
                                           required />
                                    <div class="invalid-feedback">
                                        Please enter a valid phone number (10-15 digits, may start with +).
                                    </div>
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3 position-relative">
                                    <label asp-for="EmergencyContact" class="form-label fw-bold">Emergency number:</label><span class="text-danger"> *</span>
                                    <input asp-for="EmergencyContact" class="form-control"
                                           placeholder="Enter emergency contact number"
                                           pattern="^[0-9+]{10,15}$"
                                           minlength="10"
                                           maxlength="15"
                                           required />
                                    <div class="invalid-feedback">
                                        Please enter a valid emergency contact number (10-15 digits, may start with +).
                                    </div>
                                    <span asp-validation-for="EmergencyContact" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Email address:</label>
                            <input asp-for="Email" type="email" class="form-control"
                                   placeholder="Enter email address"
                                   maxlength="100" />
                            <div class="form-text">Optional email address</div>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3 position-relative">
                            <label asp-for="HomeAddress" class="form-label fw-bold">Home address:</label><span class="text-danger"> *</span>
                            <input asp-for="HomeAddress" class="form-control"
                                   placeholder="Enter home address"
                                   minlength="5"
                                   maxlength="200"
                                   required />
                            <div class="invalid-feedback">
                                Please enter a valid home address.
                            </div>
                            <span asp-validation-for="HomeAddress" class="text-danger"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ChronicCondition" class="form-label fw-bold">Chronic Condition: <span class="text-muted">(Optional)</span></label>
                                    <input asp-for="ChronicCondition" class="form-control"
                                           placeholder="Enter chronic condition (if any)"
                                           maxlength="100" />
                                    <div class="form-text">Optional chronic condition</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ChronicMedication" class="form-label fw-bold">Chronic Medication: <span class="text-muted">(Optional)</span></label>
                                    <input asp-for="ChronicMedication" class="form-control"
                                           placeholder="Enter chronic medication (if any)"
                                           maxlength="100" />
                                    <div class="form-text">Optional chronic medication</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-controller="Patient" asp-action="ManagePatients"
                               class="btn btn-secondary rounded-3 shadow-sm">
                                <i class="bi bi-x-circle me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary rounded-3 shadow-sm">
                                <i class="bi bi-plus-circle me-1"></i> @(Model?.PatientId > 0 ? "Update Patient" : "Add Patient")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right side -->
        <div class="col-lg-5 d-none d-lg-flex align-items-center justify-content-center">
            <img src="~/images/patient-bro.png" alt="Patient Illustration" class="img-fluid"
                 style="max-height: 500px;">
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        (function () {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();

        document.addEventListener('DOMContentLoaded', function() {
            const nameInputs = document.querySelectorAll('input[pattern="^[A-Za-z\\s\\-\']+$"]');
            nameInputs.forEach(input => {
                input.addEventListener('input', validateName);
                input.addEventListener('blur', validateName);
            });

            const idInput = document.querySelector('input[pattern="^[0-9]{13}$"]');
            if (idInput) {
                idInput.addEventListener('input', validateIdNumber);
                idInput.addEventListener('blur', validateIdNumber);
            }

            const phoneInputs = document.querySelectorAll('input[pattern="^[0-9+]{10,15}$"]');
            phoneInputs.forEach(input => {
                input.addEventListener('input', validatePhoneNumber);
                input.addEventListener('blur', validatePhoneNumber);
            });

            const addressInput = document.querySelector('input[placeholder="Enter home address"]');
            if (addressInput) {
                addressInput.addEventListener('input', validateAddress);
                addressInput.addEventListener('blur', validateAddress);
            }

            const dobInput = document.getElementById('dateOfBirth');
            if (dobInput) {
                dobInput.addEventListener('change', validateDateOfBirth);
                dobInput.addEventListener('blur', validateDateOfBirth);
            }

            const genderSelect = document.querySelector('select[asp-for="Gender"]');
            if (genderSelect) {
                genderSelect.addEventListener('change', validateGender);
                genderSelect.addEventListener('blur', validateGender);
            }
        });

        function validateName() {
            const input = this;
            const value = input.value.trim();
            const pattern = /^[A-Za-z\s\-']+$/;

            if (value.length < 2) {
                input.setCustomValidity('Name must be at least 2 characters long.');
            } else if (value.length > 50) {
                input.setCustomValidity('Name cannot exceed 50 characters.');
            } else if (!pattern.test(value)) {
                input.setCustomValidity('Name can only contain letters, spaces, hyphens, and apostrophes.');
            } else {
                input.setCustomValidity('');
            }
        }

        function validateIdNumber() {
            const input = this;
            const value = input.value.trim();
            const pattern = /^[0-9]{13}$/;

            if (value.length !== 13) {
                input.setCustomValidity('ID number must be exactly 13 digits.');
            } else if (!pattern.test(value)) {
                input.setCustomValidity('ID number must contain numbers only.');
            } else {
                input.setCustomValidity('');
            }
        }

        function validatePhoneNumber() {
            const input = this;
            const value = input.value.trim();
            const pattern = /^[0-9+]{10,15}$/;

            if (value.length < 10) {
                input.setCustomValidity('Phone number must be at least 10 digits.');
            } else if (value.length > 15) {
                input.setCustomValidity('Phone number cannot exceed 15 digits.');
            } else if (!pattern.test(value)) {
                input.setCustomValidity('Phone number can only contain numbers and may start with +.');
            } else {
                input.setCustomValidity('');
            }
        }

        function validateAddress() {
            const input = this;
            const value = input.value.trim();

            if (value.length < 5) {
                input.setCustomValidity('Address must be at least 5 characters long.');
            } else if (value.length > 200) {
                input.setCustomValidity('Address cannot exceed 200 characters.');
            } else {
                input.setCustomValidity('');
            }
        }

        function validateDateOfBirth() {
            const input = this;
            const value = input.value;
            const today = new Date();
            const selectedDate = new Date(value);
            const minDate = new Date();
            minDate.setFullYear(today.getFullYear() - 120);

            if (!value) {
                input.setCustomValidity('Please enter a date of birth.');
            } else if (selectedDate > today) {
                input.setCustomValidity('Date of birth cannot be in the future.');
            } else if (selectedDate < minDate) {
                input.setCustomValidity('Date of birth cannot be more than 120 years ago.');
            } else {
                input.setCustomValidity('');
            }
        }

        function validateGender() {
            const input = this;
            const value = input.value;

            if (!value) {
                input.setCustomValidity('Please select a gender.');
            } else {
                input.setCustomValidity('');
            }
        }

        function showToast(type, message) {
            if (!message) return;

            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });

            Toast.fire({
                icon: type,
                title: message
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            var successMessage = '@Html.Raw(TempData["Success"] ?? TempData["SuccessMessage"] ?? "")';
            if (successMessage) {
                showToast('success', successMessage);
            }

            var errorMessage = '@Html.Raw(TempData["Error"] ?? "")';
            if (errorMessage) {
                showToast('error', errorMessage);
            }

            @if (!ViewData.ModelState.IsValid)
            {
                    <text>
                    @foreach (var modelState in ViewData.ModelState.Values)
                    {
                            foreach (var error in modelState.Errors)
                            {
                                    <text>
                                    showToast('error', '@Html.Raw(error.ErrorMessage.Replace("'", "\\'"))');
                                    </text>
                            }
                    }
                    </text>
            }
        });

        function clearDate() {
            document.getElementById('dateOfBirth').value = '';
        }

        document.addEventListener('DOMContentLoaded', function() {
            const today = new Date().toISOString().split('T')[0];
            const dateOfBirth = document.getElementById('dateOfBirth');
            if (dateOfBirth) {
                dateOfBirth.max = today;
            }
        });
    </script>
}