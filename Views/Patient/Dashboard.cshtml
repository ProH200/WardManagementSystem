@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>

    <script>
        // ============================================================
        // GLOBAL VARIABLES
        // ============================================================
        let allPatients = [];

        // ============================================================
        // DOCUMENT READY - Initialize everything
        // ============================================================
        $(document).ready(function() {
            console.log('Dashboard initialized');

            // Load initial data
            loadPatientsData();
            loadDashboardStats();
            setupSearchAutocomplete();

            // When vitals tab is shown, load vitals if patient selected
            $('a[data-bs-toggle="tab"]').on('shown.bs.tab', function(e) {
                const target = $(e.target).attr('href');
                console.log('Tab shown:', target);
                if (target === '#vitals') {
                    const patientId = $('#vitalPatientSelect').val();
                    if (patientId) {
                        console.log('Loading vitals for patient:', patientId);
                        loadVitalRecords();
                    }
                }
            });

            // Handle modal hidden event to reset forms
            $('.modal').on('hidden.bs.modal', function() {
                const form = $(this).find('form');
                if (form.length) {
                    form[0].reset();
                }
            });
        });

                // Add this temporary function to your scripts
        function debugVitalData() {
            const patientId = $('#vitalPatientSelect').val();
            if (!patientId) {
                Swal.fire('Info', 'Please select a patient first.', 'info');
                return;
            }

            $.get(`/Patient/GetVitals/${patientId}`, function(data) {
                console.log('=== FULL VITAL DATA ===');
                console.log('Data type:', typeof data);
                console.log('Is array:', Array.isArray(data));
                console.log('Data length:', data.length);
                console.log('Raw data:', JSON.stringify(data, null, 2));

                // Check first record if exists
                if (data.length > 0) {
                    console.log('First record:', data[0]);
                    console.log('Property names:', Object.keys(data[0]));
                }

                Swal.fire({
                    title: 'Data Debug',
                    html: `
                        <div style="text-align: left;">
                            <p><strong>Data Type:</strong> ${typeof data}</p>
                            <p><strong>Is Array:</strong> ${Array.isArray(data)}</p>
                            <p><strong>Record Count:</strong> ${data.length}</p>
                            ${data.length > 0 ? `
                                <p><strong>First Record:</strong></p>
                                <pre style="background: #f5f5f5; padding: 10px; border-radius: 5px; font-size: 12px; max-height: 200px; overflow: auto;">
        ${JSON.stringify(data[0], null, 2)}
                                </pre>
                            ` : '<p>No records found</p>'}
                        </div>
                    `,
                    width: 600
                });
            }).fail(function(xhr) {
                console.error('Debug API Error:', xhr.responseText);
                Swal.fire('Error', 'Failed to fetch data', 'error');
            });
        }

        // ============================================================
        // PATIENT DATA
        // ============================================================
        function loadPatientsData() {
            $.get('/Patient/GetPatients', function(data) {
                allPatients = data;
                console.log('Patients loaded:', allPatients.length);
            }).fail(function(error) {
                console.error('Failed to load patient data:', error);
            });
        }

        // ============================================================
        // DASHBOARD STATS
        // ============================================================
        function loadDashboardStats() {
            $.get('/Patient/GetDashboardStats', function(data) {
                if (!data.error) {
                    $('#totalPatients').text(data.totalPatients || 0);
                    $('#todayVisits').text(data.todayVisits || 0);
                    $('#activeMeds').text(data.activeMeds || 0);
                    $('#pendingTreatments').text(data.pendingTreatments || 0);
                    $('#newPatients').text(data.newPatients || 0);
                    $('#vitalsDue').text(data.vitalsDue || 0);
                }
            }).fail(function() {
                console.error('Failed to load dashboard stats');
            });
        }

        // ============================================================
        // SEARCH
        // ============================================================
        function setupSearchAutocomplete() {
            $('#patientSearch').autocomplete({
                source: function(request, response) {
                    const term = request.term.toLowerCase();
                    const results = allPatients.filter(p =>
                        (p.firstName && p.firstName.toLowerCase().includes(term)) ||
                        (p.lastName && p.lastName.toLowerCase().includes(term)) ||
                        (p.identityNumber && p.identityNumber.includes(term))
                    );
                    response($.map(results.slice(0, 10), function(item) {
                        return {
                            label: `${item.firstName} ${item.lastName} (${item.identityNumber})`,
                            value: item.patientId
                        };
                    }));
                },
                select: function(event, ui) {
                    viewPatient(ui.item.value);
                    $(this).val('');
                    return false;
                }
            });
        }

        function searchPatients() {
            const searchTerm = $('#patientSearch').val();
            if (!searchTerm) {
                Swal.fire('Info', 'Please enter a patient name or ID to search.', 'info');
                return;
            }

            // Switch to patients tab
            const patientsTab = document.querySelector('#patients-tab');
            if (patientsTab) {
                bootstrap.Tab.getInstance(patientsTab) || new bootstrap.Tab(patientsTab);
                patientsTab.click();
            }

            // Filter the patient table
            $('#patientTableSearch').val(searchTerm);
            filterPatientTable();
        }

        function filterPatientTable() {
            const searchTerm = $('#patientTableSearch').val().toLowerCase();
            const rows = $('#patientTableBody tr');

            rows.each(function() {
                const text = $(this).text().toLowerCase();
                $(this).toggle(text.indexOf(searchTerm) > -1);
            });
        }

        // ============================================================
        // VIEW PATIENT
        // ============================================================
        function viewPatient(patientId) {
            window.location.href = `/Patient/Folder/${patientId}`;
        }

        function editPatient(patientId) {
            Swal.fire('Info', 'Edit patient functionality coming soon.', 'info');
        }

        function deletePatient(patientId) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Patient/DeletePatient', { id: patientId }, function(response) {
                        if (response.success) {
                            Swal.fire('Deleted!', 'Patient has been deleted.', 'success');
                            location.reload();
                        } else {
                            Swal.fire('Error!', response.message || 'Failed to delete patient.', 'error');
                        }
                    }).fail(function() {
                        Swal.fire('Error!', 'An error occurred while deleting the patient.', 'error');
                    });
                }
            });
        }

        // ============================================================
        // SAVE PATIENT
        // ============================================================
        function savePatient() {
            const form = $('#addPatientForm');
            const formData = form.serialize();

            $.ajax({
                url: '/Patient/CreatePatient',
                type: 'POST',
                data: formData,
                dataType: 'json',
                success: function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: 'Patient added successfully.',
                            timer: 2000,
                            showConfirmButton: false
                        });
                        $('#addPatientModal').modal('hide');
                        form[0].reset();
                        setTimeout(function() {
                            location.reload();
                        }, 1500);
                    } else {
                        Swal.fire('Error!', response.message || 'Failed to add patient.', 'error');
                    }
                },
                error: function() {
                    Swal.fire('Error!', 'An error occurred while adding the patient.', 'error');
                }
            });
        }

        // ============================================================
        // VITAL SIGNS - LOAD AND DISPLAY
        // ============================================================

                function loadVitalRecords() {
            const patientId = $('#vitalPatientSelect').val();
            console.log('[loadVitalRecords] patientId:', patientId);

            if (!patientId) {
                $('#vitalTableBody').html(`
                    <tr><td colspan="7" class="text-center text-muted py-4">
                        <i class="fas fa-user me-2"></i> Select a patient to view vital signs
                    </td></tr>
                `);
                return;
            }

            $('#vitalTableBody').html(`
                <tr><td colspan="7" class="text-center text-muted py-4">
                    <i class="fas fa-spinner fa-spin me-2"></i> Loading vital signs...
                </td></tr>
            `);

            const url = `/Patient/GetVitals/${patientId}`;
            console.log('[loadVitalRecords] Fetching URL:', url);

            $.ajax({
                url: url,
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    console.log('[loadVitalRecords] Response:', data);
                    const tbody = $('#vitalTableBody');

                    if (!data || data.length === 0) {
                        tbody.html(`
                            <tr><td colspan="7" class="text-center text-muted py-4">
                                <i class="fas fa-heartbeat fa-2x mb-2 d-block"></i>
                                No vital signs recorded for this patient
                            </td></tr>
                        `);
                        return;
                    }

                    let html = '';
                    data.forEach(function(v) {
                        const tempClass = getTempClass(v.temperature);   // ✅ Renamed
                        const hrClass = getHRClass(v.heartRate);
                        const formattedDate = formatDateTime(v.recordedDate);

                        html += `
                            <tr>
                                <td><strong>${v.patientName || 'N/A'}</strong></td>
                                <td>${formattedDate}</td>
                                <td><span class="badge ${tempClass}">${v.temperature}°C</span></td>
                                <td><span class="badge ${hrClass}">${v.heartRate} bpm</span></td>
                                <td>${v.bloodPressure || 'N/A'}</td>
                                <td>${v.employeeName || 'N/A'}</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-warning" onclick="editVital(${v.vitalId})">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" onclick="deleteVital(${v.vitalId})">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        `;
                    });

                    tbody.html(html);
                },
                error: function(xhr, status, error) {
                    console.error('[loadVitalRecords] Error:', error, 'Status:', xhr.status);
                    $('#vitalTableBody').html(`
                        <tr><td colspan="7" class="text-center text-danger py-4">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Failed to load vital signs (Status: ${xhr.status})
                        </td></tr>
                    `);
                }
            });
        }
        // ============================================================
        // VITAL SIGNS - HELPER FUNCTIONS
        // ============================================================
        function getTempClass(temp) {
            if (!temp) return 'bg-secondary';
            if (temp >= 36.1 && temp <= 37.2) return 'bg-success';
            if (temp >= 37.3 && temp <= 38.0) return 'bg-warning text-dark';
            return 'bg-danger';
        }

        function getHRClass(hr) {
            if (!hr) return 'bg-secondary';
            if (hr >= 60 && hr <= 100) return 'bg-success';
            if ((hr >= 50 && hr <= 59) || (hr >= 101 && hr <= 110)) return 'bg-warning text-dark';
            return 'bg-danger';
        }

        // ============================================================
        // VITAL SIGNS - SAVE
        // ============================================================
        function saveVital() {
            const form = $('#addVitalForm');
            const formData = form.serialize();

            console.log('Saving vital with data:', formData);

            const modal = $('#addVitalModal');
            const saveBtn = modal.find('.btn-primary');
            const originalText = saveBtn.html();
            saveBtn.prop('disabled', true);
            saveBtn.html('<i class="fas fa-spinner fa-spin me-2"></i> Saving...');

            $.ajax({
                url: '/Patient/AddVital',
                type: 'POST',
                data: formData,
                dataType: 'json',
                success: function(response) {
                    console.log('Save response:', response);

                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: response.message || 'Vital signs recorded successfully.',
                            timer: 3000,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });

                        modal.modal('hide');
                        form[0].reset();

                        // Refresh the vitals table
                        const patientId = $('#vitalPatientSelect').val();
                        if (patientId) {
                            loadVitalRecords();
                        }

                        loadDashboardStats();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: response.message || 'Failed to record vital signs.',
                            confirmButtonColor: '#005b96'
                        });
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error saving vital:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: 'An error occurred while recording vital signs. Please try again.',
                        confirmButtonColor: '#005b96'
                    });
                },
                complete: function() {
                    saveBtn.prop('disabled', false);
                    saveBtn.html(originalText);
                }
            });
        }

        // ============================================================
        // VITAL SIGNS - EDIT AND DELETE
