<!-- Main Dashboard with Top Tabs -->
<div class="dashboard-container">
    <ul class="nav nav-tabs dashboard-tabs" id="dashboardTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="patients-tab" data-bs-toggle="tab" data-bs-target="#patients" type="button" role="tab">
                <i class="fas fa-users me-2"></i> Patients
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="vitals-tab" data-bs-toggle="tab" data-bs-target="#vitals" type="button" role="tab">
                <i class="fas fa-heartbeat me-2"></i> Vital Signs
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="treatments-tab" data-bs-toggle="tab" data-bs-target="#treatments" type="button" role="tab">
                <i class="fas fa-stethoscope me-2"></i> Treatments
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="medications-tab" data-bs-toggle="tab" data-bs-target="#medications" type="button" role="tab">
                <i class="fas fa-pills me-2"></i> Medications
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="prescriptions-tab" data-bs-toggle="tab" data-bs-target="#prescriptions" type="button" role="tab">
                <i class="fas fa-prescription me-2"></i> Prescriptions
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="visits-tab" data-bs-toggle="tab" data-bs-target="#visits" type="button" role="tab">
                <i class="fas fa-user-md me-2"></i> Doctor Visits
            </button>
        </li>
        <!-- NEW HISTORY TAB -->
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab">
                <i class="fas fa-history me-2"></i> History
            </button>
        </li>

    </ul>

    <!-- Tab Content -->
    <div class="tab-content dashboard-tab-content" id="dashboardTabsContent">

        <!-- ============================================================ -->
        <!-- PATIENTS TAB -->
        <!-- ============================================================ -->
        <div class="tab-pane fade show active" id="patients" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4><i class="fas fa-users me-2"></i>Patient List</h4>
                <div class="d-flex gap-2">
                    <div class="input-group" style="width: 250px;">
                        <input type="text" id="patientTableSearch" class="form-control" placeholder="Filter patients..." onkeyup="filterPatientTable()">
                        <span class="input-group-text"><i class="fas fa-filter"></i></span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0" id="patientTable">
                            <thead class="table-primary">
                                <tr>
                                    <th>ID Number</th>
                                    <th>Name</th>
                                    <th>Gender</th>
                                    <th>Date of Birth / Age</th>
                                    <th>Phone</th>
                                    <th>Last Visit</th>
                                    <th>Status</th>
                                    <th style="width: 200px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="patientTableBody">
                                @if (Model.Patients.Any())
                                {
                                    foreach (var patient in Model.Patients)
                                    {
                                        <tr>
                                            <td><strong>@patient.IdentityNumber</strong></td>
                                            <td>@patient.FirstName @patient.LastName</td>
                                            <td>@patient.Gender</td>
                                            <td>
                                                @patient.DateOfBirth.ToString("MMM dd, yyyy")
                                                <br /><small class="text-muted">(@patient.Age years)</small>
                                            </td>
                                            <td>@patient.PhoneNumber</td>
                                            <td>@(patient.LastVisit?.ToString("MMM dd, yyyy") ?? "Never")</td>
                                            <td>
                                                <span class="status-badge status-active">Active</span>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button class="btn btn-outline-primary" onclick="viewPatient(@patient.PatientId)" title="View Profile">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <button class="btn btn-outline-success" onclick="openAddVital(@patient.PatientId)" title="Add Vitals">
                                                        <i class="fas fa-heartbeat"></i>
                                                    </button>
                                                    <button class="btn btn-outline-warning" onclick="editPatient(@patient.PatientId)" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger" onclick="deletePatient(@patient.PatientId)" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted">No patients found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- VITAL SIGNS TAB -->
        <!-- ============================================================ -->
        <div class="tab-pane fade" id="vitals" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4><i class="fas fa-heartbeat me-2"></i>Vital Signs</h4>
                <button class="btn btn-primary" onclick="openAddVital()">
                    <i class="fas fa-plus me-2"></i> Record Vital Signs
                </button>
            </div>

            <!-- Patient Selector for Vitals -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Select Patient</label>
                            <select class="form-select" id="vitalPatientSelect" onchange="loadVitalRecords()">
                                <option value="">-- Select Patient --</option>
                                @foreach (var p in Model.PatientSelectList)
                                {
                                    <option value="@p.PatientId">@p.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Date Range</label>
                            <input type="date" class="form-control" id="vitalDateFilter" onchange="loadVitalRecords()">
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-outline-secondary w-100" onclick="loadVitalRecords()">
                                <i class="fas fa-sync me-1"></i> Refresh
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0" id="vitalTable">
                            <thead class="table-primary">
                                <tr>
                                    <th>Patient</th>
                                    <th>Date & Time</th>
                                    <th>Temperature</th>
                                    <th>Heart Rate</th>
                                    <th>Blood Pressure</th>
                                    <th>Recorded By</th>
                                    <th style="width: 120px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="vitalTableBody">
                                <tr>
                                    <td colspan="7" class="text-center text-muted">Select a patient to view vital signs</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- TREATMENTS TAB -->
        <!-- ============================================================ -->
        <div class="tab-pane fade" id="treatments" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4><i class="fas fa-stethoscope me-2"></i>Treatments</h4>
                <button class="btn btn-primary" onclick="openAddTreatment()">
                    <i class="fas fa-plus me-2"></i> Record Treatment
                </button>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <div class="row align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Select Patient</label>
                            <select class="form-select" id="treatmentPatientSelect" onchange="loadTreatmentRecords()">
                                <option value="">-- Select Patient --</option>
                                @foreach (var p in Model.PatientSelectList)
                                {
                                    <option value="@p.PatientId">@p.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Treatment Type</label>
                            <select class="form-select" id="treatmentTypeFilter" onchange="loadTreatmentRecords()">
                                <option value="">All Types</option>
                                @foreach (var type in Model.TreatmentTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-outline-secondary w-100" onclick="loadTreatmentRecords()">
                                <i class="fas fa-sync me-1"></i> Refresh
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0" id="treatmentTable">
                            <thead class="table-success">
                                <tr>
                                    <th>Patient</th>
                                    <th>Treatment Type</th>
                                    <th>Date Performed</th>
                                    <th>Status</th>
                                    <th style="width: 120px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="treatmentTableBody">
                                <tr>
                                    <td colspan="5" class="text-center text-muted">Select a patient to view treatments</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- MEDICATIONS TAB -->
        <!-- ============================================================ -->
        <div class="tab-pane fade" id="medications" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4><i class="fas fa-pills me-2"></i>Medications</h4>
                <div class="d-flex gap-2">
                    @if (User.IsInRole("Nurse") || User.IsInRole("Nursing Sister") || User.IsInRole("Doctor"))
                    {
                        <button class="btn btn-primary" onclick="openAssignMedication()">
                            <i class="fas fa-prescription me-2"></i> Assign Medication
                        </button>
                    }
                </div>
            </div>

            <!-- Medication Sub Tabs -->
            <ul class="nav nav-tabs mb-3" id="medicationSubTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="nonScheduledMeds-tab" data-bs-toggle="tab" data-bs-target="#nonScheduledMeds" type="button" role="tab">
                        <i class="fas fa-pills me-1"></i> Non-Scheduled (Level 1-4)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="scheduledMeds-tab" data-bs-toggle="tab" data-bs-target="#scheduledMeds" type="button" role="tab">
                        <i class="fas fa-prescription-bottle-alt me-1"></i> Scheduled (Level 5-10)
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- Non-Scheduled Medications -->
                <div class="tab-pane fade show active" id="nonScheduledMeds" role="tabpanel">
                    <div class="card">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover mb-0">
                                    <thead class="table-primary">
                                        <tr>
                                            <th>Patient</th>
                                            <th>Medication</th>
                                            <th>Dosage</th>
                                            <th>Frequency</th>
                                            <th>Duration</th>
                                            <th>Assigned Date</th>
                                            <th>Status</th>
                                            <th style="width: 100px;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="nonScheduledMedsBody">
                                        @{
                                            var nonScheduled = Model.MedicationAssignments.Where(m => !m.IsScheduled).ToList();
                                        }
                                        @if (nonScheduled.Any())
                                        {
                                            foreach (var med in nonScheduled)
                                            {
                                                <tr>
                                                    <td>@med.PatientName</td>
                                                    <td><strong>@med.MedicationName</strong></td>
                                                    <td>@med.Dosage</td>
                                                    <td>@med.Frequency</td>
                                                    <td>@med.DurationDays days</td>
                                                    <td>@med.AssignmentDate.ToString("MMM dd, yyyy")</td>
                                                    <td><span class="status-badge status-active">Active</span></td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <button class="btn btn-outline-warning" onclick="editMedication(@med.PatientMedicationId)">
                                                                <i class="fas fa-edit"></i>
                                                            </button>
                                                            <button class="btn btn-outline-danger" onclick="deleteMedication(@med.PatientMedicationId)">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="8" class="text-center text-muted">No non-scheduled medications assigned</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Scheduled Medications -->
                <div class="tab-pane fade" id="scheduledMeds" role="tabpanel">
                    <div class="card">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover mb-0">
                                    <thead style="background-color: #dc3545; color: white;">
                                        <tr>
                                            <th>Patient</th>
                                            <th>Medication</th>
                                            <th>Dosage</th>
                                            <th>Frequency</th>
                                            <th>Duration</th>
                                            <th>Assigned Date</th>
                                            <th>Level</th>
                                            <th>Status</th>
                                            <th style="width: 100px;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="scheduledMedsBody">
                                        @{
                                            var scheduled = Model.MedicationAssignments.Where(m => m.IsScheduled).ToList();
                                        }
                                        @if (scheduled.Any())
                                        {
                                            foreach (var med in scheduled)
                                            {
                                                var levelClass = med.ScheduleLevel > 7 ? "bg-danger" : med.ScheduleLevel > 4 ? "bg-warning text-dark" : "bg-secondary";
                                                <tr>
                                                    <td>@med.PatientName</td>
                                                    <td><strong>@med.MedicationName</strong></td>
                                                    <td>@med.Dosage</td>
                                                    <td>@med.Frequency</td>
                                                    <td>@med.DurationDays days</td>
                                                    <td>@med.AssignmentDate.ToString("MMM dd, yyyy")</td>
                                                    <td><span class="badge @levelClass">Level @med.ScheduleLevel</span></td>
                                                    <td><span class="status-badge status-active">Active</span></td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <button class="btn btn-outline-warning" onclick="editMedication(@med.PatientMedicationId)">
                                                                <i class="fas fa-edit"></i>
                                                            </button>
                                                            <button class="btn btn-outline-danger" onclick="deleteMedication(@med.PatientMedicationId)">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="9" class="text-center text-muted">No scheduled medications assigned</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- PRESCRIPTIONS TAB -->
        <!-- ============================================================ -->
        <div class="tab-pane fade" id="prescriptions" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4><i class="fas fa-prescription me-2"></i>Prescriptions</h4>
                @if (User.IsInRole("Doctor"))
                {
                    <button class="btn btn-primary" onclick="openAddPrescription()">
                        <i class="fas fa-plus me-2"></i> Create Prescription
                    </button>
                }
            </div>

            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0" id="prescriptionTable">
                            <thead class="table-info">
                                <tr>
                                    <th>Patient</th>
                                    <th>Date Written</th>
                                    <th>Doctor</th>
                                    <th>Medications</th>
                                    <th>Instructions</th>
                                    <th style="width: 100px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="prescriptionTableBody">
                                @if (Model.Prescriptions.Any())
                                {
                                    foreach (var prescription in Model.Prescriptions)
                                    {
                                        <tr>
                                            <td>@prescription.PatientName</td>
                                            <td>@prescription.DateWritten.ToString("MMM dd, yyyy")</td>
                                            <td>Dr. @prescription.DoctorName</td>
                                            <td>
                                                @foreach (var med in prescription.Medications)
                                                {
                                                    <span class="badge bg-primary me-1">@med.Name</span>
                                                }
                                            </td>
                                            <td><small>@prescription.Instructions</small></td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary" onclick="viewPrescription(@prescription.PrescriptionId)">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger" onclick="deletePrescription(@prescription.PrescriptionId)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted">No prescriptions found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- DOCTOR VISITS TAB -->
        <!-- ============================================================ -->
        <div class="tab-pane fade" id="visits" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4><i class="fas fa-user-md me-2"></i>Doctor Visits</h4>
                <button class="btn btn-primary" onclick="openAddVisit()">
                    <i class="fas fa-plus me-2"></i> Record Visit
                </button>
            </div>

            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0" id="visitTable">
                            <thead class="table-secondary">
                                <tr>
                                    <th>Patient</th>
                                    <th>Visit Date</th>
                                    <th>Instructions</th>
                                    <th style="width: 100px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="visitTableBody">
                                @if (Model.DoctorVisits.Any())
                                {
                                    foreach (var visit in Model.DoctorVisits)
                                    {
                                        <tr>
                                            <td>@visit.PatientName</td>
                                            <td>@visit.VisitDate.ToString("MMM dd, yyyy HH:mm")</td>
                                            <td><small>@visit.Instructions</small></td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-warning" onclick="editVisit(@visit.VisitId)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger" onclick="deleteVisit(@visit.VisitId)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">No doctor visits recorded</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

