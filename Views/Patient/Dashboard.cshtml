        function savePrescription() {
            const medications = [];
            $('#prescriptionMedications .row').each(function() {
                const medId = $(this).find('select[name="MedicationIds"]').val();
                const dosage = $(this).find('input[name="Dosages"]').val();
                if (medId) {
                    medications.push({ medicationId: medId, dosage: dosage });
                }
            });

            if (medications.length === 0) {
                Swal.fire('Error!', 'Please add at least one medication.', 'error');
                return;
            }

            const form = $('#addPrescriptionForm');
            const data = {
                PatientId: form.find('select[name="PatientId"]').val(),
                Instructions: form.find('textarea[name="Instructions"]').val(),
                Medications: medications
            };

            $.ajax({
                url: '/Patient/CreatePrescription',
                type: 'POST',
                data: data,
                dataType: 'json',
                success: function(response) {
                    if (response.success) {
                        Swal.fire('Success!', 'Prescription created successfully.', 'success');
