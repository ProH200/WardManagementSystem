        // Live preview of vitals as user types
        $(document).ready(function() {
            $('#vitalTemperature, #vitalHeartRate, #vitalBloodPressure').on('input', function() {
                updateVitalPreview();
            });

            function updateVitalPreview() {
                const temp = parseFloat($('#vitalTemperature').val());
                const hr = parseInt($('#vitalHeartRate').val());
                const bp = $('#vitalBloodPressure').val();

                const preview = $('#vitalPreview');

                // Only show preview if at least one value is entered
                if (!temp && !hr && !bp) {
                    preview.hide();
                    return;
                }

                preview.show();

                // Temperature preview
                if (temp) {
                    const tempClass = getTempClass(temp);
                    $('#previewTemp').removeClass().addClass(`badge ${tempClass} w-100 py-2`).text(temp + '°C');
                } else {
                    $('#previewTemp').removeClass().addClass('badge bg-secondary w-100 py-2').text('--°C');
                }

                // Heart Rate preview
                if (hr) {
                    const hrClass = getHRClass(hr);
                    $('#previewHR').removeClass().addClass(`badge ${hrClass} w-100 py-2`).text(hr + ' bpm');
                } else {
                    $('#previewHR').removeClass().addClass('badge bg-secondary w-100 py-2').text('--');
                }

                // Blood Pressure preview
                if (bp) {
                    const bpClass = getBPClass(bp);
                    $('#previewBP').removeClass().addClass(`badge ${bpClass} w-100 py-2`).text(bp);
                } else {
                    $('#previewBP').removeClass().addClass('badge bg-secondary w-100 py-2').text('--/--');
                }
            }
        });

        // Save vital signs
        function saveVital() {
            const form = $('#addVitalForm');

            // Validate the form
            if (!form[0].checkValidity()) {
                form[0].reportValidity();
                return;
            }

            // Get form data
            const formData = form.serialize();
            console.log('[saveVital] Submitting:', formData);

            // Show loading state on the save button
            const saveBtn = $('#saveVitalBtn');
            const originalText = saveBtn.html();
            saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Saving...');

            $.ajax({
                url: '/Patient/AddVital',
                type: 'POST',
                data: formData,
                dataType: 'json',
                success: function(response) {
                    console.log('[saveVital] Response:', response);

                    if (response.success) {
                        // Success toast
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: response.message || 'Vital signs recorded successfully.',
                            timer: 2000,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });

                        // Close modal and reset form
                        $('#addVitalModal').modal('hide');
                        form[0].reset();
                        $('#vitalPreview').hide();

                        // Refresh the vitals table
                        const selectedPatientId = $('#vitalPatientSelect').val();
                        if (selectedPatientId) {
                            loadVitalRecords();
                        }

                        // Refresh dashboard stats
                        if (typeof loadDashboardStats === 'function') {
                            loadDashboardStats();
                        }
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: response.message || 'Failed to record vital signs.',
                            confirmButtonColor: '#005b96'
                        });
                    }
                },
                error: function(xhr, status, error) {
                    console.error('[saveVital] Error:', error);
                    console.error('[saveVital] Response:', xhr.responseText);

                    let errorMsg = 'An error occurred while saving vital signs.';
                    try {
                        const resp = JSON.parse(xhr.responseText);
                        if (resp.message) errorMsg = resp.message;
                    } catch (e) {}

                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: errorMsg,
                        confirmButtonColor: '#005b96'
                    });
                },
                complete: function() {
                    saveBtn.prop('disabled', false).html(originalText);
                }
            });
        }

        // ============================================================
        // COLOR HELPER FUNCTIONS
        // ============================================================

        function getTempClass(temp) {
            if (!temp) return 'bg-secondary';
            if (temp >= 36.1 && temp <= 37.2) return 'bg-success';
            if (temp >= 37.3 && temp <= 38.0) return 'bg-warning text-dark';
            return 'bg-danger';
        }

        function getHRClass(hr) {
            if (!hr) return 'bg-secondary';
            if (hr >= 60 && hr <= 100) return 'bg-success';
            if ((hr >= 50 && hr <= 59) || (hr >= 101 && hr <= 110)) return 'bg-warning text-dark';
            return 'bg-danger';
        }

        function getBPClass(bp) {
            if (!bp || !bp.includes('/')) return 'bg-secondary';
            const parts = bp.split('/');
            if (parts.length !== 2) return 'bg-secondary';

            const systolic = parseInt(parts[0]);
            const diastolic = parseInt(parts[1]);

            if (isNaN(systolic) || isNaN(diastolic)) return 'bg-secondary';

            // Normal BP: <120/<80
            if (systolic < 120 && diastolic < 80) return 'bg-success';
            // Elevated: 120-129/<80
            if (systolic >= 120 && systolic <= 129 && diastolic < 80) return 'bg-warning text-dark';
            // High: >=130/>=80
            if (systolic >= 130 || diastolic >= 80) return 'bg-danger';

            return 'bg-secondary';
        }

