<!-- ADD VITAL SIGNS MODAL -->
<!-- ============================================================ -->
<div class="modal fade" id="addVitalModal" tabindex="-1" aria-labelledby="addVitalModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="addVitalModalLabel">
                    <i class="fas fa-heartbeat me-2"></i>Record Vital Signs
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addVitalForm">
                    @Html.AntiForgeryToken()

                    <!-- Patient Selection -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-user me-1 text-primary"></i> Patient <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" name="PatientId" id="vitalPatientId" required>
                            <option value="">-- Select Patient --</option>
                            @foreach (var p in Model.PatientSelectList)
                            {
                                <option value="@p.PatientId">@p.DisplayName</option>
                            }
                        </select>
                    </div>

                    <!-- Recorded Date & Time -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-calendar-alt me-1 text-primary"></i> Recorded Date & Time <span class="text-danger">*</span>
                        </label>
                        <input type="datetime-local"
                               class="form-control"
                               name="RecordedDate"
                               id="vitalRecordedDate"
                               value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                               required>
                    </div>

                    <hr class="my-3">
                    <h6 class="text-muted mb-3">
                        <i class="fas fa-clipboard-list me-1"></i> Vital Measurements
                    </h6>

                    <!-- Temperature and Heart Rate -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-thermometer-half me-1 text-danger"></i> Temperature (°C) <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                      @*  step="0.1"
                                       min="30"
                                       max="45" *@
                                       class="form-control"
                                       name="Temperature"
                                       id="vitalTemperature"
                                       placeholder="e.g., 36.5"
                                       required>
                                <small class="text-muted">Normal: 36.1 - 37.2 °C</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-heartbeat me-1 text-danger"></i> Heart Rate (bpm) <span class="text-danger">*</span>
                                </label>
                                <input type="number"
                                       min="30"
                                       max="250"
                                       class="form-control"
                                       name="HeartRate"
                                       id="vitalHeartRate"
                                       placeholder="e.g., 72"
                                       required>
                                <small class="text-muted">Normal: 60 - 100 bpm</small>
                            </div>
                        </div>
                    </div>

                    <!-- Blood Pressure -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-tint me-1 text-danger"></i> Blood Pressure (mmHg) <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control"
                               name="BloodPressure"
                               id="vitalBloodPressure"
                               pattern="^\d{2,3}/\d{2,3}$"
                               placeholder="e.g., 120/80"
                               title="Enter blood pressure in format 120/80"
                               required>
                        <small class="text-muted">Format: Systolic/Diastolic (e.g., 120/80)</small>
                    </div>

                    <!-- Preview Section -->
                    <div class="card bg-light border-0 mt-3" id="vitalPreview" style="display: none;">
                        <div class="card-body py-2">
                            <small class="text-muted d-block mb-2">
                                <i class="fas fa-eye me-1"></i> Preview:
                            </small>
                            <div class="row text-center g-2">
                                <div class="col-4">
                                    <div class="badge bg-secondary w-100 py-2" id="previewTemp">--°C</div>
                                    <small class="text-muted d-block mt-1">Temp</small>
                                </div>
                                <div class="col-4">
                                    <div class="badge bg-secondary w-100 py-2" id="previewHR">--</div>
                                    <small class="text-muted d-block mt-1">HR</small>
                                </div>
                                <div class="col-4">
                                    <div class="badge bg-secondary w-100 py-2" id="previewBP">--/--</div>
                                    <small class="text-muted d-block mt-1">BP</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-primary" id="saveVitalBtn" onclick="saveVital()">
                    <i class="fas fa-save me-1"></i> Save Vital Signs
                </button>
            </div>
        </div>
    </div>
</div>

