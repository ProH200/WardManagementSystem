        // ============================================================
        // TREATMENTS
        // ============================================================
        function loadTreatmentRecords() {
            const patientId = $('#treatmentPatientSelect').val();
            if (!patientId) {
                $('#treatmentTableBody').html(`<tr><td colspan="5" class="text-center text-muted">Select a patient to view treatments</td></tr>`);
                return;
            }

            const typeFilter = $('#treatmentTypeFilter').val();
            let url = `/Patient/GetTreatments/${patientId}`;
            if (typeFilter) url += `?type=${typeFilter}`;

            $.get(url, function(data) {
                const tbody = $('#treatmentTableBody');
                if (!data || data.length === 0) {
                    tbody.html(`<tr><td colspan="5" class="text-center text-muted">No treatments recorded for this patient</td></tr>`);
                    return;
                }

                let html = '';
                data.forEach(function(t) {
                    const status = t.isDeleted ?
                        '<span class="status-badge status-inactive">Deleted</span>' :
                        '<span class="status-badge status-active">Active</span>';
                    html += `
                        <tr>
                            <td>${t.patientName}</td>
                            <td><strong>${t.treatmentType}</strong></td>
                            <td>${formatDateTime(t.datePerformed)}</td>
                            <td>${status}</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-warning" onclick="editTreatment(${t.treatmentId})">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" onclick="deleteTreatment(${t.treatmentId})">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                });

                tbody.html(html);
            }).fail(function() {
                console.error('Failed to load treatment records');
            });
        }

