@model Wellness_Wardens_Project.ViewModels.PatientManagementDashboardViewModel
@using Wellness_Wardens_Project.Models.PatientManagementSubsystem
@using Wellness_Wardens_Project.Models.PatientCareSubsystem
@using Wellness_Wardens_Project.Models.AdministrationSubsystem
@using Wellness_Wardens_Project.Models.DoctorPatientSubsystem

@{
    ViewData["Title"] = "Patient Management Dashboard";
    var userRole = User.IsInRole("Nursing Sister") ? "Nursing Sister" :
                   User.IsInRole("Nurse") ? "Nurse" :
                   User.IsInRole("Doctor") ? "Doctor" : "Other";
    var today = DateTime.Now;
}

<!-- Dashboard Header - Professional & Clean -->
<div class="dashboard-header mb-4">
    <div class="dashboard-header-top">
        <div class="header-left">
            <div class="header-title-wrapper">
                <div class="header-icon">
                    <i class="fas fa-hospital-user"></i>
                </div>
                <div>
                    <h1 class="dashboard-title">Patient Management Dashboard</h1>
                    <div class="dashboard-meta">
                        <span class="badge role-badge">
                            <i class="fas fa-user-tag me-1"></i> @userRole
                        </span>
                        <span class="meta-separator">|</span>
                        <span class="meta-date">
                            <i class="fas fa-calendar-alt me-1"></i> @today.ToString("dddd, MMMM dd, yyyy")
                        </span>
                        <span class="meta-separator">|</span>
                        <span class="meta-time">
                            <i class="fas fa-clock me-1"></i> @today.ToString("HH:mm")
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="header-right">
            <div class="search-box">
                <div class="search-input-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="patientSearch" class="form-control search-input" placeholder="Search by ID, Name, or Surname...">
                </div>
                <button class="btn btn-primary search-btn" onclick="searchPatients()">
                    <i class="fas fa-search"></i>
                </button>
            </div>
           @*  <button class="btn btn-success add-patient-btn" data-bs-toggle="modal" data-bs-target="#addPatientModal">
                <i class="fas fa-plus me-1"></i> Add Patient
            </button> *@
        </div>
    </div>

    <!-- Quick Actions Bar -->
    <div class="quick-actions-bar">
        <div class="quick-actions-wrapper">
            <span class="quick-actions-label">Quick Actions:</span>
            <button class="btn btn-sm btn-outline-primary" onclick="openAddVital()">
                <i class="fas fa-heartbeat me-1"></i> Record Vitals
            </button>
            <button class="btn btn-sm btn-outline-success" onclick="openAddTreatment()">
                <i class="fas fa-stethoscope me-1"></i> Add Treatment
            </button>
            <button class="btn btn-sm btn-outline-info" onclick="openAssignMedication()">
                <i class="fas fa-pills me-1"></i> Assign Medication
            </button>
            <button class="btn btn-sm btn-outline-warning" onclick="openAddVisit()">
                <i class="fas fa-user-md me-1"></i> Record Visit
            </button>
        </div>
    </div>
</div>

<!-- Quick Stats Cards -->
