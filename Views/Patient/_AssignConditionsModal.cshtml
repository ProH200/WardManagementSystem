@model Wellness_Wardens_Project.ViewModels.PatientManagementSubsystem.AssignConditionsViewModel

<div class="modal fade" id="assignConditionsModal" tabindex="-1" aria-labelledby="assignConditionsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="assignConditionsModalLabel">
                    Assign Conditions to @Model.PatientName
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="assignConditionsForm" asp-action="AssignConditions" method="post">
                <input type="hidden" asp-for="PatientId" />
                <input type="hidden" asp-for="PatientName" />

                <div class="modal-body">
                    <div class="row">
                        <!-- Allergies Section -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h6 class="card-title mb-0">Allergies</h6>
                                </div>
                                <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                                    @foreach (var allergy in Model.AvailableAllergies)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="SelectedAllergyIds"
                                                   value="@allergy.AllergyId"
                                                   id="allergy_@allergy.AllergyId"
                                                   @(Model.CurrentPatientAllergies.Any(a => a.AllergyId == allergy.AllergyId) ? "checked" : "")>
                                            <label class="form-check-label" for="allergy_@allergy.AllergyId">
                                                @allergy.Name
                                                @if (!string.IsNullOrEmpty(allergy.Description))
                                                {
                                                    <small class="text-muted d-block">@allergy.Description</small>
                                                }
                                            </label>
                                        </div>
                                    }
                                    @if (!Model.AvailableAllergies.Any())
                                    {
                                        <p class="text-muted">No allergies available</p>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Medical Conditions Section -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h6 class="card-title mb-0">Medical Conditions</h6>
                                </div>
                                <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                                    @foreach (var condition in Model.AvailableMedicalConditions)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="SelectedMedicalConditionIds"
                                                   value="@condition.MedicalConditionId"
                                                   id="condition_@condition.MedicalConditionId"
                                                   @(Model.CurrentPatientConditions.Any(mc => mc.MedicalConditionId == condition.MedicalConditionId) ? "checked" : "")>
                                            <label class="form-check-label" for="condition_@condition.MedicalConditionId">
                                                @condition.Name
                                                @if (!string.IsNullOrEmpty(condition.Description))
                                                {
                                                    <small class="text-muted d-block">@condition.Description</small>
                                                }
                                            </label>
                                        </div>
                                    }
                                    @if (!Model.AvailableMedicalConditions.Any())
                                    {
                                        <p class="text-muted">No medical conditions available</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#assignConditionsForm').on('submit', function (e) {
            e.preventDefault();

            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: $(this).serialize(),
                success: function (response) {
                    if (response.success) {
                        $('#assignConditionsModal').modal('hide');

                        // SweetAlert2 Success Toast
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: response.message,
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 4000,
                            timerProgressBar: true,
                            background: '#f0f9f0',
                            iconColor: '#28a745'
                        });

                        // Optional: Reload the page or update the table after a delay
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        // SweetAlert2 Error Toast
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: response.message,
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 4000,
                            timerProgressBar: true,
                            background: '#fdf2f2',
                            iconColor: '#dc3545'
                        });
                    }
                },
                error: function (xhr, status, error) {
                    // SweetAlert2 Error Toast for AJAX errors
                    Swal.fire({
                        icon: 'error',
                        title: 'Request Failed!',
                        text: 'An error occurred while saving. Please try again.',
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 4000,
                        timerProgressBar: true,
                        background: '#fdf2f2',
                        iconColor: '#dc3545'
                    });

                    console.error('AJAX Error:', error);
                    console.log('Response:', xhr.responseText);
                }
            });
        });
    });
</script>