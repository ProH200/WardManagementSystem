@model IEnumerable<Wellness_Wardens_Project.Models.PatientManagementSubsystem.PatientMedicalHistory>
@{
    ViewData["Title"] = "Medical History";
    var patient = ViewBag.Patient;
}

<link href="~/css/history.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div class="d-flex align-items-center">
            <h2 class="mb-0 me-2">Medical History - @patient.FirstName @patient.LastName</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Patient" asp-action="ManagePatients" class="btn btn-outline-secondary btn-custom">
                <i class="bi bi-arrow-left-circle me-1"></i> Back to Patients
            </a>
            <button class="btn btn-success btn-custom" data-bs-toggle="modal" data-bs-target="#addHistoryModal">
                <i class="bi bi-plus-circle me-1"></i> Add History
            </button>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <ul class="timeline">
            @foreach (var history in Model.OrderByDescending(h => h.DateAdded))
            {
                <li class="timeline-item">
                    <div class="timeline-date">@history.DateAdded.ToString("dd MMM yyyy")</div>
                    <div class="timeline-content">
                        <p>@history.Notes</p>
                        <div class="mt-2">
                            <button class="btn btn-sm btn-outline-primary me-1 edit-btn btn-custom"
                                    data-id="@history.Id"
                                    data-notes="@history.Notes"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editHistoryModal">
                                Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger delete-btn btn-custom"
                                    data-id="@history.Id"
                                    data-notes="@history.Notes"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteHistoryModal">
                                Delete
                            </button>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i> No medical history found for this patient.
        </div>
    }
</div>

<!-- Modals (keep same layout & JS) -->
<!-- Add History Modal -->
<div class="modal fade" id="addHistoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddHistory" asp-controller="Patient" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PatientId" value="@patient.PatientId" />

                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Add Medical History</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label for="Notes" class="form-label">Notes</label>
                    <textarea name="Notes" id="Notes" class="form-control" rows="4" maxlength="500" required></textarea>
                    <small class="text-muted">Max 500 characters.</small>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Add</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit History Modal -->
<div class="modal fade" id="editHistoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="EditHistory" asp-controller="Patient" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editHistoryId" />
                <input type="hidden" name="PatientId" value="@patient.PatientId" />

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Edit Medical History</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label for="editNotes" class="form-label">Notes</label>
                    <textarea name="Notes" id="editNotes" class="form-control" rows="4" maxlength="500" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete History Modal -->
<div class="modal fade" id="deleteHistoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="DeleteHistory" asp-controller="Patient" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="deleteHistoryId" />
                <input type="hidden" name="patientId" value="@patient.PatientId" />

                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Delete Medical History</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this medical history entry?</p>
                    <p><em id="deleteHistoryNotes"></em></p>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Populate Edit modal
        document.querySelectorAll('.edit-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('editHistoryId').value = btn.dataset.id;
                document.getElementById('editNotes').value = btn.dataset.notes;
            });
        });

        // Populate Delete modal
        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('deleteHistoryId').value = btn.dataset.id;
                document.getElementById('deleteHistoryNotes').innerText = btn.dataset.notes;
            });
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function showToast(type, message) {
            if (!message) return;
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: type,
                title: message,
                showConfirmButton: false,
                timer: 3000
            });
        }

        document.addEventListener("DOMContentLoaded", function() {
            // Backend success message
            var successMessage = @Html.Raw(Json.Serialize(TempData["SuccessMessage"] ?? null));
            if (successMessage) {
                showToast('success', successMessage);
            }

            // Backend error messages
            @foreach (var modelState in ViewData.ModelState.Values)
            {
                        foreach (var error in modelState.Errors)
                        {
                                    <text>
                                        showToast('error', @Html.Raw(Json.Serialize(error.ErrorMessage)));
                                    </text>
                        }
            }
        });
    </script>
}
