                        <div class="d-grid">
                            <button type="submit" class="btn btn-lg" style="background-color: #dc3545; color: white;">
                                <i class="fas fa-save me-2"></i>Update Scheduled Medication
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Soft Delete Scheduled Assigned Medication Modal -->
@foreach (var assignment in Model.ScheduledAssignments)
{
    <div class="modal fade" id="deleteScheduledModal-@assignment.PatientMedicationId" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header text-white" style="background-color: #dc3545;">
                    <h5 class="modal-title">Remove Scheduled Medication</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to remove this scheduled medication assignment?</p>
                    <div class="alert alert-warning">
                        <strong>Medication Details:</strong><br>
                        <strong>Name:</strong> @assignment.Medication.Name<br>
                        <strong>Dosage:</strong> @assignment.Dosage<br>
                        <strong>Frequency:</strong> @assignment.Frequency<br>
                        <strong>Duration:</strong> @assignment.DurationDays days<br>
                        <strong>Quantity Assigned:</strong> @assignment.QuantityAssigned<br>
                        <strong>Date Assigned:</strong> @assignment.AssignmentDate.ToString("MMM dd, yyyy")<br>
                        <strong>Assigned by:</strong> @assignment.Employee?.Title @assignment.Employee?.LastName
                    </div>
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Note:</strong> @assignment.QuantityAssigned unit(s) will be returned to inventory.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    @using (Html.BeginForm("SoftDeleteAssignedMedication", "Patient", new { patientMedicationId = assignment.PatientMedicationId }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn" style="background-color: #dc3545; color: white;">
                            <i class="fas fa-archive me-1"></i>Remove Medication
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Assign Non-Scheduled Medication Modal -->
<div class="modal fade" id="assignNonScheduledModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #005b96;">
                <h5 class="modal-title">Assign Non-Scheduled Medication</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("AssignMedication", "Patient", new { patientId = ViewBag.PatientId }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="patientId" value="@ViewBag.PatientId" />

                    <div class="mb-3">
                        <label class="form-label">Select Non-Scheduled Medication *</label>
                        <select name="medicationId" class="form-control" required>
                            <option value="">Select Non-Scheduled Medication</option>
                            @foreach (var med in ViewBag.NonScheduledMedications as List<Medication>)
                            {
                                <option value="@med.MedicationId">@med.Name (Available: @med.QuantityAvailable)</option>
                            }
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Dosage *</label>
                                <input type="text" name="dosage" class="form-control" placeholder="e.g., 500mg" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Frequency *</label>
                                <input type="text" name="frequency" class="form-control" placeholder="e.g., Twice daily" required />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Duration (Days)</label>
                                <input type="number" name="durationDays" class="form-control" min="0" value="0" />
                                <small class="text-muted">Set to 0 for single dose assignment</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Quantity to Assign *</label>
                                <input type="number" name="quantityAssigned" class="form-control" min="1" value="1" required />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Administration Notes</label>
                        <textarea name="administrationNotes" class="form-control" rows="3"
                              placeholder="Additional instructions or notes..."></textarea>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-lg" style="background-color: #005b96; color: white;">
                            <i class="fas fa-paper-plane me-2"></i>Assign Medication
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
    }

