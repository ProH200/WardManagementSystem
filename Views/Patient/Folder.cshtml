@model Wellness_Wardens_Project.ViewModels.PatientFolderViewModel
@{
    ViewData["Title"] = "Patient Folder";
}

<div class="container-fluid mt-4">
    <!-- Back Button -->
    <div class="mb-3">
        <a href="/Patient/Dashboard" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i> Back to Dashboard
        </a>
    </div>

    <!-- Patient Header -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h3>@Model.Patient.FirstName @Model.Patient.LastName</h3>
            <small>ID: @Model.Patient.IdentityNumber | Gender: @Model.Patient.Gender</small>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Date of Birth:</strong> @Model.Patient.DateOfBirth.ToString("MMM dd, yyyy")</p>
                    <p><strong>Phone:</strong> @Model.Patient.PhoneNumber</p>
                    <p><strong>Email:</strong> @Model.Patient.Email</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Address:</strong> @Model.Patient.HomeAddress</p>
                    <p><strong>Emergency Contact:</strong> @Model.Patient.EmergencyContact</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Vital Signs -->
    <div class="card mb-4">
        <div class="card-header">
            <h5>Vital Signs</h5>
        </div>
        <div class="card-body">
            @if (Model.VitalSigns.Any())
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Temperature</th>
                            <th>Heart Rate</th>
                            <th>Blood Pressure</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vital in Model.VitalSigns.OrderByDescending(v => v.RecordedDate).Take(5))
                        {
                            <tr>
                                <td>@vital.RecordedDate.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>@vital.Temperature°C</td>
                                <td>@vital.HeartRate bpm</td>
                                <td>@vital.BloodPressure</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No vital signs recorded</p>
            }
        </div>
    </div>

    <!-- Treatments -->
    <div class="card mb-4">
        <div class="card-header">
            <h5>Treatments</h5>
        </div>
        <div class="card-body">
            @if (Model.Treatments.Any())
            {
                <ul>
                    @foreach (var treatment in Model.Treatments.OrderByDescending(t => t.DatePerformed).Take(5))
                    {
                        <li>@treatment.TreatmentType - @treatment.DatePerformed.ToString("MMM dd, yyyy")</li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">No treatments recorded</p>
            }
        </div>
    </div>
</div>