@model Wellness_Wardens_Project.ViewModels.PatientFolderViewModel
@using Wellness_Wardens_Project.Models.AdministrationSubsystem


@{
    ViewData["Title"] = "Patient Folder - " + Model.Patient.FirstName + " " + Model.Patient.LastName;
}


<!-- Quick Stats Dashboard with Smaller Back Button -->
<div class="row mb-4 align-items-center">
    <!--  Back Button -->
    <div class="col-auto">
        <a asp-action="Index"
           class="btn btn-sm d-flex align-items-center text-white"
           style="background-color: #005b96; border-radius: 0.375rem; border: none;">
            <i class="fas fa-arrow-left me-2"></i> Back to Dashboard
        </a>
    </div>

    <!-- Vital Signs Card -->
    <div class="col-xl-2 col-md-4 col-6">
        <div class="card text-white dashboard-stat-card" style="background-color: #005b96;">
            <div class="card-body text-center p-3">
                <i class="fas fa-heartbeat fa-2x mb-2"></i>
                <h4 class="mb-0">@Model.VitalSigns.Count</h4>
                <small>Vital Records</small>
            </div>
        </div>
    </div>

    <!-- Treatments Card -->
    <div class="col-xl-2 col-md-4 col-6">
        <div class="card text-white dashboard-stat-card" style="background-color: #005b96;">
            <div class="card-body text-center p-3">
                <i class="fas fa-stethoscope fa-2x mb-2"></i>
                <h4 class="mb-0">@Model.Treatments.Count</h4>
                <small>Treatments</small>
            </div>
        </div>
    </div>

    <!-- Doctor Visits Card -->
    <div class="col-xl-2 col-md-4 col-6">
        <div class="card text-white dashboard-stat-card" style="background-color: #005b96;">
            <div class="card-body text-center p-3">
                <i class="fas fa-user-md fa-2x mb-2"></i>
                <h4 class="mb-0">@Model.DoctorVisits.Count</h4>
                <small>Doctor Visits</small>
            </div>
        </div>
    </div>

    <!-- PDF Export Card -->
    <div class="col-xl-2 col-md-4 col-6">
        <div class="card text-white dashboard-stat-card" style="background-color: #005b96; cursor: pointer;" onclick="generatePatientPDF()">
            <div class="card-body text-center p-3">
                <i class="fas fa-file-pdf fa-2x mb-2"></i>
                <h4 class="mb-0">Export</h4>
                <small>PDF Report</small>
            </div>
        </div>
    </div>
</div>

<!-- Main Dashboard Grid -->
<div class="row">
    <!-- Patient Information Card -->
    <div class="col-xl-4 col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: #005b96;">
                <h5 class="mb-0"><i class="fas fa-user me-2"></i>Patient Information</h5>
                <div class="btn-group">
                    <button class="btn btn-light btn-sm">
                        <i class="fas fa-edit"></i>
                    </button>
                </div>
            </div>
            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                <div class="patient-info-grid">
                    <!-- Identity Number -->
                    <div class="info-item">
                        <i class="fas fa-id-card" style="color: #005b96;"></i>
                        <div>
                            <small class="text-muted">Identity Number</small>
                            <div class="fw-semibold">@Model.Patient.IdentityNumber</div>
                        </div>
                    </div>

                    <!-- Name Information -->
                    <div class="info-item">
                        <i class="fas fa-signature" style="color: #005b96;"></i>
                        <div class="d-flex gap-3">
                            <div>
                                <small class="text-muted">First Name</small>
                                <div class="fw-semibold">@Model.Patient.FirstName</div>
                            </div>
                            <div>
                                <small class="text-muted">Last Name</small>
                                <div class="fw-semibold">@Model.Patient.LastName</div>
                            </div>
                        </div>
                    </div>

                    <!-- Gender -->
                    <div class="info-item">
                        <i class="fas fa-venus-mars" style="color: #005b96;"></i>
                        <div>
                            <small class="text-muted">Gender</small>
                            <div class="fw-semibold">@Model.Patient.Gender</div>
                        </div>
                    </div>

                    <!-- Date of Birth -->
                    <div class="info-item">
                        <i class="fas fa-birthday-cake" style="color: #005b96;"></i>
                        <div>
                            <small class="text-muted">Date of Birth</small>
                            <div class="fw-semibold">@Model.Patient.DateOfBirth.ToString("MMM dd, yyyy")</div>
                            <small class="text-muted">(@(DateTime.Now.Year - Model.Patient.DateOfBirth.Year) years old)</small>
                        </div>
                    </div>

                    <!-- Contact Information -->
                    <div class="info-item">
                        <i class="fas fa-phone" style="color: #005b96;"></i>
                        <div>
                            <small class="text-muted">Phone</small>
                            <div class="fw-semibold">@Model.Patient.PhoneNumber</div>
                        </div>
                    </div>

                    <div class="info-item">
                        <i class="fas fa-envelope" style="color: #005b96;"></i>
                        <div>
                            <small class="text-muted">Email</small>
                            <div class="fw-semibold text-truncate">@Model.Patient.Email</div>
                        </div>
                    </div>

                    <!-- Address -->
                    <div class="info-item">
                        <i class="fas fa-home" style="color: #005b96;"></i>
                        <div>
                            <small class="text-muted">Address</small>
                            <div class="fw-semibold">@Model.Patient.HomeAddress</div>
                        </div>
                    </div>

                    <!-- Emergency Contact -->
                    <div class="info-item">
                        <i class="fas fa-ambulance" style="color: #005b96;"></i>
                        <div>
                            <small class="text-muted">Emergency Contact</small>
                            <div class="fw-semibold">@Model.Patient.EmergencyContact</div>
                        </div>
                    </div>

                    <!-- Medical Conditions -->
                    <div class="info-item">
                        <i class="fas fa-stethoscope" style="color: #005b96;"></i>
                        <div class="w-100">
                            <small class="text-muted">Medical Conditions</small>
                            <div class="medical-conditions-list mt-1">
                                @if (Model.MedicalConditions.Any())
                                {
                                    foreach (var condition in Model.MedicalConditions)
                                    {
                                        <div class="condition-item d-block mb-2">
                                            <span class="fw-semibold text-primary">
                                                <i class="fas fa-file-medical me-1"></i>@condition.Name
                                            </span>
                                            @if (!string.IsNullOrEmpty(condition.Description))
                                            {
                                                <div class="text-muted small ms-3">@condition.Description</div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted fw-semibold">No medical conditions recorded</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Chronic Conditions -->
                    <div class="info-item">
                        <i class="fas fa-heartbeat" style="color: #005b96;"></i>
                        <div class="w-100">
                            <small class="text-muted">Chronic Conditions</small>
                            <div class="fw-semibold">
                                @if (!string.IsNullOrEmpty(Model.Patient.ChronicCondition))
                                {
                                    @Model.Patient.ChronicCondition
                                }
                                else
                                {
                                    <span class="text-muted">None recorded</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Chronic Medications -->
                    <div class="info-item">
                        <i class="fas fa-pills" style="color: #005b96;"></i>
                        <div class="w-100">
                            <small class="text-muted">Chronic Medications</small>
                            <div class="fw-semibold">
                                @if (!string.IsNullOrEmpty(Model.Patient.ChronicMedication))
                                {
                                    @Model.Patient.ChronicMedication
                                }
                                else
                                {
                                    <span class="text-muted">None recorded</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Medical History -->
                    <div class="info-item">
                        <i class="fas fa-file-medical" style="color: #005b96;"></i>
                        <div class="w-100">
                            <small class="text-muted">Medical History</small>
                            <div class="fw-semibold medical-history-text">
                                @if (!string.IsNullOrEmpty(Model.Patient.MedicalHistory))
                                {
                                    @Model.Patient.MedicalHistory
                                }
                                else
                                {
                                    <span class="text-muted">No medical history recorded</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Allergies Section -->
                    <div class="info-item">
                        <i class="fas fa-allergies" style="color: #005b96;"></i>
                        <div class="w-100">
                            <small class="text-muted">Allergies</small>
                            <div class="allergies-list mt-1">
                                @if (Model.Allergies.Any())
                                {
                                    foreach (var allergy in Model.Allergies)
                                    {
                                        <div class="allergy-item d-block mb-1">
                                            <span class="fw-semibold text-danger">
                                                <i class="fas fa-exclamation-triangle me-1"></i>@allergy.Name
                                            </span>
                                            @if (!string.IsNullOrEmpty(allergy.Description))
                                            {
                                                <div class="text-muted small ms-3">@allergy.Description</div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted fw-semibold">None</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Recent Vital Signs Card -->
    <div class="col-xl-4 col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: #005b96;">
                <h5 class="mb-0"><i class="fas fa-heartbeat me-2"></i>Recent Vital Signs</h5>
                <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addVitalModal">
                    <i class="fas fa-plus"></i>Add
                </button>
            </div>
            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                @if (Model.VitalSigns.Any())
                {
                    var latestVitals = Model.VitalSigns.OrderByDescending(v => v.RecordedDate).Take(10);
                    foreach (var vital in latestVitals)
                    {
                        <div class="vital-sign-item mb-3 p-3 border rounded">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <small class="text-muted">@vital.RecordedDate.ToString("MMM dd, HH:mm")</small>
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-warning"
                                            data-bs-toggle="modal" data-bs-target="#editVitalModal-@vital.VitalId">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal" data-bs-target="#deleteVitalModal-@vital.VitalId">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="row text-center">
                                <div class="col-4">
                                    <div class="vital-value @GetVitalColorClass("temp", vital.Tempareture)">
                                        @vital.Tempareture°C
                                    </div>
                                    <small class="text-muted">Temp</small>
                                </div>
                                <div class="col-4">
                                    <div class="vital-value @GetVitalColorClass("hr", vital.HeartRate)">
                                        @vital.HeartRate
                                    </div>
                                    <small class="text-muted">Heart Rate</small>
                                </div>
                                <div class="col-4">
                                    <div class="vital-value @GetVitalColorClass("bp", vital.BloodPressure)">
                                        @vital.BloodPressure
                                    </div>
                                    <small class="text-muted">BP</small>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-heartbeat fa-3x mb-3"></i>
                        <p>No vital signs recorded</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Treatments Card -->
    <div class="col-xl-4 col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: #005b96;">
                <h5 class="mb-0"><i class="fas fa-stethoscope me-2"></i>Recent Treatments</h5>
                <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addTreatmentModal">
                    <i class="fas fa-plus"></i>Add
                </button>
            </div>
            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                @if (Model.Treatments.Any())
                {
                    var recentTreatments = Model.Treatments.OrderByDescending(t => t.DatePerformed).Take(8);
                    foreach (var treatment in recentTreatments)
                    {
                        <div class="treatment-item mb-3 p-3 border rounded">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">@treatment.TreatmentType</h6>
                                    <small class="text-muted">
                                        <i class="fas fa-calendar me-1"></i>
                                        @treatment.DatePerformed.ToString("MMM dd, yyyy")
                                    </small>
                                </div>
                                <div class="btn-group ms-2">
                                    <button class="btn btn-sm btn-outline-warning"
                                            data-bs-toggle="modal" data-bs-target="#editTreatmentModal-@treatment.TreatmentId">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal" data-bs-target="#deleteTreatmentModal-@treatment.TreatmentId">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-stethoscope fa-3x mb-3"></i>
                        <p>No treatments recorded</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Scheduled Medications Card -->
    <div class="col-xl-6 mb-4">
        <div class="card h-100">
            <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: #dc3545;">
                <h5 class="mb-0"><i class="fas fa-prescription-bottle-alt me-2"></i>Scheduled Medications</h5>
                @if (User.IsInRole("Nursing Sister"))
                {
                    <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addScheduledModal">
                        <i class="fas fa-syringe me-1"></i> Administer
                    </button>
                }
            </div>
            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                @if (Model.ScheduledAssignments.Any())
                {
                    foreach (var assignment in Model.ScheduledAssignments)
                    {
                        <div class="administration-item mb-3 p-3 border rounded">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="mb-1">
                                        <i class="fas fa-syringe me-1"></i>
                                        @assignment.AssignmentDate.ToString("MMM dd, yyyy hh:mm tt")
                                    </h6>
                                    <small class="text-muted">
                                        Administered by: @assignment.Employee?.FirstName @assignment.Employee?.LastName
                                        @if (assignment.Medication.ScheduleLevel > 4)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Level @assignment.Medication.ScheduleLevel</span>
                                        }
                                    </small>
                                </div>
                                <span class="badge bg-success">Administered</span>
                            </div>

                            <div class="medication-details">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong class="text-primary">@assignment.Medication.Name</strong>
                                        <div class="text-muted small mt-1">
                                            <div><strong>Dosage:</strong> @assignment.Dosage</div>
                                            <div><strong>Frequency:</strong> @assignment.Frequency</div>
                                            <div><strong>Duration:</strong> @assignment.DurationDays day/s</div>
                                            @if (!string.IsNullOrEmpty(assignment.AdministrationNotes))
                                            {
                                                <div class="mt-1">
                                                    <strong>Notes:</strong> @assignment.AdministrationNotes
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    @if (User.IsInRole("Nursing Sister"))
                                    {
                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-outline-warning"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editScheduledModal-@assignment.PatientMedicationId">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteScheduledModal-@assignment.PatientMedicationId">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-prescription-bottle-alt fa-3x mb-3"></i>
                        <p>No scheduled medications administered</p>
                        @if (User.IsInRole("Nursing Sister"))
                        {
                            <small class="text-primary">Click the Administer button to add medication</small>
                        }
                        else
                        {
                            <small class="text-warning">Only nursing sisters can administer scheduled medications</small>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Administer Scheduled Medication Modal -->
    <div class="modal fade" id="addScheduledModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header text-white" style="background-color: #dc3545;">
                    <h5 class="modal-title">Administer Scheduled Medication</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @using (Html.BeginForm("AdministerMedication", "Patient", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="PatientId" value="@ViewBag.PatientId" />

                        <div class="mb-3">
                            <label class="form-label">Select Scheduled Medication *</label>
                            <select name="MedicationId" class="form-control" required>
                                <option value="">Select Scheduled Medication</option>
                                @foreach (var med in ViewBag.ScheduledMedications as List<Medication>)
                                {
                                    <option value="@med.MedicationId">@med.Name (Available: @med.QuantityAvailable)</option>
                                }
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Dosage *</label>
                                    <input type="text" name="Dosage" class="form-control" placeholder="e.g., 500mg" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Frequency *</label>
                                    <input type="text" name="Frequency" class="form-control" placeholder="e.g., Twice daily" required />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Duration (Days)</label>
                                    <input type="number" name="DurationDays" class="form-control" min="0" value="0" />
                                    <small class="text-muted">Set to 0 for single dose assignment</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Quantity to Assign *</label>
                                    <input type="number" name="QuantityAssigned" class="form-control" min="1" value="1" required />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Administration Notes</label>
                            <textarea name="AdministrationNotes" class="form-control" rows="3"
                                  placeholder="Additional instructions or notes..."></textarea>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-lg" style="background-color: #dc3545; color: white;">
                                <i class="fas fa-syringe me-2"></i>Administer Medication
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Non-Scheduled Medications Card -->
    <div class="col-xl-6 mb-4">
        <div class="card h-100">
            <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: #005b96;">
                <h5 class="mb-0"><i class="fas fa-pills me-2"></i>Non-Scheduled Medications</h5>
                @if (User.IsInRole("Nurse"))
                {
                    <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#assignNonScheduledModal">
                        <i class="fas fa-syringe me-1"></i> Administer
                    </button>
                }
            </div>
            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                @if (Model.NonScheduledAssignments != null && Model.NonScheduledAssignments.Any())
                {
                    foreach (var assignment in Model.NonScheduledAssignments)
                    {
                        <div class="assignment-item mb-3 p-3 border rounded">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="mb-1">
                                        <i class="fas fa-calendar me-1"></i>
                                        @assignment.AssignmentDate.ToString("MMM dd, yyyy")
                                    </h6>
                                    <small class="text-muted">
                                        Assigned by: @assignment.Employee?.FirstName @assignment.Employee?.LastName
                                    </small>
                                </div>
                                <span class="badge bg-success">Administered</span>
                            </div>

                            <div class="medication-details">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@assignment.Medication.Name</strong>
                                        <div class="text-muted small">
                                            <div>Dosage: @assignment.Dosage</div>
                                            <div>Frequency: @assignment.Frequency</div>
                                            <div>Duration: @assignment.DurationDays days</div>
                                            <div>Quantity: @assignment.QuantityAssigned</div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(assignment.AdministrationNotes))
                                        {
                                            <div class="text-muted small mt-1">
                                                <strong>Notes:</strong> @assignment.AdministrationNotes
                                            </div>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="btn-group">
                                            @if (User.IsInRole("Nurse"))
                                            {
                                                <button class="btn btn-sm btn-outline-warning"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#editNonScheduledModal-@assignment.PatientMedicationId">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteNonScheduledModal-@assignment.PatientMedicationId">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-pills fa-3x mb-3"></i>
                        <p>No non-scheduled medications assigned</p>
                        @if (User.IsInRole("Nurse"))
                        {
                            <small>Click the "Assign" button to add non-scheduled medications</small>
                        }
                        else
                        {
                            <small class="text-warning">Only nurses can assign non-scheduled medications</small>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* <!-- Scheduled Medications Card -->
    <div class="col-xl-6 mb-4">
        <div class="card h-100">
            <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: #dc3545;">
                <h5 class="mb-0"><i class="fas fa-prescription-bottle-alt me-2"></i>Scheduled Medications</h5>
                @if (User.IsInRole("Nursing Sister"))
                {
                    <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addScheduledModal">
                        <i class="fas fa-syringe me-1"></i> Administer
                    </button>
                }
            </div>
            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                @if (Model.ScheduledAssignments.Any())
                {
                    foreach (var assignment in Model.ScheduledAssignments)
                    {
                        <div class="administration-item mb-3 p-3 border rounded">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="mb-1">
                                        <i class="fas fa-syringe me-1"></i>
                                        @assignment.AssignmentDate.ToString("MMM dd, yyyy hh:mm tt")
                                    </h6>
                                    <small class="text-muted">
                                        Administered by: @assignment.Employee?.FirstName @assignment.Employee?.LastName
                                        @if (assignment.Medication.ScheduleLevel > 4)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Level @assignment.Medication.ScheduleLevel</span>
                                        }
                                    </small>
                                </div>
                                <span class="badge bg-success">Administered</span>
                            </div>

                            <div class="medication-details">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong class="text-primary">@assignment.Medication.Name</strong>
                                        <div class="text-muted small mt-1">
                                            <div><strong>Dosage:</strong> @assignment.Dosage</div>
                                            <div><strong>Frequency:</strong> @assignment.Frequency</div>
                                            @if (!string.IsNullOrEmpty(assignment.AdministrationNotes))
                                            {
                                                <div class="mt-1">
                                                    <strong>Notes:</strong> @assignment.AdministrationNotes
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    @if (User.IsInRole("Nursing Sister"))
                                    {
                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-outline-warning"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editScheduledModal-@assignment.PatientMedicationId">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    onclick="confirmDelete(@assignment.PatientMedicationId, '@assignment.Medication.Name')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-prescription-bottle-alt fa-3x mb-3"></i>
                        <p>No scheduled medications administered</p>
                        @if (User.IsInRole("Nursing Sister"))
                        {
                            <small class="text-primary">Click the Administer button to add medication</small>
                        }
                        else
                        {
                            <small class="text-warning">Only nursing sisters can administer scheduled medications</small>
                        }
                    </div>
                }
            </div>
        </div>
    </div> *@

    <!-- Recent Prescription Card -->
    <div class="col-xl-6 mb-4">
        <div class="card h-100">
            <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: #28a745;">
                <div>
                    <i class="fas fa-prescription me-2"></i>
                    <span>Recent Prescription</span>
                </div>
            </div>
            <div class="card-body">
                @if (Model.RecentPrescription != null)
                {
                    var prescription = Model.RecentPrescription;

                    <div class="prescription-details">
                        <!-- Header with Date and Status -->
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h6 class="mb-1">@prescription.DateWritten.ToString("MMM dd, yyyy")</h6>
                            </div>
                        </div>

                        <!-- Medications -->
                        <div class="medications-section mb-3">
                            <h6 class="text-primary mb-2">
                                <i class="fas fa-pills me-1"></i>Medications
                            </h6>
                            @if (prescription.PrescriptionMedications.Any())
                            {
                                <div class="list-group">
                                    @foreach (var pm in prescription.PrescriptionMedications)
                                    {
                                        <div class="list-group-item list-group-item-action">
                                            <div class="d-flex w-100 justify-content-between">
                                                <h7 class="mb-1">@pm.Medication?.Name</h7>
                                                @if (!string.IsNullOrEmpty(pm.Dosage))
                                                {
                                                    <small class="text-muted">@pm.Dosage</small>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small">No medications listed</p>
                            }
                        </div>

                        <!-- General Instructions -->
                        @if (!string.IsNullOrEmpty(prescription.Instructions))
                        {
                            <div class="instructions-section mb-3">
                                <h6 class="text-primary mb-2">
                                    <i class="fas fa-info-circle me-1"></i>Instructions
                                </h6>
                                <div class="alert alert-info py-2">
                                    <p class="mb-0 small">@prescription.Instructions</p>
                                </div>
                            </div>
                        }

                        <!-- Prescriber Information -->
                        <div class="prescriber-info">
                            <small class="text-muted">
                                <i class="fas fa-user-md me-1"></i>
                                Prescribed by: Dr. @prescription.Employee?.FirstName @prescription.Employee?.LastName
                            </small>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-prescription fa-3x mb-3"></i>
                        <h6>No Prescriptions</h6>
                        <p class="small">No prescriptions found for this patient</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Doctor Visits & Notes with Tabs -->
    <div class="col-xl-6 mb-4">
        <div class="card h-100">
            <div class="card-header text-white" style="background-color: #005b96;">
                <ul class="nav nav-tabs card-header-tabs">
                    <li class="nav-item">
                        <a class="btn text-white border-0" data-bs-toggle="tab" href="#notesTab" style="background: transparent;">
                            <i class="fas fa-file-medical me-1"></i>Visit Notes
                        </a>
                    </li>
                </ul>
            </div>
            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                <div class="tab-content">
                    

                    <!-- Notes Tab -->
                    <div class="tab-pane fade" id="notesTab">
                        @if (Model.VisitNotes.Any())
                        {
                            <div class="timeline">
                                @foreach (var note in Model.VisitNotes.OrderByDescending(vn => vn.VisitDate).Take(5))
                                {
                                    <div class="timeline-item mb-3">
                                        <div class="timeline-marker" style="background-color: #28a745;"></div>
                                        <div class="timeline-content">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <h6 class="mb-1">Visit Note on @note.VisitDate.ToString("MMM dd, yyyy")</h6>
                                                <small class="text-muted">@note.VisitDate.ToString("HH:mm")</small>
                                            </div>
                                            <div class="soap-note-preview small">
                                                <p class="mb-1"><strong>S:</strong> @note.Subjective</p>
                                                <p class="mb-1"><strong>O:</strong> @note.Objective</p>
                                                <p class="mb-1"><strong>A:</strong> @note.Assessment</p>
                                                <p class="mb-0"><strong>P:</strong> @note.Plan</p>
                                            </div>
                                            <small class="text-muted mt-1">
                                                Dr. @note.Doctor?.FirstName @note.Doctor?.LastName
                                            </small>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <i class="fas fa-file-medical fa-3x mb-3"></i>
                                <p>No Visit notes recorded</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


