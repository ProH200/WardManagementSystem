@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        function generatePatientPDF() {
            // Store the clicked button reference
            const clickedButton = event.target;
            const originalText = clickedButton.innerHTML;

            // Show loading indicator
            clickedButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            clickedButton.disabled = true;

            // Create a temporary element for PDF generation
            const element = document.createElement('div');
            element.style.padding = '20px';
            element.style.backgroundColor = 'white';

            // Get patient basic info
            const patientName = '@Model.Patient.FirstName @Model.Patient.LastName';
            const identityNumber = '@Model.Patient.IdentityNumber';
            const currentDate = new Date().toLocaleDateString();

            // Build PDF content using direct model values to avoid circular references

            element.innerHTML = `
                                <div style="text-align: center; margin-bottom: 30px; border-bottom: 2px solid #005b96; padding-bottom: 20px;">
                                    <h1 style="color: #005b96; margin-bottom: 5px;">Patient Medical Report</h1>
                                    <h2 style="color: #333; margin-bottom: 10px;">${patientName}</h2>
                                    <p style="color: #666;">Identity Number: ${identityNumber} | Generated on: ${currentDate}</p>
                                </div>

                                <div style="margin-bottom: 30px;">
                                    <h3 style="color: #005b96; border-bottom: 1px solid #ddd; padding-bottom: 10px;">Personal Information</h3>
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tr>
                                            <td style="padding: 8px; border: 1px solid #ddd; width: 30%;"><strong>Full Name:</strong></td>
                                            <td style="padding: 8px; border: 1px solid #ddd;">@Model.Patient.FirstName @Model.Patient.LastName</td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Identity Number:</strong></td>
                                            <td style="padding: 8px; border: 1px solid #ddd;">@Model.Patient.IdentityNumber</td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Gender:</strong></td>
                                            <td style="padding: 8px; border: 1px solid #ddd;">@Model.Patient.Gender</td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Date of Birth:</strong></td>
                                            <td style="padding: 8px; border: 1px solid #ddd;">@Model.Patient.DateOfBirth.ToString("MMM dd, yyyy") (Age: @(DateTime.Now.Year - Model.Patient.DateOfBirth.Year))</td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Contact:</strong></td>
                                            <td style="padding: 8px; border: 1px solid #ddd;">@Model.Patient.PhoneNumber | @Model.Patient.Email</td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Address:</strong></td>
                                            <td style="padding: 8px; border: 1px solid #ddd;">@Model.Patient.HomeAddress</td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Emergency Contact:</strong></td>
                                            <td style="padding: 8px; border: 1px solid #ddd;">@Model.Patient.EmergencyContact</td>
                                        </tr>
                                    </table>
                                </div>

                                <div style="margin-bottom: 30px;">
                                    <h3 style="color: #005b96; border-bottom: 1px solid #ddd; padding-bottom: 10px;">Medical Information</h3>
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tr>
                                            <td style="padding: 8px; border: 1px solid #ddd; width: 30%;"><strong>Chronic Conditions:</strong></td>
                                            <td style="padding: 8px; border: 1px solid #ddd;">${getChronicConditions()}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Chronic Medications:</strong></td>
                                            <td style="padding: 8px; border: 1px solid #ddd;">${getChronicMedications()}</td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Medical History:</strong></td>
                                            <td style="padding: 8px; border: 1px solid #ddd;">${getMedicalHistory()}</td>
                                        </tr>
                                    </table>
                                </div>

                                ${generateMedicalConditionsSection()}
                                ${generateAllergiesSection()}
                                ${generateVitalSignsSection()}
                                ${generateTreatmentsSection()}
                                ${generateMedicationsSection()}
                                ${generateDoctorVisitsSection()}

                                <div style="margin-top: 40px; text-align: center; color: #666; font-size: 12px;">
                                    <p>This report was generated automatically from Wellness Wardens System on ${new Date().toLocaleString()}</p>
                                    <p>Confidential Patient Information - For Medical Use Only</p>
                                </div>
                            `;

            // PDF options
            const options = {
                margin: [10, 10, 10, 10],
                filename: `Patient_Report_${patientName.replace(/\s+/g, '_')}_${currentDate.replace(/\//g, '-')}.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: {
                    scale: 2,
                    useCORS: true,
                    logging: false
                },
                jsPDF: {
                    unit: 'mm',
                    format: 'a4',
                    orientation: 'portrait'
                }
            };

            // Generate PDF with proper promise handling
            html2pdf().set(options).from(element).toPdf().get('pdf').then(function (pdf) {
                // PDF generation completed successfully
                pdf.save(options.filename);
            }).finally(function () {
                // Always restore button state, whether success or error
                clickedButton.innerHTML = originalText;
                clickedButton.disabled = false;
            }).catch(function (error) {
                // Handle any errors that occurred during PDF generation
                console.error('PDF generation error:', error);
                // Still restore button state even if there was an error
                clickedButton.innerHTML = originalText;
                clickedButton.disabled = false;

            });
        }

        // Helper functions for PDF content generation - using direct model access
        function getChronicConditions() {
            const condition = '@Model.Patient.ChronicCondition';
            return condition && condition !== '' ? condition : 'None recorded';
        }

        function getChronicMedications() {
            const medication = '@Model.Patient.ChronicMedication';
            return medication && medication !== '' ? medication : 'None recorded';
        }

        function getMedicalHistory() {
            const history = '@Model.Patient.MedicalHistory';
            return history && history !== '' ? history : 'No medical history recorded';
        }

        function generateMedicalConditionsSection() {
            const conditionsCount = @Model.MedicalConditions.Count;
            if (conditionsCount === 0) {
                return '<div style="margin-bottom: 20px;"><h4 style="color: #005b96;">Medical Conditions: None recorded</h4></div>';
            }

            let html = '<div style="margin-bottom: 20px;"><h4 style="color: #005b96;">Medical Conditions</h4><ul style="margin: 0; padding-left: 20px;">';

            // We'll use the data already displayed in the HTML instead of JSON serialization
        @foreach (var condition in Model.MedicalConditions)
        {
            <text>
                    html += '<li><strong>@Html.Raw(condition.Name)</strong>@(string.IsNullOrEmpty(condition.Description) ? "" : ": @Html.Raw(condition.Description)")</li>';
            </text>
        }

                html += '</ul></div>';
            return html;
        }

        function generateAllergiesSection() {
            const allergiesCount = @Model.Allergies.Count;
            if (allergiesCount === 0) {
                return '<div style="margin-bottom: 20px;"><h4 style="color: #005b96;">Allergies: No known allergies</h4></div>';
            }

            let html = '<div style="margin-bottom: 20px;"><h4 style="color: #005b96;">Allergies</h4><ul style="margin: 0; padding-left: 20px;">';

        @foreach (var allergy in Model.Allergies)
        {
            <text>
                    html += '<li><strong style="color: #dc3545;">@Html.Raw(allergy.Name)</strong>@(string.IsNullOrEmpty(allergy.Description) ? "" : ": @Html.Raw(allergy.Description)")</li>';
            </text>
        }

                html += '</ul></div>';
            return html;
        }

        function generateVitalSignsSection() {
            const vitalsCount = @Model.VitalSigns.Count;
            if (vitalsCount === 0) {
                return '<div style="margin-bottom: 20px;"><h4 style="color: #005b96;">Vital Signs: No records available</h4></div>';
            }

            let html = `
                                <div style="margin-bottom: 20px;">
                                    <h4 style="color: #005b96;">Recent Vital Signs (Last 10 records)</h4>
                                    <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                                        <thead>
                                            <tr style="background-color: #f8f9fa;">
                                                <th style="padding: 8px; border: 1px solid #ddd;">Date & Time</th>
                                                <th style="padding: 8px; border: 1px solid #ddd;">Temperature (°C)</th>
                                                <th style="padding: 8px; border: 1px solid #ddd;">Heart Rate</th>
                                                <th style="padding: 8px; border: 1px solid #ddd;">Blood Pressure</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                            `;

            // Use the latest 10 vital signs
        @foreach (var vital in Model.VitalSigns.OrderByDescending(v => v.RecordedDate).Take(10))
        {
            <text>
                    html += `
                                            <tr>
                                                <td style="padding: 8px; border: 1px solid #ddd;">@vital.RecordedDate.ToString("MMM dd, yyyy HH:mm")</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">@vital.Tempareture</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">@vital.HeartRate</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">@vital.BloodPressure</td>
                                            </tr>
                                        `;
            </text>
        }

                html += '</tbody></table></div>';
            return html;
        }

        function generateTreatmentsSection() {
            const treatmentsCount = @Model.Treatments.Count;
            if (treatmentsCount === 0) {
                return '<div style="margin-bottom: 20px;"><h4 style="color: #005b96;">Treatments: No records available</h4></div>';
            }

            let html = `
                                <div style="margin-bottom: 20px;">
                                    <h4 style="color: #005b96;">Recent Treatments (Last 8 records)</h4>
                                    <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                                        <thead>
                                            <tr style="background-color: #f8f9fa;">
                                                <th style="padding: 8px; border: 1px solid #ddd;">Date</th>
                                                <th style="padding: 8px; border: 1px solid #ddd;">Treatment Type</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                            `;

        @foreach (var treatment in Model.Treatments.OrderByDescending(t => t.DatePerformed).Take(8))
        {
            <text>
                    html += `
                                            <tr>
                                                <td style="padding: 8px; border: 1px solid #ddd;">@treatment.DatePerformed.ToString("MMM dd, yyyy")</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">@Html.Raw(treatment.TreatmentType)</td>
                                            </tr>
                                        `;
            </text>
        }

                html += '</tbody></table></div>';
            return html;
        }

                function generateMedicationsSection() {
                    const nonScheduledCount = @Model.NonScheduledAssignments.Count;
                    const scheduledCount = @Model.ScheduledAssignments.Count;

                    let html = '<div style="margin-bottom: 20px;"><h4 style="color: #005b96;">Current Medications</h4>';

                    if (nonScheduledCount === 0 && scheduledCount === 0) {
                        html += '<p>No current medications</p></div>';
                        return html;
                    }

                    if (nonScheduledCount > 0) {
                        html += '<h5 style="color: #005b96; margin-top: 15px;">Non-Scheduled Medications (Level 1-4)</h5>';
                        @foreach (var assignment in Model.NonScheduledAssignments)
                        {
                                <text>
                                    html += '<p style="margin: 5px 0;"><strong>@Html.Raw(assignment.Medication.Name)</strong> - @Html.Raw(assignment.Dosage), @Html.Raw(assignment.Frequency), @assignment.DurationDays days, Qty: @assignment.QuantityAssigned (Level @assignment.Medication.ScheduleLevel)</p>';
                                </text>
                        }
                    }

                    if (scheduledCount > 0) {
                        html += '<h5 style="color: #005b96; margin-top: 15px;">Scheduled Medications (Level 5-10)</h5>';
                        @foreach (var assignment in Model.ScheduledAssignments)
                        {
                                <text>
                                    html += '<p style="margin: 5px 0;"><strong>@Html.Raw(assignment.Medication.Name)</strong> - @Html.Raw(assignment.Dosage), @Html.Raw(assignment.Frequency), @assignment.DurationDays days, Qty: @assignment.QuantityAssigned (Level @assignment.Medication.ScheduleLevel)</p>';
                                </text>
                        }
                    }

                    html += '</div>';
                    return html;
                }
        function allowOnlyText(event) {
            const char = String.fromCharCode(event.which);
            // Allow letters, spaces, and basic punctuation
            const allowedChars = /[A-Za-z\s.,!?()-]/;

            if (!allowedChars.test(char)) {
                event.preventDefault();
                return false;
            }
            return true;
        }

        function generateDoctorVisitsSection() {
            const visitsCount = @Model.DoctorVisits.Count;
            if (visitsCount === 0) {
                return '<div style="margin-bottom: 20px;"><h4 style="color: #005b96;">Doctor Visits: No records available</h4></div>';
            }

            let html = `
                                <div style="margin-bottom: 20px;">
                                    <h4 style="color: #005b96;">Recent Doctor Visits (Last 10 records)</h4>
                                    <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                                        <thead>
                                            <tr style="background-color: #f8f9fa;">
                                                <th style="padding: 8px; border: 1px solid #ddd;">Visit Date</th>
                                                <th style="padding: 8px; border: 1px solid #ddd;">Instructions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                            `;

        @foreach (var visit in Model.DoctorVisits.OrderByDescending(d => d.VisitDate).Take(10))
        {
            <text>
                    html += `
                                            <tr>
                                                <td style="padding: 8px; border: 1px solid #ddd;">@visit.VisitDate.ToString("MMM dd, yyyy")</td>
                                                <td style="padding: 8px; border: 1px solid #ddd;">@(string.IsNullOrEmpty(visit.Instructions) ? "No specific instructions" : Html.Raw(visit.Instructions))</td>
                                            </tr>
                                        `;
            </text>
        }

                html += '</tbody></table></div>';
            return html;
        }
    </script>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <script>
                // Universal toast notification function
                function showUniversalToast(icon, title, message) {
                    const Toast = Swal.mixin({
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 5000,
                        timerProgressBar: true,
                        background: '#fff',
                        iconColor: getIconColor(icon),
                        color: '#2c3e50',
                        didOpen: (toast) => {
                            toast.addEventListener('mouseenter', Swal.stopTimer);
                            toast.addEventListener('mouseleave', Swal.resumeTimer);
                        }
                    });

                    Toast.fire({
                        icon: icon,
                        title: title,
                        text: message
                    });
                }

                // Get appropriate color for each icon type
                function getIconColor(icon) {
                    const colors = {
                        'success': '#28a745',
                        'error': '#dc3545',
                        'warning': '#ffc107',
                        'info': '#17a2b8',
                        'question': '#6c757d'
                    };
                    return colors[icon] || '#6c757d';
                }

                // Check for TempData messages on page load
                document.addEventListener('DOMContentLoaded', function() {
                    // Success message
                    @if (TempData["SuccessMessage"] != null)
                    {
                            <text>
                            showUniversalToast('success', 'Success', '@Html.Raw(TempData["SuccessMessage"])');
                            </text>
                    }

                    // Error message
                    @if (TempData["ErrorMessage"] != null)
                    {
                            <text>
                            showUniversalToast('error', 'Error', '@Html.Raw(TempData["ErrorMessage"])');
                            </text>
                    }

                    // Warning message
                    @if (TempData["WarningMessage"] != null)
                    {
                            <text>
                            showUniversalToast('warning', 'Warning', '@Html.Raw(TempData["WarningMessage"])');
                            </text>
                    }

                    // Info message
                    @if (TempData["InfoMessage"] != null)
                    {
                            <text>
                            showUniversalToast('info', 'Information', '@Html.Raw(TempData["InfoMessage"])');
                            </text>
                    }
                });
            </script>
}

@functions {
    public string GetVitalColorClass(string type, dynamic value)
    {
        switch (type)
        {
            case "temp":
                double temp = (double)value;
                return temp >= 36.1 && temp <= 37.2 ? "vital-normal" :
                       temp >= 37.3 && temp <= 38.0 ? "vital-warning" : "vital-danger";

            case "hr":
                int hr = (int)value;
                return hr >= 60 && hr <= 100 ? "vital-normal" :
                       (hr >= 50 && hr <= 59) || (hr >= 101 && hr <= 110) ? "vital-warning" : "vital-danger";

            case "bp":
                return "vital-normal";

            default:
                return "vital-normal";
        }
    }
}