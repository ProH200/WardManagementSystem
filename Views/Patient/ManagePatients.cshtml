@using Wellness_Wardens_Project.ViewModels.PatientManagementSubsystem
@model IEnumerable<PatientViewModel>

@{
    ViewData["Title"] = "Manage Patients";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var totalPatients = Model?.Count() ?? 0;
    var currentPage = Context.Request.Query["page"].ToString() != "" ? int.Parse(Context.Request.Query["page"]) : 1;
    var viewMode = Context.Request.Query["view"].ToString() != "" ? Context.Request.Query["view"].ToString() : "grid";

    var gridPageSize = 12;
    var listPageSize = 6;
    var currentPageSize = viewMode == "list" ? listPageSize : gridPageSize;

    var totalPages = (int)Math.Ceiling((double)totalPatients / currentPageSize);
    var pagedPatients = Model?.Skip((currentPage - 1) * currentPageSize).Take(currentPageSize);
}
<link href="~/css/wardadmin.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill me-2"></i> Manage Patients</h2>
        <div>
            <a asp-controller="Administration" asp-action="WardAdminDashboard" class="btn btn-outline-primary">
                <i class="bi bi-house-door me-1"></i> Dashboard
            </a>
            <a asp-controller="Patient" asp-action="AddPatient" class="btn btn-success">
                <i class="bi bi-plus-circle me-1"></i> Add Patient
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <!-- Search bar -->
            <div class="input-group shadow" style="background-color:#CAD5E2;">
                <span class="input-group-text bg-transparent border-0"><i class="bi bi-search"></i></span>
                <input type="text" id="searchInput" class="form-control border-0 bg-transparent"
                       placeholder="Search patients by name, phone, or email..." />
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex justify-content-end gap-2">
                <!-- Sort Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="sortDropdown" data-bs-toggle="dropdown">
                        <i class="bi bi-sort-alpha-down me-1"></i> Sort By
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item sort-option" href="#" data-sort="name-asc">Name (A-Z)</a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="name-desc">Name (Z-A)</a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="id-asc">ID Number (Ascending)</a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="id-desc">ID Number (Descending)</a></li>
                    </ul>
                </div>

                <!-- View Toggle -->
                <div class="btn-group" role="group">
                    <input type="radio" class="btn-check" name="viewMode" id="gridView" autocomplete="off"
                           @(viewMode == "grid" ? "checked" : "") data-view="grid">
                    <label class="btn btn-outline-primary" for="gridView" title="Grid View">
                        <i class="bi bi-grid-3x3-gap"></i>
                    </label>

                    <input type="radio" class="btn-check" name="viewMode" id="listView" autocomplete="off"
                           @(viewMode == "list" ? "checked" : "") data-view="list">
                    <label class="btn btn-outline-primary" for="listView" title="List View">
                        <i class="bi bi-list-ul"></i>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle me-2"></i>
        Showing @((currentPage - 1) * currentPageSize + 1) to @Math.Min(currentPage * currentPageSize, totalPatients) of @totalPatients patients
        @if (viewMode == "grid")
        {
            <span>(Grid View - 12 per page)</span>
        }
        else
        {
            <span>(List View - 6 per page)</span>
        }
    </div>

    <p class="text-danger">Click Patient to view more info.</p>

    <!-- Patients Grid/List -->
    <div id="patientsContainer" class="@(pagedPatients?.Any() == true ? (viewMode == "grid" ? "row g-4 grid-view" : "list-view") : "")">
        @if (pagedPatients != null && pagedPatients.Any())
        {
            foreach (var patient in pagedPatients)
            {
                <div class="@(viewMode == "grid" ? "col-md-6 col-lg-4" : "col-12 mb-3") patient-card" data-name="@patient.FullName.ToLower()"
                     data-idnumber="@patient.IdentityNumber" data-sortable>
                    <div class="card shadow border-1 h-100 rounded-3" style="background-color:#CAD5E2; cursor:pointer;">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-0"
                                 data-bs-toggle="collapse" data-bs-target="#patientDetails-@patient.PatientId">
                                <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width:50px; height:50px;">
                                    <i class="bi bi-person-fill fs-4"></i>
                                </div>
                                <div>
                                    <h5 class="mb-0">@patient.FullName</h5>
                                    <small class="text-muted">@patient.Gender | @patient.DateOfBirth.ToShortDateString()</small>
                                </div>
                            </div>

                            <!-- Expanded Details -->
                            <div class="collapse mt-2" id="patientDetails-@patient.PatientId">
                                <div class="card shadow border-0 rounded-3 p-2" style="background-color:#CAD5E2;">
                                    <p class="mb-1"><i class="bi bi-credit-card-2-front me-2 text-secondary"></i><strong>ID:</strong> @patient.IdentityNumber</p>
                                    <p class="mb-1"><i class="bi bi-telephone-fill me-2 text-secondary"></i><strong>Phone:</strong> @patient.PhoneNumber</p>
                                    <p class="mb-1"><i class="bi bi-telephone-fill me-2 text-secondary"></i><strong>Emergency no.:</strong> @patient.EmergencyContact</p>
                                    <p class="mb-1"><i class="bi bi-envelope-fill me-2 text-secondary"></i><strong>Email:</strong> @(patient.Email ?? "N/A")</p>
                                    <p class="mb-1"><i class="bi bi-house-door-fill me-2 text-secondary"></i><strong>Address:</strong> @patient.HomeAddress</p>
                                    <p class="mb-1">
                                        <i class="bi bi-geo-alt me-2 text-secondary"></i>
                                        <strong>Current Location:</strong> @(patient.CurrentLocation ?? "N/A")
                                    </p>
                                    <p class="mb-1">
                                        <i class="bi bi-person-badge me-2 text-secondary"></i>
                                        <strong>Assigned Staff:</strong> @(patient.AssignedEmployee ?? "N/A")
                                    </p>
                                    @if (!string.IsNullOrEmpty(patient.ChronicCondition) || !string.IsNullOrEmpty(patient.ChronicMedication))
                                    {
                                        <div class="mt-2 p-2 bg-light rounded">
                                            <p class="mb-1"><i class="bi bi-heart-pulse text-danger me-2"></i><strong>Condition:</strong> @patient.ChronicCondition</p>
                                            <p class="mb-0"><i class="bi bi-capsule-pill text-primary me-2"></i><strong>Medication:</strong> @patient.ChronicMedication</p>
                                        </div>
                                    }

                                    <div class="d-flex justify-content mt-3">
                                        <a asp-controller="Patient" asp-action="GetHistory" asp-route-patientId="@patient.PatientId" class="btn btn-sm btn-outline-info text-black">
                                            Medical History
                                        </a>
                                        <button class="btn btn-sm btn-outline-warning ms-2 text-black"
                                                onclick="openAssignConditionsModal(@patient.PatientId)">
                                            Conditions
                                        </button>
                                        <a asp-action="EditPatient" asp-route-id="@patient.PatientId" class="btn btn-sm btn-outline-primary ms-2">
                                            Edit
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger ms-2" data-bs-toggle="modal" data-bs-target="#deleteModal-@patient.PatientId">
                                            Delete
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Modal Container -->
                    <div id="modalContainer"></div>

                    <!-- Delete Modal -->
                    <div class="modal fade" id="deleteModal-@patient.PatientId" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form asp-action="SoftDeletePatient" asp-controller="Patient" method="post">
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", patient.PatientId)

                                    <div class="modal-header bg-danger text-white">
                                        <h5 class="modal-title">
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Patient
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>

                                    <div class="modal-body">
                                        <p>Are you sure you want to delete <strong>@patient.FullName</strong>?</p>
                                    </div>

                                    <div class="modal-footer">
                                        <button type="submit" class="btn btn-danger">Yes, Delete</button>
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <div class="alert alert-info shadow-sm">
                    <i class="bi bi-info-circle me-2"></i> No patients found.
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav aria-label="Patient pagination" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@(currentPage - 1)&view=@viewMode" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="?page=@i&view=@viewMode">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="?page=@(currentPage + 1)&view=@viewMode" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function showToast(type, message) {
            if (!message) return;
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: type,
                title: message,
                showConfirmButton: false,
                timer: 3000
            });
        }

        // Search functionality
        const searchInput = document.getElementById('searchInput');
        const patientCards = document.querySelectorAll('.patient-card');

        searchInput.addEventListener('keyup', function () {
            const query = this.value.toLowerCase();
            let matchFound = false;

            patientCards.forEach(card => {
                const text = card.textContent.toLowerCase();
                const isMatch = text.includes(query);
                card.style.display = isMatch ? '' : 'none';
                if (isMatch) matchFound = true;
            });

            if (!matchFound && query.trim() !== "") {
                showToast('warning', 'No patients found matching your search.');
            }
        });

        // View mode toggle with page reload
        document.querySelectorAll('input[name="viewMode"]').forEach(radio => {
            radio.addEventListener('change', function() {
                const viewMode = this.getAttribute('data-view');
                // Reload page with new view mode and reset to page 1
                window.location.href = `?page=1&view=${viewMode}`;
            });
        });

        // Sorting functionality
        document.querySelectorAll('.sort-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                const sortType = this.getAttribute('data-sort');
                sortPatients(sortType);
            });
        });

        function sortPatients(sortType) {
            const container = document.getElementById('patientsContainer');
            const cards = Array.from(container.querySelectorAll('.patient-card[data-sortable]'));

            cards.sort((a, b) => {
                switch(sortType) {
                    case 'name-asc':
                        return a.getAttribute('data-name').localeCompare(b.getAttribute('data-name'));
                    case 'name-desc':
                        return b.getAttribute('data-name').localeCompare(a.getAttribute('data-name'));
                    case 'id-asc':
                        return (a.getAttribute('data-idnumber') || '').localeCompare(b.getAttribute('data-idnumber') || '');
                    case 'id-desc':
                        return (b.getAttribute('data-idnumber') || '').localeCompare(a.getAttribute('data-idnumber') || '');
                    default:
                        return 0;
                }
            });

            cards.forEach(card => container.appendChild(card));
        }

        var successMessage = @Html.Raw(Json.Serialize(TempData["SuccessMessage"] ?? ""));
        if (successMessage) {
            showToast('success', successMessage);
        }

        @foreach (var modelState in ViewData.ModelState.Values)
        {
                foreach (var error in modelState.Errors)
                {
                        <text>
                            showToast('error', @Html.Raw(Json.Serialize(error.ErrorMessage)));
                        </text>
                }
        }
    </script>

    <script>
        function openAssignConditionsModal(patientId) {
            $.get('@Url.Action("GetAssignConditionsModal")', { patientId: patientId }, function (data) {
                $('#modalContainer').html(data);
                $('#assignConditionsModal').modal('show');
            });
        }

        function showCurrentAssignments(patientId) {
            console.log('Show assignments for patient: ' + patientId);
        }
    </script>
}