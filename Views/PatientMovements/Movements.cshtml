@model IEnumerable<Wellness_Wardens_Project.Models.PatientManagementSubsystem.PatientMovement>

@{
    ViewData["Title"] = "Patient Movements";
}

<style>
    body {
        background-color: #CAD5E2;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #212529;
        margin: 0;
        padding: 0;
    }

    .movement-card {
        background-color: #D3DCE6;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        transition: transform 0.2s, box-shadow 0.2s;
        padding: 1rem;
    }

        .movement-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.15);
        }

    .table thead {
        background-color: #495057;
        color: #fff;
    }

    .btn-custom {
        border-radius: 50px;
    }

    .list-view .movement-card {
        margin-bottom: 1rem;
    }

    .grid-view .col-md-6 {
        margin-bottom: 1rem;
    }
</style>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-arrow-left-right me-2"></i> Patient Movements
        </h2>
        <a asp-action="Admitted" asp-controller="PatientMovements"
           class="btn btn-outline-secondary shadow-sm rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Back to Admitted Patients
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="input-group shadow" style="background-color:#CAD5E2;">
                <span class="input-group-text bg-transparent border-0"><i class="bi bi-search"></i></span>
                <input type="text" id="movementSearch" class="form-control border-0 bg-transparent"
                       placeholder="Search movements by location, reason, or date..." />
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex justify-content-end gap-2">
                <!-- Sort Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="sortDropdown" data-bs-toggle="dropdown">
                        <i class="bi bi-sort-alpha-down me-1"></i> Sort By
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item sort-option" href="#" data-sort="date-desc">Date (Newest First)</a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="date-asc">Date (Oldest First)</a></li>
                    </ul>
                </div>

                <!-- View Toggle -->
                <div class="btn-group" role="group">
                    <input type="radio" class="btn-check" name="viewMode" id="gridView" autocomplete="off" checked>
                    <label class="btn btn-outline-primary" for="gridView" title="Grid View">
                        <i class="bi bi-grid-3x3-gap"></i>
                    </label>

                    <input type="radio" class="btn-check" name="viewMode" id="listView" autocomplete="off">
                    <label class="btn btn-outline-primary" for="listView" title="List View">
                        <i class="bi bi-list-ul"></i>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <!-- Movements Container -->
    <div id="movementsContainer" class="row g-3 grid-view">
        @if (Model != null && Model.Any())
        {
            foreach (var movement in Model)
            {
                <div class="col-md-6 movement-item"
                     data-date="@movement.Date.ToString("yyyyMMdd")"
                     data-from="@movement.FromLocation?.ToLower()"
                     data-to="@movement.ToLocation?.ToLower()"
                     data-reason="@movement.Reason?.ToLower()">
                    <div class="movement-card">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="mb-1">@movement.Date.ToString("dd MMM yyyy")</h5>
                                <p class="mb-1"><strong>From:</strong> @movement.FromLocation</p>
                                <p class="mb-1"><strong>To:</strong> @movement.ToLocation</p>
                                <p class="mb-1"><strong>Reason:</strong> @movement.Reason</p>
                            </div>
                            <div class="d-flex flex-column gap-2">
                                <button class="btn btn-sm btn-warning"
                                        data-bs-toggle="modal"
                                        data-bs-target="#updateMovementModal"
                                        onclick="loadMovementForm(@movement.MovementId)">
                                    <i class="bi bi-pencil-square me-1"></i> Edit
                                </button>
                                <button class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteMovementModal"
                                        onclick="loadDeleteForm(@movement.MovementId)">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info shadow-sm text-center mt-4">
                    <i class="bi bi-info-circle me-2"></i> No patient movements found.
                </div>
            </div>
        }
    </div>
</div>

<!-- Update Movement Modal -->
<div class="modal fade" id="updateMovementModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Update Movement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="updateMovementModalBody">
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteMovementModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Delete Movement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="deleteMovementModalBody">
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const movementItems = document.querySelectorAll('.movement-item');
        const searchInput = document.getElementById('movementSearch');
        const movementsContainer = document.getElementById('movementsContainer');

        function loadMovementForm(movementId) {
            fetch(`/PatientMovements/EditMovementForm?movementId=${movementId}`)
                .then(res => {
                    if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
                    return res.text();
                })
                .then(html => {
                    document.getElementById("updateMovementModalBody").innerHTML = html;
                })
                .catch(error => {
                    console.error('Error loading movement form:', error);
                    document.getElementById("updateMovementModalBody").innerHTML =
                        '<div class="alert alert-danger">Error loading form. Please try again.</div>';
                });
        }

        function loadDeleteForm(movementId) {
            fetch(`/PatientMovements/DeleteMovementForm?movementId=${movementId}`)
                .then(res => {
                    if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
                    return res.text();
                })
                .then(html => {
                    document.getElementById("deleteMovementModalBody").innerHTML = html;
                })
                .catch(error => {
                    console.error('Error loading delete form:', error);
                    document.getElementById("deleteMovementModalBody").innerHTML =
                        '<div class="alert alert-danger">Error loading delete confirmation. Please try again.</div>';
                });
        }

        // Toast notification function
        function showToast(type, message) {
            if (!message) return;

            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });

            Toast.fire({
                icon: type,
                title: message
            });
        }

        // Search functionality
        searchInput.addEventListener('keyup', function () {
            const query = this.value.toLowerCase().trim();
            let matchFound = false;

            movementItems.forEach(item => {
                const text = item.textContent.toLowerCase();
                const isMatch = text.includes(query);
                item.style.display = isMatch ? '' : 'none';
                if (isMatch) matchFound = true;
            });

            if (!matchFound && query !== "") {
                showToast('warning', 'No movements found matching your search.');
            }
        });

        // View mode toggle
        document.querySelectorAll('input[name="viewMode"]').forEach(radio => {
            radio.addEventListener('change', function() {
                if (this.id === 'listView') {
                    movementsContainer.classList.remove('row', 'g-3', 'grid-view');
                    movementsContainer.classList.add('list-view');
                    movementsContainer.querySelectorAll('.movement-item').forEach(item => {
                        item.classList.remove('col-md-6');
                        item.classList.add('col-12');
                    });
                } else {
                    movementsContainer.classList.add('row', 'g-3', 'grid-view');
                    movementsContainer.classList.remove('list-view');
                    movementsContainer.querySelectorAll('.movement-item').forEach(item => {
                        item.classList.add('col-md-6');
                        item.classList.remove('col-12');
                    });
                }
            });
        });

        // Sorting functionality
        document.querySelectorAll('.sort-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                const sortType = this.getAttribute('data-sort');
                sortMovements(sortType);

                const dropdownButton = document.getElementById('sortDropdown');
                const icon = dropdownButton.querySelector('i');
                dropdownButton.innerHTML = icon.outerHTML + ' ' + this.textContent;
            });
        });

        function sortMovements(sortType) {
            const items = Array.from(movementsContainer.querySelectorAll('.movement-item'));

            items.sort((a, b) => {
                switch(sortType) {
                    case 'date-desc':
                        return (b.getAttribute('data-date') || '').localeCompare(a.getAttribute('data-date') || '');
                    case 'date-asc':
                        return (a.getAttribute('data-date') || '').localeCompare(b.getAttribute('data-date') || '');
                    case 'from-asc':
                        return (a.getAttribute('data-from') || '').localeCompare(b.getAttribute('data-from') || '');
                    case 'from-desc':
                        return (b.getAttribute('data-from') || '').localeCompare(a.getAttribute('data-from') || '');
                    case 'to-asc':
                        return (a.getAttribute('data-to') || '').localeCompare(b.getAttribute('data-to') || '');
                    case 'to-desc':
                        return (b.getAttribute('data-to') || '').localeCompare(a.getAttribute('data-to') || '');
                    default:
                        return 0;
                }
            });

            items.forEach(item => movementsContainer.appendChild(item));
        }

        // Show successs/error messages from TempData
        var successMessage = '@Html.Raw(TempData["Success"] ?? "")';
        if (successMessage) {
            showToast('success', successMessage);
        }

        var errorMessage = '@Html.Raw(TempData["Error"] ?? "")';
        if (errorMessage) {
            showToast('error', errorMessage);
        }
    </script>
}