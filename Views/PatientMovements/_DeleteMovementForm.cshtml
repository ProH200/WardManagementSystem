@model Wellness_Wardens_Project.Models.PatientManagementSubsystem.PatientMovement

<form asp-action="DeleteMovement" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="MovementId" value="@Model.MovementId" />

    <div class="text-center">
        <i class="bi bi-exclamation-triangle text-danger display-4"></i>
        <h4 class="mt-3">Confirm Delete</h4>
        <p>Are you sure you want to delete this movement record?</p>
        <p><strong>Date:</strong> @Model.Date.ToString("dd MMM yyyy")</p>
        <p><strong>From:</strong> @Model.FromLocation</p>
        <p><strong>To:</strong> @Model.ToLocation</p>
    </div>

    <div class="text-end mt-4">
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash me-1"></i> Delete
        </button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
        </button>
    </div>
</form>