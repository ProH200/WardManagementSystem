@model IEnumerable<Wellness_Wardens_Project.Models.PatientManagementSubsystem.PatientAdmission>

@{
    ViewData["Title"] = "Currently Admitted Patients";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #CAD5E2;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #212529;
    }

    .admission-card {
        background-color: #D3DCE6;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        padding: 1rem;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .admission-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.15);
        }

    .btn-custom {
        border-radius: 50px;
    }

    .list-view .admission-card {
        margin-bottom: 1rem;
    }

    .grid-view .col-md-6 {
        margin-bottom: 1rem;
    }
</style>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <h2 class="fw-bold text-primary mb-4">
            <i class="bi bi-person-lines-fill me-2"></i> Currently Admitted Patients
        </h2>
        <a asp-action="WardAdminDashboard" asp-controller="Administration"
           class="btn btn-outline-secondary shadow-sm rounded-pill px-4">
            <i class="bi bi-speedometer2 me-2"></i> Dashboard
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="input-group shadow" style="background-color:#CAD5E2;">
                <span class="input-group-text bg-transparent border-0"><i class="bi bi-search"></i></span>
                <input type="text" id="searchInput" class="form-control border-0 bg-transparent"
                       placeholder="Search patients by name, ward, room, or bed..." />
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex justify-content-end gap-2">
                <!-- Sort Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="sortDropdown" data-bs-toggle="dropdown">
                        <i class="bi bi-sort-alpha-down me-1"></i> Sort By
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item sort-option" href="#" data-sort="name-asc">Patient Name (A-Z)</a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="name-desc">Patient Name (Z-A)</a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="admission-desc">Admission Date (Newest First)</a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="admission-asc">Admission Date (Oldest First)</a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="ward-asc">Ward Name (A-Z)</a></li>
                    </ul>
                </div>

                <!-- View Toggle -->
                <div class="btn-group" role="group">
                    <input type="radio" class="btn-check" name="viewMode" id="gridView" autocomplete="off" checked>
                    <label class="btn btn-outline-primary" for="gridView" title="Grid View">
                        <i class="bi bi-grid-3x3-gap"></i>
                    </label>

                    <input type="radio" class="btn-check" name="viewMode" id="listView" autocomplete="off">
                    <label class="btn btn-outline-primary" for="listView" title="List View">
                        <i class="bi bi-list-ul"></i>
                    </label>
                </div>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div id="admissionsContainer" class="row g-4 grid-view">
            @foreach (var admission in Model)
            {
                <div class="col-md-6 col-lg-4 admission-card-wrapper"
                     data-name="@admission.Patient?.FirstName?.ToLower() @admission.Patient?.LastName?.ToLower()"
                     data-admission="@admission.AdmissionDate?.ToString("yyyyMMdd")"
                     data-ward="@admission.Bed?.Room?.Ward?.Name?.ToLower()"
                     data-room="@admission.Bed?.Room?.RoomNumber"
                     data-bed="@admission.Bed?.BedNumber">
                    <div class="admission-card">
                        <h5>@($"{admission.Patient.FirstName} {admission.Patient.LastName}")</h5>
                        <p class="mb-1"><strong>Admission Date:</strong> @admission.AdmissionDate.Value.ToString("yyyy-MM-dd")</p>
                        <p class="mb-1"><strong>Ward / Room / Bed:</strong> @($"{admission.Bed?.Room?.Ward?.Name ?? "-"} / {admission.Bed?.Room?.RoomNumber ?? "-"} / {admission.Bed?.BedNumber ?? "-"}")</p>
                        <div class="mt-2 d-flex gap-2 flex-wrap">
                            <a asp-controller="PatientMovements"
                               asp-action="Movements"
                               asp-route-admissionId="@admission.AdmissionId"
                               class="btn btn-dark btn-sm btn-custom">
                                <i class="bi bi-arrow-left-right me-1"></i> Movements
                            </a>
                            <button class="btn btn-success btn-sm btn-custom shadow-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#movementModal-@admission.AdmissionId">
                                <i class="bi bi-plus-circle me-2"></i>Move Patient
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Movement Modal-->
                <div class="modal fade" id="movementModal-@admission.AdmissionId" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header bg-dark text-white">
                                <h5 class="modal-title">Add Movement</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <form asp-action="SaveMovement" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="AdmissionId" value="@admission.AdmissionId" />

                                    <div class="mb-3">
                                        <label>Patient Name</label>
                                        <input type="text" class="form-control" value="@($"{admission.Patient.FirstName} {admission.Patient.LastName}")" readonly />
                                    </div>

                                    <div class="mb-3">
                                        <label>Current Location</label>
                                        <input type="text" class="form-control" value="@($"{admission.Bed?.Room?.Ward?.Name ?? "-"} / {admission.Bed?.Room?.RoomNumber ?? "-"} / {admission.Bed?.BedNumber ?? "-"}")" readonly />
                                    </div>

                                    <div class="mb-3">
                                        <label>Ward *</label>
                                        <select name="WardId" class="form-control" required>
                                            <option value="">-- Select Ward --</option>
                                            @foreach (var ward in ViewBag.Wards as IEnumerable<Wellness_Wardens_Project.Models.AdministrationSubsystem.Ward>)
                                            {
                                                if (ward.WardId != admission.Bed?.Room?.Ward?.WardId)
                                                {
                                                    <option value="@ward.WardId">@ward.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label>Room *</label>
                                        <select name="RoomId" class="form-control" required>
                                            <option value="">-- Select Room --</option>
                                            @foreach (var ward in ViewBag.Wards as IEnumerable<Wellness_Wardens_Project.Models.AdministrationSubsystem.Ward>)
                                            {
                                                foreach (var room in ward.Rooms)
                                                {
                                                    <option data-ward="@ward.WardId" value="@room.RoomId">@room.RoomNumber</option>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label>Bed *</label>
                                        <select name="BedId" class="form-control" required>
                                            <option value="">-- Select Bed --</option>
                                            @foreach (var ward in ViewBag.Wards as IEnumerable<Wellness_Wardens_Project.Models.AdministrationSubsystem.Ward>)
                                            {
                                                foreach (var room in ward.Rooms)
                                                {
                                                    foreach (var bed in room.Beds)
                                                    {
                                                        <option data-room="@room.RoomId" value="@bed.BedId">@bed.BedNumber</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label>Movement Date *</label>
                                        <input type="date" name="Date" class="form-control"
                                               value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                                    </div>

                                    <div class="mb-3">
                                        <label>Reason</label>
                                        <textarea name="Reason" class="form-control" rows="3"></textarea>
                                    </div>

                                    <div class="text-end">
                                        <button type="submit" class="btn btn-success">
                                            <i class="bi bi-check-circle me-1"></i> Save Movement
                                        </button>
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                            Cancel
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info shadow-sm text-center">
            <i class="bi bi-info-circle me-2"></i> No patients are currently admitted.
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const searchInput = document.getElementById('searchInput');
        const admissionCards = document.querySelectorAll('.admission-card-wrapper');
        const admissionsContainer = document.getElementById('admissionsContainer');

        // Search functionality
        searchInput.addEventListener('keyup', function () {
            const query = this.value.toLowerCase();
            let matchFound = false;

            admissionCards.forEach(cardWrapper => {
                const text = cardWrapper.textContent.toLowerCase();
                const isMatch = text.includes(query);
                cardWrapper.style.display = isMatch ? '' : 'none';
                if (isMatch) matchFound = true;
            });

            if (!matchFound && query.trim() !== "") {
                showToast('warning', 'No patients found matching your search.');
            }
        });

        // View mode toggle
        document.querySelectorAll('input[name="viewMode"]').forEach(radio => {
            radio.addEventListener('change', function() {
                if (this.id === 'listView') {
                    admissionsContainer.classList.remove('row', 'g-4', 'grid-view');
                    admissionsContainer.classList.add('list-view');
                    admissionsContainer.querySelectorAll('.admission-card-wrapper').forEach(item => {
                        item.classList.remove('col-md-6', 'col-lg-4');
                        item.classList.add('col-12');
                    });
                } else {
                    admissionsContainer.classList.add('row', 'g-4', 'grid-view');
                    admissionsContainer.classList.remove('list-view');
                    admissionsContainer.querySelectorAll('.admission-card-wrapper').forEach(item => {
                        item.classList.add('col-md-6', 'col-lg-4');
                        item.classList.remove('col-12');
                    });
                }
            });
        });

        // Sorting functionality
        document.querySelectorAll('.sort-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                const sortType = this.getAttribute('data-sort');
                sortAdmissions(sortType);

                // Update dropdown button text
                const dropdownButton = document.getElementById('sortDropdown');
                const icon = dropdownButton.querySelector('i');
                dropdownButton.innerHTML = icon.outerHTML + ' ' + this.textContent;
            });
        });

        function sortAdmissions(sortType) {
            const items = Array.from(admissionsContainer.querySelectorAll('.admission-card-wrapper'));

            items.sort((a, b) => {
                switch(sortType) {
                    case 'name-asc':
                        return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
                    case 'name-desc':
                        return (b.getAttribute('data-name') || '').localeCompare(a.getAttribute('data-name') || '');
                    case 'admission-desc':
                        return (b.getAttribute('data-admission') || '').localeCompare(a.getAttribute('data-admission') || '');
                    case 'admission-asc':
                        return (a.getAttribute('data-admission') || '').localeCompare(b.getAttribute('data-admission') || '');
                    case 'ward-asc':
                        return (a.getAttribute('data-ward') || '').localeCompare(b.getAttribute('data-ward') || '');
                    case 'room-asc':
                        return parseInt(a.getAttribute('data-room') || 0) - parseInt(b.getAttribute('data-room') || 0);
                    case 'bed-asc':
                        return parseInt(a.getAttribute('data-bed') || 0) - parseInt(b.getAttribute('data-bed') || 0);
                    default:
                        return 0;
                }
            });

            items.forEach(item => admissionsContainer.appendChild(item));
        }
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.modal').forEach(modal => {
                const wardSelect = modal.querySelector('select[name="WardId"]');
                const roomSelect = modal.querySelector('select[name="RoomId"]');
                const bedSelect = modal.querySelector('select[name="BedId"]');

                if (wardSelect && roomSelect && bedSelect) {
                    function filterRooms() {
                        const wardId = wardSelect.value;
                        const roomOptions = roomSelect.querySelectorAll('option');

                        roomOptions.forEach(opt => {
                            if (!opt.value) return;
                            opt.style.display = opt.dataset.ward === wardId ? '' : 'none';
                        });

                        roomSelect.value = '';
                        bedSelect.value = '';
                        filterBeds();
                    }

                    function filterBeds() {
                        const roomId = roomSelect.value;
                        const bedOptions = bedSelect.querySelectorAll('option');

                        bedOptions.forEach(opt => {
                            if (!opt.value) return;
                            opt.style.display = opt.dataset.room === roomId ? '' : 'none';
                        });

                        if (!roomId) {
                            bedSelect.value = '';
                        }
                    }

                    wardSelect.addEventListener('change', filterRooms);
                    roomSelect.addEventListener('change', filterBeds);

                    filterRooms();
                    filterBeds();
                }
            });
        });
    </script>

    <!-- Toast Notifications -->
    <script>
        function showToast(type, message) {
            if (!message) return;

            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            })

            Toast.fire({
                icon: type,
                title: message
            });
        }

        // Show success message from TempData
        var successMessage = '@Html.Raw(TempData["Success"] ?? "")';
        if (successMessage) {
            showToast('success', successMessage);
        }

        // Show error message from TempData
        var errorMessage = '@Html.Raw(TempData["Error"] ?? "")';
        if (errorMessage) {
            showToast('error', errorMessage);
        }
    </script>
}