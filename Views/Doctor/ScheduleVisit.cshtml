@model Wellness_Wardens_Project.Models.DoctorPatientSubsystem.ScheduleVisit

@{
    ViewData["Title"] = "Schedule Visit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid min-vh-100 py-4">
    <div class="row justify-content-center">
        <!-- Left Full-Body Illustration -->
        <div class="col-md-5 d-none d-md-flex align-items-center justify-content-center">
            <img src="~/images/doctor-computer.png"
                 class="img-fluid floating"
                 alt="Person sitting at computer"
                 style="max-height: 400px;">
        </div>

        <!-- Right Content - Schedule Visit Card -->
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header text-white text-center py-3"
                     style="background: linear-gradient(90deg, #198754, #20c997); border-top-left-radius: 12px; border-top-right-radius: 12px;">
                    <h3 class="mb-1"><i class="bi bi-calendar2-plus-fill me-2"></i> Schedule New Visit</h3>
                </div>
                <div class="card-body p-4">
                    <form id="scheduleVisitForm" method="post" asp-action="ScheduleVisit">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="VisitDate" class="form-label fw-bold">Visit Date</label>
                                    <input type="date" class="form-control" id="VisitDate" name="VisitDate"
                                           asp-for="VisitDate" required>
                                    <span asp-validation-for="VisitDate" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="Title" class="form-label fw-bold">Visit Title</label>
                                    <input type="text" class="form-control" id="Title" name="Title"
                                           asp-for="Title" placeholder="e.g., Patient Consultation, Ward Round" required>
                                    <span asp-validation-for="Title" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="StartTime" class="form-label fw-bold">Start Time</label>
                                    <input type="time" class="form-control" id="StartTime" name="StartTime"
                                           asp-for="StartTime" value="09:00" required>
                                    <span asp-validation-for="StartTime" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="EndTime" class="form-label fw-bold">End Time</label>
                                    <input type="time" class="form-control" id="EndTime" name="EndTime"
                                           asp-for="EndTime" value="10:00" required>
                                    <span asp-validation-for="EndTime" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Quick Schedule</label>
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button" class="btn btn-outline-primary btn-sm quick-time" data-start="09:00" data-end="10:00">
                                    9:00-10:00 AM
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm quick-time" data-start="11:00" data-end="12:00">
                                    11:00-12:00 PM
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm quick-time" data-start="14:00" data-end="15:00">
                                    2:00-3:00 PM
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm quick-time" data-start="16:00" data-end="17:00">
                                    4:00-5:00 PM
                                </button>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Doctors" asp-controller="Home" class="btn btn-outline-secondary me-md-2">
                                <i class="bi bi-arrow-left me-1"></i> Dashboard
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-calendar-check me-1"></i> Schedule Visit
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mini Calendar Modal -->
<div class="modal fade" id="miniCalendarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Date</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="miniCalendar"></div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .floating {
            animation: floating 3s ease-in-out infinite;
        }

        @@keyframes floating {
            0% {
                transform: translate(0, 0px);
            }

            50% {
                transform: translate(0, 15px);
            }

            100% {
                transform: translate(0, -0px);
            }
        }

        .min-vh-100 {
            min-height: 100vh;
        }

        .card {
            border: none;
            transition: transform 0.2s;
        }

            .card:hover {
                transform: translateY(-2px);
            }

        .quick-time:hover {
            background-color: #0d6efd;
            color: white;
        }

        #miniCalendar {
            font-size: 0.9rem;
        }

            #miniCalendar .calendar-day {
                width: 30px;
                height: 30px;
                line-height: 30px;
                border-radius: 50%;
                cursor: pointer;
                transition: all 0.2s;
            }

                #miniCalendar .calendar-day:hover {
                    background-color: #e9ecef;
                }

                #miniCalendar .calendar-day.selected {
                    background-color: #198754;
                    color: white;
                }

                #miniCalendar .calendar-day.has-events {
                    background-color: #fde2e4;
                    border: 1px solid #dc3545;
                }

        .visit-item {
            border-left: 4px solid #198754;
            background: #f8f9fa;
            transition: all 0.2s;
        }

            .visit-item:hover {
                background: #e9ecef;
                transform: translateX(5px);
            }
    </style>
}

@section Scripts {
    <script>
        // Set minimum date to today
        document.addEventListener('DOMContentLoaded', function () {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('VisitDate').min = today;

            // Quick time buttons
            document.querySelectorAll('.quick-time').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.getElementById('StartTime').value = this.dataset.start;
                    document.getElementById('EndTime').value = this.dataset.end;
                });
            });

            // Load recent visits
            loadRecentVisits();
        });

        // Quick time selection
        function setQuickTime(start, end) {
            document.getElementById('StartTime').value = start;
            document.getElementById('EndTime').value = end;
        }

        // Load recent visits from server
        async function loadRecentVisits() {
            try {
                const response = await fetch('/Doctor/GetRecentVisits');
                const visits = await response.json();
                displayRecentVisits(visits);
            } catch (error) {
                console.error('Error loading recent visits:', error);
            }
        }

        // Display recent visits
        function displayRecentVisits(visits) {
            const container = document.getElementById('recentVisits');

            if (!visits || visits.length === 0) {
                container.innerHTML = `
                    <div class="text-center text-muted py-3">
                        <i class="bi bi-calendar-x display-4"></i>
                        <p class="mt-2">No visits scheduled yet</p>
                    </div>
                `;
                return;
            }

            let html = '';
            visits.forEach(visit => {
                const visitDate = new Date(visit.visitDate).toLocaleDateString();
                html += `
                    <div class="visit-item p-3 mb-2 rounded">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1 text-success">${visit.title}</h6>
                                <small class="text-muted">${visitDate} • ${visit.startTime} - ${visit.endTime}</small>
                            </div>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteVisit(${visit.id})">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        // Delete visit function
        async function deleteVisit(visitId) {
            if (!confirm('Are you sure you want to delete this visit?')) return;

            try {
                const response = await fetch('/Doctor/DeleteVisit', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ visitId: visitId })
                });

                if (response.ok) {
                    loadRecentVisits(); // Reload the list
                }
            } catch (error) {
                console.error('Error deleting visit:', error);
            }
        }

        // Form validation
        document.getElementById('scheduleVisitForm').addEventListener('submit', function (e) {
            const startTime = document.getElementById('StartTime').value;
            const endTime = document.getElementById('EndTime').value;

            if (startTime >= endTime) {
                e.preventDefault();
                alert('End time must be after start time');
                return false;
            }
        });
    </script>

    <!-- Add these validation scripts if not already in your layout -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
}

<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // ✅ Show ModelState errors as error toasts
    @if (!ViewData.ModelState.IsValid)
    {
            foreach (var modelState in ViewData.ModelState.Values)
            {
                    foreach (var error in modelState.Errors)
                    {
                            <text>
                                Swal.fire({
                                    toast: true,
                                    position: 'top-end',
                                    icon: 'error',
                                    title: '@error.ErrorMessage',
                                    showConfirmButton: false,
                                    timer: 3000
                                });
                            </text>
                    }
            }
    }

    // ✅ Show TempData success/info/error toasts
    @if (TempData["ToastMessage"] != null)
    {
            <text>
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: '@TempData["ToastType"]',
                    title: '@TempData["ToastMessage"]',
                    showConfirmButton: false,
                    timer: 3000
                });
            </text>
    }
</script>
