@model IEnumerable<Wellness_Wardens_Project.Models.ConsumablesSubsystem.Prescription>

@{
    ViewData["Title"] = "Prescriptions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background: linear-gradient(120deg, #f0f4f8 0%, #e0e7ff 100%);
        min-height: 100vh;
    }

    .gradient-bg {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        width: 100%;
    }

    .table-card {
        background: white;
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .status-badge {
        font-size: 0.75rem;
        padding: 0.4em 0.8em;
        border-radius: 20px;
    }

    .patient-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 0.8rem;
    }

    .medication-badge {
        font-size: 0.7rem;
        max-width: 120px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .action-btn {
        border-radius: 6px;
        padding: 0.25rem 0.5rem;
        font-size: 0.7rem;
        transition: all 0.3s ease;
    }

    .btn-group-sm > .btn {
        border-radius: 6px !important;
        margin-left: 1px;
    }

    .btn-warning {
        background: linear-gradient(135deg, #ffc107, #ffb300);
        border-color: #ffc107;
        color: white;
    }

        .btn-warning:hover {
            background: linear-gradient(135deg, #ffb300, #ff8f00);
            border-color: #ffb300;
            color: white;
            transform: translateY(-1px);
        }

    .table-hover tbody tr:hover {
        background-color: rgba(102, 126, 234, 0.04);
        transform: translateY(-1px);
        transition: all 0.2s ease;
    }

    .floating-btn {
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-5px);
        }
    }

    .table th {
        border-top: none;
        font-weight: 600;
        color: #495057;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .table td {
        vertical-align: middle;
        font-size: 0.875rem;
    }
</style>

<div class="gradient-bg py-4">
    <div class="container">
        <!-- Header -->
        <div class="row align-items-center mb-4">
            <div class="col-md-8">
                <div class="d-flex align-items-center">
                    <div class="bg-primary rounded-circle p-3 me-3">
                        <i class="bi bi-capsule-pill text-white fs-4"></i>
                    </div>
                    <div>
                        <h1 class="fw-bold text-dark mb-1">Prescriptions</h1>
                        <p class="text-muted mb-0">Manage and track patient medications</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-md-end">
                <a asp-action="Doctors" asp-controller="Home" class="btn btn-outline-secondary me-md-2">
                    <i class="bi bi-arrow-left me-1"></i> Dashboard
                </a>
                <a asp-action="CreatePrescription" asp-controller="DoctorPrescription"
                   class="btn btn-primary btn-lg floating-btn">
                    <i class="bi bi-plus-circle me-2"></i>New Prescription
                </a>
            </div>
        </div>

        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <span class="fw-medium">@TempData["SuccessMessage"]</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Filters, Search and Sort -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="filter-buttons">
                    <button class="btn btn-outline-primary active me-2 mb-2" data-filter="all">All</button>
                    <button class="btn btn-outline-warning me-2 mb-2" data-filter="pending">Pending</button>
                    <button class="btn btn-outline-success me-2 mb-2" data-filter="processed">Processed</button>
                    <button class="btn btn-outline-info mb-2" data-filter="delivered">Delivered</button>
                </div>
            </div>
            <div class="col-md-4">
                <div class="input-group search-box bg-white shadow-sm">
                    <span class="input-group-text border-0 bg-transparent">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" class="form-control border-0" id="searchInput" placeholder="Search prescriptions...">
                </div>
            </div>
            <div class="col-md-4">
                <select id="sortSelect" class="form-select">
                    <option value="patient-asc">Sort by: Patient (A-Z)</option>
                    <option value="patient-desc">Sort by: Patient (Z-A)</option>
                    <option value="date-asc">Sort by: Date (Oldest First)</option>
                    <option value="date-desc">Sort by: Date (Newest First)</option>
                    <option value="status-asc">Sort by: Status (Pending First)</option>
                    <option value="status-desc">Sort by: Status (Delivered First)</option>
                    <option value="doctor-asc">Sort by: Doctor (A-Z)</option>
                    <option value="doctor-desc">Sort by: Doctor (Z-A)</option>
                </select>
            </div>
        </div>

        <!-- Prescriptions Table -->
        <div class="card table-card">
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="empty-state text-center py-5 my-4">
                        <i class="bi bi-prescription2 display-1 text-muted mb-3"></i>
                        <h4 class="text-muted mb-3">No Prescriptions Found</h4>
                        <p class="text-muted mb-4">Start by creating your first prescription for a patient.</p>
                        <a asp-action="CreatePrescription" asp-controller="DoctorPrescription"
                           class="btn btn-primary btn-lg">
                            <i class="bi bi-plus-circle me-2"></i>Create First Prescription
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover" id="prescriptionsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Patient</th>
                                    <th>Date</th>
                                    <th>Medications</th>
                                    <th>Status</th>
                                    <th>Prescribed By</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="prescriptionsTableBody">
                                @foreach (var prescription in Model)
                                {
                                    <tr class="prescription-row" data-status="@(prescription.IsProcessed ? "processed" : prescription.IsDelivered ? "delivered" : "pending")">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="patient-avatar me-2">
                                                    @prescription.Patient?.FirstName?[0]@prescription.Patient?.LastName?[0]
                                                </div>
                                                <div>
                                                    <div class="fw-bold">@prescription.Patient?.FirstName @prescription.Patient?.LastName</div>
                                                    <small class="text-muted">ID: @prescription.Patient?.IdentityNumber</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-medium">@prescription.DateWritten.ToString("MMM dd, yyyy")</div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var med in prescription.PrescriptionMedications.Take(2))
                                                {
                                                    <span class="badge bg-light text-dark border medication-badge" data-bs-toggle="tooltip" title="@med.Medication?.Name - @med.Dosage">
                                                        @med.Medication?.Name
                                                    </span>
                                                }
                                                @if (prescription.PrescriptionMedications.Count > 2)
                                                {
                                                    <span class="badge bg-light text-muted border">
                                                        +@(prescription.PrescriptionMedications.Count - 2)
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            @if (prescription.IsProcessed)
                                            {
                                                <span class="status-badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>Processed
                                                </span>
                                            }
                                            else if (prescription.IsDelivered)
                                            {
                                                <span class="status-badge bg-info text-white">
                                                    <i class="bi bi-truck me-1"></i>Delivered
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge bg-warning text-dark">
                                                    <i class="bi bi-clock me-1"></i>Pending
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                Dr. @prescription.Employee?.FirstName?[0]. @prescription.Employee?.LastName
                                            </small>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <!-- View Button -->
                                                <a asp-action="PrescriptionDetails" asp-controller="DoctorPrescription"
                                                   asp-route-id="@prescription.PrescriptionId"
                                                   class="btn btn-primary action-btn"
                                                   data-bs-toggle="tooltip" title="View Details">
                                                    <i class="bi bi-eye"></i>
                                                </a>

                                                <!-- Edit Button -->
                                                <a asp-action="EditPrescription" asp-controller="DoctorPrescription"
                                                   asp-route-id="@prescription.PrescriptionId"
                                                   class="btn btn-warning action-btn"
                                                   data-bs-toggle="tooltip" title="Edit Prescription">
                                                    <i class="bi bi-pencil"></i>
                                                </a>

                                                <!-- Delete Button -->
                                                <button type="button" class="btn btn-outline-danger action-btn delete-prescription-btn"
                                                        data-prescription-id="@prescription.PrescriptionId"
                                                        data-patient-name="@prescription.Patient?.FirstName @prescription.Patient?.LastName"
                                                        data-prescription-date="@prescription.DateWritten.ToString("MMM dd, yyyy")"
                                                        data-bs-toggle="tooltip" title="Delete Prescription">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination Container -->
                    <div class="mt-3" id="prescriptionsPagination"></div>
                }
            </div>
        </div>

        <!-- Statistics Card -->
        @if (Model.Any())
        {
            <div class="row mt-4">
                <div class="col-12">
                    <div class="card border-0 bg-white shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title mb-4 text-dark">Prescription Statistics</h5>
                            <div class="row text-center">
                                <div class="col-md-3 mb-3">
                                    <div class="border-end">
                                        <h3 class="fw-bold text-primary mb-1">@Model.Count()</h3>
                                        <small class="text-muted">Total Prescriptions</small>
                                    </div>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <div class="border-end">
                                        <h3 class="fw-bold text-warning mb-1">@Model.Count(p => !p.IsProcessed && !p.IsDelivered)</h3>
                                        <small class="text-muted">Pending</small>
                                    </div>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <div class="border-end">
                                        <h3 class="fw-bold text-info mb-1">@Model.Count(p => p.IsProcessed)</h3>
                                        <small class="text-muted">Processed</small>
                                    </div>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <h3 class="fw-bold text-success mb-1">@Model.Count(p => p.IsDelivered)</h3>
                                    <small class="text-muted">Delivered</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Search Filter -->
    <script>
        const searchInput = document.getElementById('searchInput');
        const prescriptionsTableBody = document.getElementById('prescriptionsTableBody');
        let allPrescriptionRows = Array.from(prescriptionsTableBody.querySelectorAll('.prescription-row'));
        let filteredPrescriptionRows = [...allPrescriptionRows];

        function performSearch() {
            const query = searchInput.value.toLowerCase();

            filteredPrescriptionRows = allPrescriptionRows.filter(row => {
                const patientText = row.children[0].textContent.toLowerCase();
                const dateText = row.children[1].textContent.toLowerCase();
                const medicationsText = row.children[2].textContent.toLowerCase();
                const statusText = row.children[3].textContent.toLowerCase();
                const doctorText = row.children[4].textContent.toLowerCase();
                return patientText.includes(query) || dateText.includes(query) ||
                       medicationsText.includes(query) || statusText.includes(query) ||
                       doctorText.includes(query);
            });

            displayPage(1);
        }

        searchInput.addEventListener('keyup', performSearch);
    </script>

    <!-- Sorting + Pagination -->
    <script>
        const sortSelect = document.getElementById('sortSelect');
        const rowsPerPage = 9;
        let currentPage = 1;

        function displayPage(page) {
            currentPage = page;
            const start = (page - 1) * rowsPerPage;
            const end = start + rowsPerPage;

            // Hide all rows first
            allPrescriptionRows.forEach(row => row.style.display = 'none');

            // Show only filtered rows for current page
            filteredPrescriptionRows.forEach((prescriptionRow, index) => {
                if (index >= start && index < end) {
                    prescriptionRow.style.display = '';
                }
            });

            renderPagination();
        }

        function renderPagination() {
            const paginationContainer = document.getElementById('prescriptionsPagination');
            paginationContainer.innerHTML = '';
            const totalPages = Math.ceil(filteredPrescriptionRows.length / rowsPerPage);

            if (totalPages > 1) {
                // Previous button
                if (currentPage > 1) {
                    const prevBtn = document.createElement('button');
                    prevBtn.className = 'btn btn-sm btn-outline-primary me-1';
                    prevBtn.innerHTML = '<i class="bi bi-chevron-left"></i>';
                    prevBtn.addEventListener('click', () => displayPage(currentPage - 1));
                    paginationContainer.appendChild(prevBtn);
                }

                // Page buttons
                for (let i = 1; i <= totalPages; i++) {
                    const btn = document.createElement('button');
                    btn.className = 'btn btn-sm me-1 ' + (i === currentPage ? 'btn-primary' : 'btn-outline-primary');
                    btn.innerText = i;
                    btn.addEventListener('click', () => displayPage(i));
                    paginationContainer.appendChild(btn);
                }

                // Next button
                if (currentPage < totalPages) {
                    const nextBtn = document.createElement('button');
                    nextBtn.className = 'btn btn-sm btn-outline-primary me-1';
                    nextBtn.innerHTML = '<i class="bi bi-chevron-right"></i>';
                    nextBtn.addEventListener('click', () => displayPage(currentPage + 1));
                    paginationContainer.appendChild(nextBtn);
                }
            }
        }

        function sortTable(sortValue) {
            const [column, direction] = sortValue.split('-');
            const isAsc = direction === 'asc';

            filteredPrescriptionRows.sort((a, b) => {
                let aValue, bValue;

                switch (column) {
                    case 'patient':
                        aValue = a.children[0].textContent.trim().toLowerCase();
                        bValue = b.children[0].textContent.trim().toLowerCase();
                        break;
                    case 'date':
                        // Parse date for proper sorting (assuming format: "MMM dd, yyyy")
                        aValue = new Date(a.children[1].textContent.trim());
                        bValue = new Date(b.children[1].textContent.trim());
                        break;
                    case 'status':
                        // Status priority: Pending (1), Processed (2), Delivered (3)
                        const statusPriority = {
                            'pending': 1,
                            'processed': 2,
                            'delivered': 3
                        };
                        aValue = statusPriority[a.getAttribute('data-status')] || 0;
                        bValue = statusPriority[b.getAttribute('data-status')] || 0;
                        break;
                    case 'doctor':
                        aValue = a.children[4].textContent.trim().toLowerCase();
                        bValue = b.children[4].textContent.trim().toLowerCase();
                        break;
                    default:
                        aValue = a.children[0].textContent.trim().toLowerCase();
                        bValue = b.children[0].textContent.trim().toLowerCase();
                }

                if (aValue < bValue) return isAsc ? -1 : 1;
                if (aValue > bValue) return isAsc ? 1 : -1;
                return 0;
            });

            // Reorder DOM elements
            filteredPrescriptionRows.forEach(prescriptionRow => {
                prescriptionsTableBody.appendChild(prescriptionRow);
            });

            displayPage(1);
        }

        // Initialize sort dropdown
        sortSelect.addEventListener('change', function() {
            sortTable(this.value);
        });

        // Initialize display
        sortTable('date-desc');
        displayPage(1);
    </script>

    <!-- Existing JavaScript Functions -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Filter functionality
            const filterButtons = document.querySelectorAll('.filter-buttons .btn');

            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    // Remove active class from all buttons
                    filterButtons.forEach(btn => btn.classList.remove('active', 'btn-primary'));
                    filterButtons.forEach(btn => btn.classList.add('btn-outline-primary'));

                    // Add active class to clicked button
                    this.classList.remove('btn-outline-primary');
                    this.classList.add('active', 'btn-primary');

                    const filter = this.getAttribute('data-filter');

                    filteredPrescriptionRows = allPrescriptionRows.filter(row => {
                        return filter === 'all' || row.getAttribute('data-status') === filter;
                    });

                    displayPage(1);
                });
            });
        });

        // Delete Prescription with SweetAlert
        document.addEventListener('DOMContentLoaded', function() {
            // Handle delete button clicks
            document.querySelectorAll('.delete-prescription-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const prescriptionId = this.getAttribute('data-prescription-id');
                    const patientName = this.getAttribute('data-patient-name');
                    const prescriptionDate = this.getAttribute('data-prescription-date');

                    Swal.fire({
                        title: 'Are you sure?',
                        html: `You are about to delete the prescription for:<br>
                              <strong>${patientName}</strong><br>
                              from <strong>${prescriptionDate}</strong>`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#3085d6',
                        confirmButtonText: 'Yes, delete it!',
                        cancelButtonText: 'Cancel',
                        reverseButtons: true,
                        customClass: {
                            confirmButton: 'btn btn-danger',
                            cancelButton: 'btn btn-secondary'
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Create form for anti-forgery token
                            const form = document.createElement('form');
                            form.method = 'POST';
                            form.action = `/DoctorPrescription/DeletePrescription/${prescriptionId}`;

                            // Add anti-forgery token
                            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                            const tokenInput = document.createElement('input');
                            tokenInput.type = 'hidden';
                            tokenInput.name = '__RequestVerificationToken';
                            tokenInput.value = token;
                            form.appendChild(tokenInput);

                            // Submit the form
                            document.body.appendChild(form);
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
}