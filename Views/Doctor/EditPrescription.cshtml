@model Wellness_Wardens_Project.Models.ConsumablesSubsystem.Prescription

@{
    ViewData["Title"] = "Edit Prescription";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background: linear-gradient(120deg, #f0f4f8 0%, #e0e7ff 100%);
        min-height: 100vh;
    }

    .gradient-bg {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        width: 100%;
    }

    .prescription-card {
        background: white;
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        border-left: 4px solid #ffc107;
    }

    .medication-row {
        border-bottom: 1px solid #e9ecef;
        padding-bottom: 1rem;
        margin-bottom: 1rem;
    }

        .medication-row:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }

    .remove-medication {
        transition: all 0.3s ease;
    }

        .remove-medication:hover {
            transform: scale(1.1);
        }

    .btn-warning {
        background: linear-gradient(135deg, #ffc107, #ffb300);
        border-color: #ffc107;
        color: white;
    }

        .btn-warning:hover {
            background: linear-gradient(135deg, #ffb300, #ff8f00);
            border-color: #ffb300;
            color: white;
            transform: translateY(-1px);
        }
</style>

<div class="gradient-bg py-4">
    <div class="container">
        <!-- Header -->
        <div class="row align-items-center mb-4">
            <div class="col-md-8">
                <div class="d-flex align-items-center">
                    <div class="bg-warning rounded-circle p-3 me-3">
                        <i class="bi bi-pencil-square text-white fs-4"></i>
                    </div>
                    <div>
                        <h1 class="fw-bold text-dark mb-1">Edit Prescription</h1>
                        <p class="text-muted mb-0">Update prescription details and medications</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-md-end">
                <a asp-action="Prescriptions" asp-controller="DoctorPrescription" class="btn btn-outline-secondary me-md-2">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>
        </div>

        <!-- Success/Error Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <span class="fw-medium">@TempData["SuccessMessage"]</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <span class="fw-medium">@TempData["ErrorMessage"]</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Prescription Form -->
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card prescription-card">
                    <div class="card-body p-4">
                        <form asp-action="EditPrescription" asp-controller="DoctorPrescription" asp-route-id="@Model.PrescriptionId" method="post" id="prescriptionForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="PrescriptionId" value="@Model.PrescriptionId" />

                            <!-- Patient Information -->
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label fw-bold text-dark">
                                            <i class="bi bi-person me-2"></i>Patient *
                                        </label>
                                        <select name="PatientId" class="form-select" required>
                                            <option value="">-- Select Patient --</option>
                                            @if (ViewBag.Patients != null)
                                            {
                                                @foreach (var patient in ViewBag.Patients)
                                                {
                                                    <option value="@patient.PatientId" selected="@(patient.PatientId == Model.PatientId)">
                                                        @patient.FirstName @patient.LastName
                                                    </option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label fw-bold text-dark">
                                            <i class="bi bi-calendar me-2"></i>Date Written *
                                        </label>
                                        <input name="DateWritten" class="form-control"
                                               type="text"
                                               value="@Model.DateWritten.ToString("yyyy-MM-dd")"
                                               placeholder="YYYY-MM-DD"
                                               required />
                                        <small class="form-text text-muted">Format: YYYY-MM-DD</small>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-4">

                            <!-- Medications Section -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h5 class="fw-bold text-danger mb-3">
                                        <i class="bi bi-capsule me-2"></i>Medications
                                    </h5>
                                    <p class="text-muted mb-3">Add or update medications for this prescription</p>

                                    <div id="medicationsContainer">
                                        @{
                                            var medicationIndex = 0;
                                            foreach (var med in Model.PrescriptionMedications)
                                            {
                                                <div class="medication-row border-bottom pb-3 mb-3">
                                                    <div class="row g-2">
                                                        <div class="col-md-6">
                                                            <label class="form-label fw-bold text-dark">Medication *</label>
                                                            <select name="selectedMedications[@medicationIndex]" class="form-select" required>
                                                                <option value="">-- Select Medication --</option>
                                                                @if (ViewBag.Medications != null)
                                                                {
                                                                    @foreach (var medication in ViewBag.Medications)
                                                                    {
                                                                        <option value="@medication.MedicationId" selected="@(medication.MedicationId == med.MedicationId)">
                                                                            @medication.Name
                                                                        </option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label fw-bold text-dark">Dosage</label>
                                                            <input type="text" name="dosages[@medicationIndex]" class="form-control"
                                                                   value="@med.Dosage" placeholder="e.g., 500mg twice daily">
                                                        </div>
                                                        <div class="col-md-2">
                                                            <label class="form-label fw-bold text-dark">&nbsp;</label>
                                                            <button type="button" class="btn btn-outline-danger btn-sm w-100 remove-medication" data-bs-toggle="tooltip" title="Remove Medication">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                                medicationIndex++;
                                            }
                                        }
                                    </div>

                                    <button type="button" id="addMedication" class="btn btn-outline-primary btn-sm mt-2">
                                        <i class="bi bi-plus-circle me-1"></i>Add Medication
                                    </button>
                                </div>
                            </div>

                            <!-- Form Actions -->
                            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                                <a asp-action="PrescriptionDetails" asp-controller="DoctorPrescription" asp-route-id="@Model.PrescriptionId" class="btn btn-outline-secondary">
                                    <i class="bi bi-x-circle me-1"></i>Cancel
                                </a>
                                <button type="submit" class="btn btn-warning text-white">
                                    <i class="bi bi-check-circle me-1"></i>Update Prescription
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Help Text -->
        <div class="row justify-content-center mt-3">
            <div class="col-lg-10">
                <div class="alert alert-info border-0 rounded-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-info-circle me-2 fs-5"></i>
                        <div>
                            <strong>Note:</strong> All changes will be recorded with a timestamp. Make sure to review all medication details before updating.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let medicationCounter = @Model.PrescriptionMedications.Count;

        // Add medication row
        document.getElementById('addMedication').addEventListener('click', function () {
            const container = document.getElementById('medicationsContainer');
            const index = medicationCounter++;

            const medicationRow = `
                <div class="medication-row border-bottom pb-3 mb-3">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark">Medication *</label>
                            <select name="selectedMedications[${index}]" class="form-select" required>
                                <option value="">-- Select Medication --</option>
                                @if (ViewBag.Medications != null)
                                {
                                        @foreach (var med in ViewBag.Medications)
                                        {
                                                <option value="@med.MedicationId">@med.Name</option>
                                        }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-dark">Dosage</label>
                            <input type="text" name="dosages[${index}]" class="form-control" placeholder="e.g., 500mg twice daily">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold text-dark">&nbsp;</label>
                            <button type="button" class="btn btn-outline-danger btn-sm w-100 remove-medication" data-bs-toggle="tooltip" title="Remove Medication">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', medicationRow);

            // Initialize tooltip for the new remove button
            new bootstrap.Tooltip(container.lastElementChild.querySelector('.remove-medication'));
        });

        // Remove medication row
        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('remove-medication') || e.target.closest('.remove-medication')) {
                const button = e.target.classList.contains('remove-medication') ? e.target : e.target.closest('.remove-medication');
                button.closest('.medication-row').remove();
            }
        });

        // Initialize form
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Set selected patient
            const patientId = '@Model.PatientId';
            if (patientId) {
                const patientSelect = document.querySelector('select[name="PatientId"]');
                if (patientSelect) {
                    patientSelect.value = patientId;
                }
            }
        });
    </script>
}