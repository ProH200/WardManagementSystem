@model IEnumerable<Wellness_Wardens_Project.Models.PatientManagementSubsystem.VisitNote>

@{
    ViewData["Title"] = "Visit Notes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background: linear-gradient(120deg, #f0f4f8 0%, #e0e7ff 100%);
        min-height: 100vh;
    }

    .visit-table-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        margin-top: 1rem;
    }

        .visit-table-card table {
            margin-bottom: 0;
        }

        .visit-table-card th, .visit-table-card td {
            vertical-align: middle !important;
        }

        .visit-table-card th {
            background-color: #0d6efd; /* Bootstrap primary */
            color: white;
            font-weight: 600;
            border: none !important;
        }

        .visit-table-card tbody tr:hover {
            background-color: #e7f1ff;
            transition: background-color 0.2s ease-in-out;
        }

    .patient-name {
        font-weight: 600;
    }

    .search-box {
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        padding: 0.5rem 1rem;
        margin-bottom: 1rem;
        width: 100%;
    }

    .action-btn {
        border-radius: 12px;
        padding: 0.3rem 0.6rem;
        font-size: 0.8rem;
    }

    .btn-group-sm > .btn {
        border-radius: 8px;
        margin: 0 2px;
    }
</style>

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-primary">
                <i class="bi bi-journal-text me-2"></i>Visit Notes
            </h2>
            <p class="text-muted mb-0">Manage and review patient visit notes.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Doctors" asp-controller="Home" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
            <a asp-action="CreateVisitNote" asp-controller="DoctorVisit" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>New Visit Note
            </a>
        </div>
    </div>

    <!-- Search and Sort -->
    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" class="search-box" placeholder="Search visit notes..." id="searchInput">
        </div>
        <div class="col-md-4">
            <select id="sortSelect" class="form-select">
                <option value="patient-asc">Sort by: Patient (A-Z)</option>
                <option value="patient-desc">Sort by: Patient (Z-A)</option>
                <option value="visitdate-asc">Sort by: Visit Date (Oldest First)</option>
                <option value="visitdate-desc">Sort by: Visit Date (Newest First)</option>
                <option value="created-asc">Sort by: Created (Oldest First)</option>
                <option value="created-desc">Sort by: Created (Newest First)</option>
            </select>
        </div>
    </div>

    <div class="visit-table-card">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-journal-x display-4 text-muted mb-3"></i>
                <h5 class="text-muted">No Visit Notes Yet</h5>
                <p class="text-muted">Start by creating your first visit note.</p>
                <a asp-action="CreateVisitNote" asp-controller="DoctorVisit" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>Create First Note
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Visit Date</th>
                            <th>Assessment</th>
                            <th>Created</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="visitNotesTableBody">
                        @foreach (var note in Model)
                        {
                            <tr class="visitnote-row">
                                <td class="patient-name">
                                    @note.Patient?.FirstName @note.Patient?.LastName <br />
                                    <small class="text-muted">ID: @note.Patient.IdentityNumber</small>
                                </td>
                                <td>@note.VisitDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (note.Assessment.Length > 50)
                                    {
                                        @note.Assessment.Substring(0, 50)
                                        <text>...</text>
                                    }
                                    else
                                    {
                                        @note.Assessment
                                    }
                                </td>
                                <td>@note.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <!-- View Button -->
                                        <a asp-action="VisitNoteDetails" asp-controller="DoctorVisit"
                                           asp-route-id="@note.VisitNoteId"
                                           class="btn btn-outline-primary action-btn"
                                           data-bs-toggle="tooltip" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <!-- Edit Button -->
                                        <a asp-action="EditVisitNote" asp-controller="DoctorVisit"
                                           asp-route-id="@note.VisitNoteId"
                                           class="btn btn-outline-warning action-btn"
                                           data-bs-toggle="tooltip" title="Edit Note">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <!-- Delete Button with SweetAlert -->
                                        <button type="button" class="btn btn-outline-danger action-btn delete-visitnote-btn"
                                                data-visitnote-id="@note.VisitNoteId"
                                                data-patient-name="@note.Patient?.FirstName @note.Patient?.LastName"
                                                data-visit-date="@note.VisitDate.ToString("MMM dd, yyyy")"
                                                data-bs-toggle="tooltip" title="Delete Note">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Container -->
            <div class="mt-3" id="visitNotesPagination"></div>
        }
    </div>
</div>

<!-- Hidden form for delete operations -->
<form id="deleteVisitNoteForm" asp-action="DeleteVisitNote" asp-controller="DoctorVisit" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteVisitNoteId" />
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Search Filter -->
    <script>
        const searchInput = document.getElementById('searchInput');
        const visitNotesTableBody = document.getElementById('visitNotesTableBody');
        let allVisitNoteRows = Array.from(visitNotesTableBody.querySelectorAll('.visitnote-row'));
        let filteredVisitNoteRows = [...allVisitNoteRows];

        function performSearch() {
            const query = searchInput.value.toLowerCase();

            filteredVisitNoteRows = allVisitNoteRows.filter(row => {
                const patientText = row.children[0].textContent.toLowerCase();
                const visitDateText = row.children[1].textContent.toLowerCase();
                const assessmentText = row.children[2].textContent.toLowerCase();
                const createdText = row.children[3].textContent.toLowerCase();
                return patientText.includes(query) || visitDateText.includes(query) ||
                       assessmentText.includes(query) || createdText.includes(query);
            });

            displayPage(1);
        }

        searchInput.addEventListener('keyup', performSearch);
    </script>

    <!-- Sorting + Pagination -->
    <script>
        const sortSelect = document.getElementById('sortSelect');
        const rowsPerPage = 9;
        let currentPage = 1;

        function displayPage(page) {
            currentPage = page;
            const start = (page - 1) * rowsPerPage;
            const end = start + rowsPerPage;

            // Hide all rows first
            allVisitNoteRows.forEach(row => row.style.display = 'none');

            // Show only filtered rows for current page
            filteredVisitNoteRows.forEach((visitNoteRow, index) => {
                if (index >= start && index < end) {
                    visitNoteRow.style.display = '';
                }
            });

            renderPagination();
        }

        function renderPagination() {
            const paginationContainer = document.getElementById('visitNotesPagination');
            paginationContainer.innerHTML = '';
            const totalPages = Math.ceil(filteredVisitNoteRows.length / rowsPerPage);

            if (totalPages > 1) {
                // Previous button
                if (currentPage > 1) {
                    const prevBtn = document.createElement('button');
                    prevBtn.className = 'btn btn-sm btn-outline-primary me-1';
                    prevBtn.innerHTML = '<i class="bi bi-chevron-left"></i>';
                    prevBtn.addEventListener('click', () => displayPage(currentPage - 1));
                    paginationContainer.appendChild(prevBtn);
                }

                // Page buttons
                for (let i = 1; i <= totalPages; i++) {
                    const btn = document.createElement('button');
                    btn.className = 'btn btn-sm me-1 ' + (i === currentPage ? 'btn-primary' : 'btn-outline-primary');
                    btn.innerText = i;
                    btn.addEventListener('click', () => displayPage(i));
                    paginationContainer.appendChild(btn);
                }

                // Next button
                if (currentPage < totalPages) {
                    const nextBtn = document.createElement('button');
                    nextBtn.className = 'btn btn-sm btn-outline-primary me-1';
                    nextBtn.innerHTML = '<i class="bi bi-chevron-right"></i>';
                    nextBtn.addEventListener('click', () => displayPage(currentPage + 1));
                    paginationContainer.appendChild(nextBtn);
                }
            }
        }

        function sortTable(sortValue) {
            const [column, direction] = sortValue.split('-');
            const isAsc = direction === 'asc';

            filteredVisitNoteRows.sort((a, b) => {
                let aValue, bValue;

                switch (column) {
                    case 'patient':
                        aValue = a.children[0].textContent.trim().toLowerCase();
                        bValue = b.children[0].textContent.trim().toLowerCase();
                        break;
                    case 'visitdate':
                        // Parse date for proper sorting (assuming format: "dd MMM yyyy")
                        aValue = new Date(a.children[1].textContent.trim());
                        bValue = new Date(b.children[1].textContent.trim());
                        break;
                    case 'created':
                        // Parse date for proper sorting (assuming format: "dd MMM yyyy")
                        aValue = new Date(a.children[3].textContent.trim());
                        bValue = new Date(b.children[3].textContent.trim());
                        break;
                    default:
                        aValue = a.children[0].textContent.trim().toLowerCase();
                        bValue = b.children[0].textContent.trim().toLowerCase();
                }

                if (aValue < bValue) return isAsc ? -1 : 1;
                if (aValue > bValue) return isAsc ? 1 : -1;
                return 0;
            });

            // Reorder DOM elements
            filteredVisitNoteRows.forEach(visitNoteRow => {
                visitNotesTableBody.appendChild(visitNoteRow);
            });

            displayPage(1);
        }

        // Initialize sort dropdown
        sortSelect.addEventListener('change', function() {
            sortTable(this.value);
        });

        // Initialize display
        sortTable('visitdate-desc');
        displayPage(1);
    </script>

    <!-- Existing JavaScript Functions -->
    <script>
        // Function to show success toast
        function showSuccessToast(message) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: message,
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                customClass: {
                    popup: 'colored-toast'
                },
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });
        }

        // Function to show error toast
        function showErrorToast(message) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: message,
                showConfirmButton: false,
                timer: 4000,
                timerProgressBar: true,
                customClass: {
                    popup: 'colored-toast'
                },
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });
        }

        function setupDeleteButtons() {
            document.querySelectorAll('.delete-visitnote-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const visitNoteId = this.getAttribute('data-visitnote-id');
                    const patientName = this.getAttribute('data-patient-name');
                    const visitDate = this.getAttribute('data-visit-date');

                    const visitNoteTitle = `${patientName} - ${visitDate}`;

                    Swal.fire({
                        title: 'Are you sure?',
                        html: `You are about to delete the visit note for:<br><strong>"${visitNoteTitle}"</strong><br><br>This action cannot be undone.`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#3085d6',
                        confirmButtonText: 'Yes, delete it!',
                        cancelButtonText: 'Cancel',
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Set the ID and submit the hidden form
                            document.getElementById('deleteVisitNoteId').value = visitNoteId;
                            document.getElementById('deleteVisitNoteForm').submit();
                        }
                    });
                });
            });
        }

        // Initialize tooltips
        function initializeTooltips() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        }

        // Check for TempData messages on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize tooltips
            initializeTooltips();

            // Setup delete buttons
            setupDeleteButtons();

            // Check for server-side TempData messages
            @if (TempData["SuccessMessage"] != null)
            {
                    <text>showSuccessToast('@TempData["SuccessMessage"]');</text>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                    <text>showErrorToast('@TempData["ErrorMessage"]');</text>
            }
        });
    </script>
}