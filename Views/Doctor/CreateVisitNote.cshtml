@model Wellness_Wardens_Project.Models.PatientManagementSubsystem.VisitNote

@{
    ViewData["Title"] = "Create Visit Note";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Custom Styles -->
<style>
    .soap-section {
        border-left: 4px solid;
        padding-left: 1rem;
        margin-bottom: 2rem;
        background: #f8f9fa;
        border-radius: 0 0.375rem 0.375rem 0;
        transition: all 0.3s ease;
    }

        .soap-section:hover {
            background: #f1f3f4;
            transform: translateX(2px);
        }

    .soap-section-s {
        border-color: #0dcaf0;
    }

    .soap-section-o {
        border-color: #198754;
    }

    .soap-section-a {
        border-color: #ffc107;
    }

    .soap-section-p {
        border-color: #0d6efd;
    }

    .section-icon {
        font-size: 1.1rem;
        margin-right: 0.5rem;
    }

    .character-count {
        font-size: 0.875rem;
        text-align: right;
        color: #6c757d;
    }

    .form-label {
        display: flex;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .card {
        border: none;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }

    .breadcrumb {
        background: transparent;
        padding: 0;
    }

    .btn-primary {
        background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);
        border: none;
        padding: 0.5rem 1.5rem;
        font-weight: 500;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #0b5ed7 0%, #0baccc 100%);
            transform: translateY(-1px);
        }

    .btn-outline-secondary {
        padding: 0.5rem 1.5rem;
    }

    .form-control:focus {
        border-color: #0dcaf0;
        box-shadow: 0 0 0 0.2rem rgba(13, 202, 240, 0.25);
    }

    .form-select:focus {
        border-color: #0dcaf0;
        box-shadow: 0 0 0 0.2rem rgba(13, 202, 240, 0.25);
    }
</style>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            <!-- Header Section -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold text-primary mb-2">
                        <i class="bi bi-journal-plus me-2"></i>Create Clinical Visit Note
                    </h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-action="RecordVisits" asp-controller="DoctorVisit" class="text-decoration-none">Visit Notes</a></li>
                            <li class="breadcrumb-item active text-muted">Create New Note</li>
                        </ol>
                    </nav>
                </div>
                <a asp-action="RecordVisits" asp-controller="DoctorVisit" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Back to List
                </a>
            </div>

            <!-- Main Form Card -->
            <div class="card shadow-lg border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 text-dark">
                        <i class="bi bi-clipboard2-pulse me-2 text-primary"></i>
                        SOAP Note Documentation
                    </h5>
                    <p class="text-muted mb-0 small">Complete all sections for comprehensive patient documentation</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="CreateVisitNote" asp-controller="DoctorVisit" method="post" id="visitNoteForm">
                        <!-- Patient Information Section -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="PatientId" class="form-label fw-bold text-dark">
                                        <i class="bi bi-person me-1"></i>Select Patient
                                    </label>
                                    <select asp-for="PatientId" class="form-select" required>
                                        <option value="">-- Select Patient --</option>
                                        @foreach (var patient in ViewBag.Patients)
                                        {
                                            <option value="@patient.PatientId">@patient.FirstName @patient.LastName (ID: @patient.PatientId)</option>
                                        }
                                    </select>
                                    <span asp-validation-for="PatientId" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="VisitDate" class="form-label fw-bold text-dark">
                                        <i class="bi bi-calendar-event me-1"></i>Visit Date & Time
                                    </label>
                                    <input asp-for="VisitDate" class="form-control" type="datetime-local" required />
                                    <span asp-validation-for="VisitDate" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- SOAP Documentation Sections -->
                        <h5 class="mb-3 text-dark fw-bold">
                            <i class="bi bi-clipboard2-check me-2"></i>
                            Clinical Documentation
                        </h5>

                        <!-- Subjective Section -->
                        <div class="soap-section soap-section-s p-3">
                            <label asp-for="Subjective" class="form-label fw-bold text-info">
                                <i class="bi bi-chat-left-text section-icon"></i>Subjective (S)
                            </label>
                            <small class="form-text text-muted d-block mb-2">
                                Patient's complaints, symptoms, medical history, and personal narrative
                            </small>
                            <textarea asp-for="Subjective" class="form-control" rows="5"
                                      placeholder="Describe patient complaints, symptom history, relevant medical/social/family history, medications, allergies..."
                                      required></textarea>
                            <div class="character-count mt-1">
                                <span id="subjectiveCount">0</span> characters
                            </div>
                            <span asp-validation-for="Subjective" class="text-danger small"></span>
                        </div>

                        <!-- Objective Section -->
                        <div class="soap-section soap-section-o p-3">
                            <label asp-for="Objective" class="form-label fw-bold text-success">
                                <i class="bi bi-clipboard-data section-icon"></i>Objective (O)
                            </label>
                            <small class="form-text text-muted d-block mb-2">
                                Measurable data, observations, vital signs, physical exam findings, test results
                            </small>
                            <textarea asp-for="Objective" class="form-control" rows="5"
                                      placeholder="Record vital signs, physical exam findings, laboratory results, diagnostic imaging, objective observations..."
                                      required></textarea>
                            <div class="character-count mt-1">
                                <span id="objectiveCount">0</span> characters
                            </div>
                            <span asp-validation-for="Objective" class="text-danger small"></span>
                        </div>

                        <!-- Assessment Section -->
                        <div class="soap-section soap-section-a p-3">
                            <label asp-for="Assessment" class="form-label fw-bold text-warning">
                                <i class="bi bi-clipboard-check section-icon"></i>Assessment (A)
                            </label>
                            <small class="form-text text-muted d-block mb-2">
                                Clinical diagnosis, differential diagnosis, problem analysis, and assessment
                            </small>
                            <textarea asp-for="Assessment" class="form-control" rows="4"
                                      placeholder="Provide diagnosis, clinical reasoning, differential diagnoses, problem list, severity assessment..."
                                      required></textarea>
                            <div class="character-count mt-1">
                                <span id="assessmentCount">0</span> characters
                            </div>
                            <span asp-validation-for="Assessment" class="text-danger small"></span>
                        </div>

                        <!-- Plan Section -->
                        <div class="soap-section soap-section-p p-3">
                            <label asp-for="Plan" class="form-label fw-bold text-primary">
                                <i class="bi bi-calendar-check section-icon"></i>Plan (P)
                            </label>
                            <small class="form-text text-muted d-block mb-2">
                                Treatment plan, medications, therapies, referrals, follow-up, and patient education
                            </small>
                            <textarea asp-for="Plan" class="form-control" rows="4"
                                      placeholder="Outline treatment plan, medications prescribed, therapies, referrals, follow-up appointments, patient education..."
                                      required></textarea>
                            <div class="character-count mt-1">
                                <span id="planCount">0</span> characters
                            </div>
                            <span asp-validation-for="Plan" class="text-danger small"></span>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="RecordVisits" asp-controller="DoctorVisit" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i>Save Visit Note
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Help Text -->
            <div class="mt-3">
                <p class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i>
                    Ensure all SOAP sections are completed thoroughly for comprehensive patient care documentation.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Character count functionality
        document.addEventListener('DOMContentLoaded', function() {
            const textareas = ['Subjective', 'Objective', 'Assessment', 'Plan'];

            textareas.forEach(field => {
                const textarea = document.getElementById(field);
                const counter = document.getElementById(field.toLowerCase() + 'Count');

                if (textarea && counter) {
                    // Initial count
                    counter.textContent = textarea.value.length;

                    // Update on input
                    textarea.addEventListener('input', function() {
                        counter.textContent = this.value.length;
                    });
                }
            });

            // Form validation enhancement
            const form = document.getElementById('visitNoteForm');
            form.addEventListener('submit', function(e) {
                const emptyFields = [];
                textareas.forEach(field => {
                    const textarea = document.getElementById(field);
                    if (textarea && textarea.value.trim().length < 10) {
                        emptyFields.push(field);
                    }
                });

                if (emptyFields.length > 0) {
                    e.preventDefault();
                    alert('Please provide more detailed information in: ' + emptyFields.join(', '));
                }
            });
        });
    </script>
}