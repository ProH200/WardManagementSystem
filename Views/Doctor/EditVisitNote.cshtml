<form asp-action="EditVisitNote" asp-controller="DoctorVisit" asp-route-id="@Model.VisitNoteId" method="post" id="visitNoteForm">
    @Html.AntiForgeryToken()

    <!-- Add this hidden field for VisitNoteId -->
    <input type="hidden" name="VisitNoteId" value="@Model.VisitNoteId" />

    <!-- Patient Information Section -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="form-group">
                <label class="form-label fw-bold text-dark">
                    <i class="bi bi-person me-1"></i>Select Patient
                </label>
                <select name="PatientId" class="form-select" required>
                    <option value="">-- Select Patient --</option>
                    @foreach (var patient in ViewBag.Patients)
                    {
                        <option value="@patient.PatientId">@patient.FirstName @patient.LastName</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="form-label fw-bold text-dark">
                    <i class="bi bi-calendar-event me-1"></i>Visit Date & Time
                </label>
                <input name="VisitDate" class="form-control" type="datetime-local"
                       value="@Model.VisitDate.ToString("yyyy-MM-ddTHH:mm")" required />
            </div>
        </div>
    </div>

    <!-- SOAP Documentation Sections -->
    <!-- Subjective Section -->
    <div class="soap-section soap-section-s p-3">
        <label class="form-label fw-bold text-info">
            <i class="bi bi-chat-left-text section-icon"></i>Subjective (S)
        </label>
        <textarea name="Subjective" class="form-control" rows="5" required>@Model.Subjective</textarea>
    </div>

    <!-- Objective Section -->
    <div class="soap-section soap-section-o p-3">
        <label class="form-label fw-bold text-success">
            <i class="bi bi-clipboard-data section-icon"></i>Objective (O)
        </label>
        <textarea name="Objective" class="form-control" rows="5" required>@Model.Objective</textarea>
    </div>

    <!-- Assessment Section -->
    <div class="soap-section soap-section-a p-3">
        <label class="form-label fw-bold text-warning">
            <i class="bi bi-clipboard-check section-icon"></i>Assessment (A)
        </label>
        <textarea name="Assessment" class="form-control" rows="4" required>@Model.Assessment</textarea>
    </div>

    <!-- Plan Section -->
    <div class="soap-section soap-section-p p-3">
        <label class="form-label fw-bold text-primary">
            <i class="bi bi-calendar-check section-icon"></i>Plan (P)
        </label>
        <textarea name="Plan" class="form-control" rows="4" required>@Model.Plan</textarea>
    </div>

    <!-- Form Actions -->
    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
        <a asp-action="VisitNoteDetails" asp-controller="DoctorVisit" asp-route-id="@Model.VisitNoteId" class="btn btn-outline-secondary">
            <i class="bi bi-x-circle me-1"></i>Cancel
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle me-1"></i>Update Visit Note
        </button>
    </div>
</form>