@model IEnumerable<Wellness_Wardens_Project.Models.PatientManagementSubsystem.PatientAdmission>

@{
    ViewData["Title"] = "Discharge Patients";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="fw-bold text-primary">
                <i class="bi bi-box-arrow-right me-2"></i>Discharge Patients
            </h2>
            <p class="text-muted mb-0">Discharge recovered patients and free up beds.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="DischargeHistory" asp-controller="DoctorDischarge" class="btn btn-outline-primary">
                <i class="bi bi-clock-history me-1"></i>Discharge History
            </a>
            <a asp-action="Doctors" asp-controller="Home" class="btn btn-primary">
                <i class="bi bi-house me-1"></i>Dashboard
            </a>
        </div>
    </div>

    <!-- Search and Sort -->
    @if (Model.Any())
    {
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" id="patientSearch" class="form-control" placeholder="Search patients by name, ID, reason, or ward...">
                </div>
            </div>
            <div class="col-md-4">
                <select id="sortSelect" class="form-select">
                    <option value="patient-asc">Sort by: Patient (A-Z)</option>
                    <option value="patient-desc">Sort by: Patient (Z-A)</option>
                    <option value="date-asc">Sort by: Admission Date (Oldest First)</option>
                    <option value="date-desc">Sort by: Admission Date (Newest First)</option>
                    <option value="days-asc">Sort by: Days Admitted (Low to High)</option>
                    <option value="days-desc">Sort by: Days Admitted (High to Low)</option>
                    <option value="ward-asc">Sort by: Ward (A-Z)</option>
                    <option value="ward-desc">Sort by: Ward (Z-A)</option>
                    <option value="room-asc">Sort by: Room (A-Z)</option>
                    <option value="room-desc">Sort by: Room (Z-A)</option>
                </select>
            </div>
        </div>
    }

    <!-- Patients List -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-check display-4 text-muted mb-3"></i>
                    <h5 class="text-muted">No Patients to Discharge</h5>
                    <p class="text-muted">All your assigned patients have been discharged or there are no current admissions.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-primary">
                            <tr>
                                <th>Patient</th>
                                <th>Admission Date</th>
                                <th>Reason</th>
                                <th>Ward</th>
                                <th>Room</th>
                                <th>Bed</th>
                                <th>Days Admitted</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="patientsTableBody">
                            @foreach (var admission in Model)
                            {
                                var daysAdmitted = admission.AdmissionDate.HasValue
                                ? (DateTime.Today - admission.AdmissionDate.Value.Date).Days
                                : 0;
                                <tr class="patient-row"
                                    data-name="@admission.Patient.FirstName.ToLower() @admission.Patient.LastName.ToLower()"
                                    data-id="@admission.Patient.IdentityNumber.ToLower()"
                                    data-reason="@admission.Reason?.ToLower()"
                                    data-ward="@admission.Bed?.Room?.Ward?.Name?.ToLower()"
                                    data-room="@admission.Bed?.Room?.RoomNumber?.ToLower()"
                                    data-date="@admission.AdmissionDate?.ToString("yyyy-MM-dd")"
                                    data-days="@daysAdmitted">
                                    <td>
                                        <strong>@admission.Patient.FirstName @admission.Patient.LastName</strong><br />
                                        <small class="text-muted">ID: @admission.Patient.IdentityNumber</small>
                                    </td>
                                    <td>@admission.AdmissionDate?.ToString("dd MMM yyyy")</td>
                                    <td>@admission.Reason</td>
                                    <td>@admission.Bed?.Room?.Ward?.Name</td>
                                    <td>@admission.Bed?.Room?.RoomNumber</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">@admission.Bed?.BedNumber</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@daysAdmitted days</span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="DischargePatient" asp-controller="DoctorDischarge"
                                           asp-route-admissionId="@admission.AdmissionId"
                                           class="btn btn-sm btn-outline-success glow-discharge bounce-discharge">
                                            <i class="bi bi-box-arrow-right me-1"></i>Discharge
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Container -->
                <div class="mt-3" id="patientsPagination"></div>

                <div id="noResults" class="text-center py-4 d-none">
                    <i class="bi bi-search display-4 text-muted mb-3"></i>
                    <h5 class="text-muted">No Patients Found</h5>
                    <p class="text-muted">No patients match your search criteria.</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    body {
        background: linear-gradient(120deg, #f0f4f8 0%, #e0e7ff 100%);
        min-height: 100vh;
    }

    .glow-discharge {
        animation: glow-pulse 2s infinite;
        position: relative;
    }

    @@keyframes glow-pulse {
        0% {
            box-shadow: 0 0 5px rgba(25, 135, 84, 0.5);
        }

        50% {
            box-shadow: 0 0 20px rgba(25, 135, 84, 0.8), 0 0 30px rgba(25, 135, 84, 0.6);
        }

        100% {
            box-shadow: 0 0 5px rgba(25, 135, 84, 0.5);
        }
    }

    /* Optional: Add a subtle bounce */
    .bounce-discharge:hover {
        animation: bounce 0.5s;
    }

    @@keyframes bounce {
        0%, 20%, 60%, 100% {
            transform: translateY(0);
        }

        40% {
            transform: translateY(-5px);
        }

        80% {
            transform: translateY(-2px);
        }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Search Filter -->
    <script>
        const searchInput = document.getElementById('patientSearch');
        const patientsTableBody = document.getElementById('patientsTableBody');
        let allPatientRows = Array.from(patientsTableBody.querySelectorAll('.patient-row'));
        let filteredPatientRows = [...allPatientRows];

        function performSearch() {
            const query = searchInput.value.toLowerCase();

            filteredPatientRows = allPatientRows.filter(row => {
                const name = row.getAttribute('data-name');
                const id = row.getAttribute('data-id');
                const reason = row.getAttribute('data-reason');
                const ward = row.getAttribute('data-ward');
                const room = row.getAttribute('data-room');

                return name.includes(query) || id.includes(query) ||
                       (reason && reason.includes(query)) ||
                       (ward && ward.includes(query)) ||
                       (room && room.includes(query));
            });

            displayPage(1);
        }

        searchInput.addEventListener('keyup', performSearch);
    </script>

    <!-- Sorting + Pagination -->
    <script>
        const sortSelect = document.getElementById('sortSelect');
        const rowsPerPage = 9;
        let currentPage = 1;

        function displayPage(page) {
            currentPage = page;
            const start = (page - 1) * rowsPerPage;
            const end = start + rowsPerPage;

            // Hide all rows first
            allPatientRows.forEach(row => row.style.display = 'none');

            // Show only filtered rows for current page
            filteredPatientRows.forEach((patientRow, index) => {
                if (index >= start && index < end) {
                    patientRow.style.display = '';
                }
            });

            renderPagination();
        }

        function renderPagination() {
            const paginationContainer = document.getElementById('patientsPagination');
            paginationContainer.innerHTML = '';
            const totalPages = Math.ceil(filteredPatientRows.length / rowsPerPage);

            if (totalPages > 1) {
                // Previous button
                if (currentPage > 1) {
                    const prevBtn = document.createElement('button');
                    prevBtn.className = 'btn btn-sm btn-outline-primary me-1';
                    prevBtn.innerHTML = '<i class="bi bi-chevron-left"></i>';
                    prevBtn.addEventListener('click', () => displayPage(currentPage - 1));
                    paginationContainer.appendChild(prevBtn);
                }

                // Page buttons
                for (let i = 1; i <= totalPages; i++) {
                    const btn = document.createElement('button');
                    btn.className = 'btn btn-sm me-1 ' + (i === currentPage ? 'btn-primary' : 'btn-outline-primary');
                    btn.innerText = i;
                    btn.addEventListener('click', () => displayPage(i));
                    paginationContainer.appendChild(btn);
                }

                // Next button
                if (currentPage < totalPages) {
                    const nextBtn = document.createElement('button');
                    nextBtn.className = 'btn btn-sm btn-outline-primary me-1';
                    nextBtn.innerHTML = '<i class="bi bi-chevron-right"></i>';
                    nextBtn.addEventListener('click', () => displayPage(currentPage + 1));
                    paginationContainer.appendChild(nextBtn);
                }
            }
        }

        function sortTable(sortValue) {
            const [column, direction] = sortValue.split('-');
            const isAsc = direction === 'asc';

            filteredPatientRows.sort((a, b) => {
                let aValue, bValue;

                switch (column) {
                    case 'patient':
                        aValue = a.children[0].textContent.trim().toLowerCase();
                        bValue = b.children[0].textContent.trim().toLowerCase();
                        break;
                    case 'date':
                        // Parse date for proper sorting (using data attribute for consistent format)
                        aValue = new Date(a.getAttribute('data-date'));
                        bValue = new Date(b.getAttribute('data-date'));
                        break;
                    case 'days':
                        // Sort by days admitted (numeric)
                        aValue = parseInt(a.getAttribute('data-days')) || 0;
                        bValue = parseInt(b.getAttribute('data-days')) || 0;
                        break;
                    case 'ward':
                        aValue = a.children[3].textContent.trim().toLowerCase();
                        bValue = b.children[3].textContent.trim().toLowerCase();
                        break;
                    case 'room':
                        aValue = a.children[4].textContent.trim().toLowerCase();
                        bValue = b.children[4].textContent.trim().toLowerCase();
                        break;
                    default:
                        aValue = a.children[0].textContent.trim().toLowerCase();
                        bValue = b.children[0].textContent.trim().toLowerCase();
                }

                if (aValue < bValue) return isAsc ? -1 : 1;
                if (aValue > bValue) return isAsc ? 1 : -1;
                return 0;
            });

            // Reorder DOM elements
            filteredPatientRows.forEach(patientRow => {
                patientsTableBody.appendChild(patientRow);
            });

            displayPage(1);
        }

        // Initialize sort dropdown
        sortSelect.addEventListener('change', function() {
            sortTable(this.value);
        });

        // Initialize display
        sortTable('date-desc');
        displayPage(1);
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            @if (TempData["ToastMessage"] != null)
            {
                    <text>
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                        icon: '@TempData["ToastType"]',
                        title: '@TempData["ToastMessage"]'
                    });
                    </text>
            }
        });
    </script>
}