@model IEnumerable<Wellness_Wardens_Project.Models.PatientCareSubsystem.Instruction>

@{
    ViewData["Title"] = "Instructions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="fw-bold text-primary">
                <i class="bi bi-chat-dots-fill me-2"></i>Instructions
            </h2>
            <p class="text-muted mb-0">Manage instructions and shift notes for the nursing team.</p>
        </div>
        @if (User.IsInRole("Doctor"))
        {
            <div class="d-flex gap-2">
                <a asp-action="Doctors" asp-controller="Home" class="btn btn-primary">
                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                </a>
                <a asp-action="CreateInstruction" asp-controller="DoctorInstructions" class="btn btn-outline-primary">
                    <i class="bi bi-plus-circle me-1"></i>New Instruction
                </a>
            </div>
        }
    </div>

    <!-- Search and Sort -->
    @if (Model.Any())
    {
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" id="instructionSearch" class="form-control" placeholder="Search by title, patient, type, or priority...">
                </div>
            </div>
            <div class="col-md-4">
                <select id="sortSelect" class="form-select">
                    <option value="title-asc">Sort by: Title (A-Z)</option>
                    <option value="title-desc">Sort by: Title (Z-A)</option>
                    <option value="patient-asc">Sort by: Patient (A-Z)</option>
                    <option value="patient-desc">Sort by: Patient (Z-A)</option>
                    <option value="type-asc">Sort by: Type (A-Z)</option>
                    <option value="type-desc">Sort by: Type (Z-A)</option>
                    <option value="priority-asc">Sort by: Priority (Low to High)</option>
                    <option value="priority-desc">Sort by: Priority (High to Low)</option>
                    <option value="date-asc">Sort by: Date (Oldest First)</option>
                    <option value="date-desc">Sort by: Date (Newest First)</option>
                    <option value="status-asc">Sort by: Status (Pending First)</option>
                    <option value="status-desc">Sort by: Status (Completed First)</option>
                </select>
            </div>
        </div>
    }

    <!-- Instructions List -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-chat-square-text display-4 text-muted mb-3"></i>
                    <h5 class="text-muted">No Instructions Yet</h5>
                    <p class="text-muted">@(User.IsInRole("Doctor") ? "Create your first instruction for the nursing team." : "No instructions have been assigned yet.")</p>
                    @if (User.IsInRole("Doctor"))
                    {
                        <a asp-action="CreateInstruction" asp-controller="DoctorInstructions" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-1"></i>Create First Instruction
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-primary">
                            <tr>
                                <th>Title</th>
                                <th>Patient</th>
                                <th>Type</th>
                                <th>Priority</th>
                                <th>Created</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="instructionsTableBody">
                            @foreach (var instruction in Model)
                            {
                                <tr class="instruction-row"
                                    data-title="@instruction.Title.ToLower()"
                                    data-patient="@(instruction.Patient != null ? $"{instruction.Patient.FirstName} {instruction.Patient.LastName}".ToLower() : "general")"
                                    data-type="@instruction.InstructionType.ToLower()"
                                    data-priority="@instruction.Priority.ToLower()"
                                    data-status="@(instruction.IsCompleted ? "completed" : "pending")"
                                    data-date="@instruction.CreatedDate.ToString("yyyy-MM-dd")">
                                    <td>
                                        <strong>@instruction.Title</strong>
                                        @if (instruction.ExpiryDate.HasValue && instruction.ExpiryDate < DateTime.Now)
                                        {
                                            <span class="badge bg-danger ms-1">Expired</span>
                                        }
                                    </td>
                                    <td>
                                        @if (instruction.Patient != null)
                                        {
                                            @instruction.Patient.FirstName @instruction.Patient.LastName
                                        }
                                        else
                                        {
                                            <span class="text-muted">General</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@instruction.InstructionType</span>
                                    </td>
                                    <td>
                                        @{
                                            var priorityClass = instruction.Priority switch
                                            {
                                                "Critical" => "bg-danger",
                                                "High" => "bg-warning text-dark",
                                                "Low" => "bg-secondary",
                                                _ => "bg-primary"
                                            };
                                        }
                                        <span class="badge @priorityClass">@instruction.Priority</span>
                                    </td>
                                    <td>@instruction.CreatedDate.ToString("dd MMM yy")</td>
                                    <td>
                                        @if (instruction.IsCompleted)
                                        {
                                            <span class="badge bg-success">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <!-- View Button -->
                                            <a asp-action="InstructionDetails" asp-controller="DoctorInstructions"
                                               asp-route-id="@instruction.InstructionId"
                                               class="btn btn-outline-primary"
                                               data-bs-toggle="tooltip" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            @if (User.IsInRole("Doctor"))
                                            {
                                                <!-- Edit Button -->
                                                <a asp-action="EditInstruction" asp-controller="DoctorInstructions"
                                                   asp-route-id="@instruction.InstructionId"
                                                   class="btn btn-outline-warning"
                                                   data-bs-toggle="tooltip" title="Edit Instruction">
                                                    <i class="bi bi-pencil"></i>
                                                </a>

                                                <!-- Delete Button -->
                                                <button type="button" class="btn btn-outline-danger delete-instruction-btn"
                                                        data-instruction-id="@instruction.InstructionId"
                                                        data-instruction-title="@instruction.Title"
                                                        data-bs-toggle="tooltip" title="Delete Instruction">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }

                                            @if (User.IsInRole("Nurse") && !instruction.IsCompleted)
                                            {
                                                <!-- Complete Button -->
                                                <button type="button" class="btn btn-outline-success complete-instruction-btn"
                                                        data-instruction-id="@instruction.InstructionId"
                                                        data-instruction-title="@instruction.Title"
                                                        data-bs-toggle="tooltip" title="Mark as Completed">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Container -->
                <div class="mt-3" id="instructionsPagination"></div>

                <div id="noResults" class="text-center py-4 d-none">
                    <i class="bi bi-search display-4 text-muted mb-3"></i>
                    <h5 class="text-muted">No Instructions Found</h5>
                    <p class="text-muted">No instructions match your search criteria.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Hidden form for delete operations -->
<form id="deleteInstructionForm" asp-action="DeleteInstruction" asp-controller="DoctorInstructions" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteInstructionId" />
</form>

<!-- Hidden form for complete operations -->
<form id="completeInstructionForm" asp-action="MarkAsCompleted" asp-controller="DoctorInstructions" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="completeInstructionId" />
</form>

<!-- Modal Container -->
<div id="modalContainer"></div>

@section Scripts {
    <!-- Include SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Include jQuery Validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>
        body {
            background: linear-gradient(120deg, #f0f4f8 0%, #e0e7ff 100%);
            min-height: 100vh;
        }

        .btn-group .btn {
            border-radius: 0.375rem;
            margin: 0 1px;
        }

            .btn-group .btn:first-child {
                border-top-left-radius: 0.375rem;
                border-bottom-left-radius: 0.375rem;
            }

            .btn-group .btn:last-child {
                border-top-right-radius: 0.375rem;
                border-bottom-right-radius: 0.375rem;
            }
    </style>

    <!-- Search Filter -->
    <script>
        const searchInput = document.getElementById('instructionSearch');
        const instructionsTableBody = document.getElementById('instructionsTableBody');
        let allInstructionRows = Array.from(instructionsTableBody.querySelectorAll('.instruction-row'));
        let filteredInstructionRows = [...allInstructionRows];

        function performSearch() {
            const query = searchInput.value.toLowerCase();

            filteredInstructionRows = allInstructionRows.filter(row => {
                const title = row.getAttribute('data-title');
                const patient = row.getAttribute('data-patient');
                const type = row.getAttribute('data-type');
                const priority = row.getAttribute('data-priority');
                const status = row.getAttribute('data-status');
                const date = row.getAttribute('data-date');

                return title.includes(query) || patient.includes(query) ||
                       type.includes(query) || priority.includes(query) ||
                       status.includes(query) || date.includes(query);
            });

            displayPage(1);
        }

        searchInput.addEventListener('keyup', performSearch);
    </script>

    <!-- Sorting + Pagination -->
    <script>
        const sortSelect = document.getElementById('sortSelect');
        const rowsPerPage = 9;
        let currentPage = 1;

        function displayPage(page) {
            currentPage = page;
            const start = (page - 1) * rowsPerPage;
            const end = start + rowsPerPage;

            // Hide all rows first
            allInstructionRows.forEach(row => row.style.display = 'none');

            // Show only filtered rows for current page
            filteredInstructionRows.forEach((instructionRow, index) => {
                if (index >= start && index < end) {
                    instructionRow.style.display = '';
                }
            });

            renderPagination();
        }

        function renderPagination() {
            const paginationContainer = document.getElementById('instructionsPagination');
            paginationContainer.innerHTML = '';
            const totalPages = Math.ceil(filteredInstructionRows.length / rowsPerPage);

            if (totalPages > 1) {
                // Previous button
                if (currentPage > 1) {
                    const prevBtn = document.createElement('button');
                    prevBtn.className = 'btn btn-sm btn-outline-primary me-1';
                    prevBtn.innerHTML = '<i class="bi bi-chevron-left"></i>';
                    prevBtn.addEventListener('click', () => displayPage(currentPage - 1));
                    paginationContainer.appendChild(prevBtn);
                }

                // Page buttons
                for (let i = 1; i <= totalPages; i++) {
                    const btn = document.createElement('button');
                    btn.className = 'btn btn-sm me-1 ' + (i === currentPage ? 'btn-primary' : 'btn-outline-primary');
                    btn.innerText = i;
                    btn.addEventListener('click', () => displayPage(i));
                    paginationContainer.appendChild(btn);
                }

                // Next button
                if (currentPage < totalPages) {
                    const nextBtn = document.createElement('button');
                    nextBtn.className = 'btn btn-sm btn-outline-primary me-1';
                    nextBtn.innerHTML = '<i class="bi bi-chevron-right"></i>';
                    nextBtn.addEventListener('click', () => displayPage(currentPage + 1));
                    paginationContainer.appendChild(nextBtn);
                }
            }
        }

        function sortTable(sortValue) {
            const [column, direction] = sortValue.split('-');
            const isAsc = direction === 'asc';

            filteredInstructionRows.sort((a, b) => {
                let aValue, bValue;

                switch (column) {
                    case 'title':
                        aValue = a.children[0].textContent.trim().toLowerCase();
                        bValue = b.children[0].textContent.trim().toLowerCase();
                        break;
                    case 'patient':
                        aValue = a.children[1].textContent.trim().toLowerCase();
                        bValue = b.children[1].textContent.trim().toLowerCase();
                        // Handle "General" patient
                        if (aValue === 'general') aValue = '';
                        if (bValue === 'general') bValue = '';
                        break;
                    case 'type':
                        aValue = a.children[2].textContent.trim().toLowerCase();
                        bValue = b.children[2].textContent.trim().toLowerCase();
                        break;
                    case 'priority':
                        // Priority order: Critical (1), High (2), Medium (3), Low (4)
                        const priorityOrder = {
                            'critical': 1,
                            'high': 2,
                            'medium': 3,
                            'low': 4
                        };
                        aValue = priorityOrder[a.getAttribute('data-priority')] || 5;
                        bValue = priorityOrder[b.getAttribute('data-priority')] || 5;
                        break;
                    case 'date':
                        // Parse date for proper sorting (using data attribute for consistent format)
                        aValue = new Date(a.getAttribute('data-date'));
                        bValue = new Date(b.getAttribute('data-date'));
                        break;
                    case 'status':
                        // Status priority: Pending (1), Completed (2)
                        aValue = a.getAttribute('data-status') === 'pending' ? 1 : 2;
                        bValue = b.getAttribute('data-status') === 'pending' ? 1 : 2;
                        break;
                    default:
                        aValue = a.children[0].textContent.trim().toLowerCase();
                        bValue = b.children[0].textContent.trim().toLowerCase();
                }

                if (aValue < bValue) return isAsc ? -1 : 1;
                if (aValue > bValue) return isAsc ? 1 : -1;
                return 0;
            });

            // Reorder DOM elements
            filteredInstructionRows.forEach(instructionRow => {
                instructionsTableBody.appendChild(instructionRow);
            });

            displayPage(1);
        }

        // Initialize sort dropdown
        sortSelect.addEventListener('change', function() {
            sortTable(this.value);
        });

        // Initialize display
        sortTable('date-desc');
        displayPage(1);
    </script>

    <!-- Existing JavaScript Functions -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            console.log("DOM loaded - initializing instructions page");

            // Initialize tooltips
            initializeTooltips();

            // Setup action buttons
            setupActionButtons();

            // Show any toast messages
            showToastMessages();
        });

        function initializeTooltips() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        }

        function setupActionButtons() {
            // Edit Instruction Modal - Use event delegation
            document.addEventListener('click', function(e) {
                if (e.target.closest('.edit-instruction-btn')) {
                    const button = e.target.closest('.edit-instruction-btn');
                    const instructionId = button.getAttribute('data-instruction-id');
                    console.log('Edit button clicked for instruction:', instructionId);
                    openEditInstructionModal(instructionId);
                }
            });

            // Delete Instruction with SweetAlert
            document.querySelectorAll('.delete-instruction-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const instructionId = this.getAttribute('data-instruction-id');
                    const instructionTitle = this.getAttribute('data-instruction-title');

                    Swal.fire({
                        title: 'Are you sure?',
                        text: `You are about to delete the instruction: "${instructionTitle}". This action cannot be undone.`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#3085d6',
                        confirmButtonText: 'Yes, delete it!',
                        cancelButtonText: 'Cancel',
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            document.getElementById('deleteInstructionId').value = instructionId;
                            document.getElementById('deleteInstructionForm').submit();
                        }
                    });
                });
            });

            // Complete Instruction with SweetAlert (for Nurses)
            document.querySelectorAll('.complete-instruction-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const instructionId = this.getAttribute('data-instruction-id');
                    const instructionTitle = this.getAttribute('data-instruction-title');

                    Swal.fire({
                        title: 'Mark as Completed?',
                        text: `Are you sure you want to mark "${instructionTitle}" as completed?`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#28a745',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Yes, mark as completed!',
                        cancelButtonText: 'Cancel',
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            document.getElementById('completeInstructionId').value = instructionId;
                            document.getElementById('completeInstructionForm').submit();
                        }
                    });
                });
            });
        }

        function openEditInstructionModal(instructionId) {
            console.log('Opening modal for instruction:', instructionId);

            // Show loading state
            const modalContainer = document.getElementById('modalContainer');
            if (!modalContainer) {
                console.error('Modal container not found!');
                Swal.fire({
                    title: 'Error!',
                    text: 'Modal system not initialized properly.',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
                return;
            }

            modalContainer.innerHTML = `
                <div class="modal fade" id="editInstructionModal" tabindex="-1">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header bg-warning text-white">
                                <h5 class="modal-title">Loading Instruction...</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body text-center py-4">
                                <div class="spinner-border text-warning" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-2">Please wait while we load the instruction...</p>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Show the loading modal immediately
            const loadingModal = new bootstrap.Modal(document.getElementById('editInstructionModal'));
            loadingModal.show();

            // Load the modal content using fetch
            fetch('@Url.Action("EditInstructionModal", "DoctorInstructions")' + '?id=' + instructionId)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok: ' + response.status);
                    }
                    return response.text();
                })
                .then(html => {
                    // Replace the loading modal with the actual form
                    modalContainer.innerHTML = html;

                    // Re-initialize the modal with the form
                    const modalElement = document.getElementById('editInstructionModal');
                    if (modalElement) {
                        const modal = new bootstrap.Modal(modalElement);

                        // Set select values explicitly
                        setFormValues();

                        // Initialize validation
                        initializeFormValidation();

                        // Handle form submission
                        setupFormSubmission(modal);

                        // Show the modal
                        modal.show();
                    }
                })
                .catch(error => {
                    console.error('Error loading modal:', error);
                    loadingModal.hide();
                    Swal.fire({
                        title: 'Error!',
                        text: 'Failed to load instruction data. Please try again.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                });
        }

        function setFormValues() {
            // This function will be called after the modal HTML is loaded
            // The values should already be set by the server, but we can double-check
            console.log('Form loaded, values should be pre-filled by server');
        }

        function initializeFormValidation() {
            const form = document.getElementById('editInstructionForm');
            if (form && typeof jQuery !== 'undefined' && jQuery.fn.validate) {
                $(form).validate({
                    rules: {
                        Title: { required: true, minlength: 3 },
                        Content: { required: true, minlength: 10 },
                        InstructionType: { required: true },
                        Priority: { required: true }
                    },
                    messages: {
                        Title: {
                            required: "Please enter a title",
                            minlength: "Title must be at least 3 characters long"
                        },
                        Content: {
                            required: "Please enter instructions",
                            minlength: "Instructions must be at least 10 characters long"
                        },
                        InstructionType: "Please select instruction type",
                        Priority: "Please select priority"
                    },
                    errorElement: 'span',
                    errorPlacement: function (error, element) {
                        error.addClass('text-danger small');
                        element.closest('.form-group').append(error);
                    },
                    highlight: function (element) {
                        $(element).addClass('is-invalid');
                    },
                    unhighlight: function (element) {
                        $(element).removeClass('is-invalid');
                    },
                    submitHandler: function(form) {
                        // This will be handled by our custom submission
                        return false;
                    }
                });
            }
        }

        function setupFormSubmission(modal) {
            const form = document.getElementById('editInstructionForm');
            if (!form) return;

            form.addEventListener('submit', function(e) {
                e.preventDefault();

                if (!$(this).valid()) {
                    return;
                }

                const formData = new FormData(this);
                const submitBtn = this.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;

                // Show loading state
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Updating...';

                fetch(this.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok: ' + response.status);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        modal.hide();
                        Swal.fire({
                            title: 'Success!',
                            text: data.message,
                            icon: 'success',
                            confirmButtonText: 'OK'
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            title: 'Error!',
                            text: data.message,
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalText;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        title: 'Error!',
                        text: 'An error occurred while updating the instruction. Please try again.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                });
            });
        }

        function showToastMessages() {
            @if (TempData["ToastMessage"] != null)
            {
                    var toastType = TempData["ToastType"]?.ToString() ?? "info";
                    var icon = toastType == "success" ? "success" :
                                                            toastType == "error" ? "error" :
                                                            toastType == "warning" ? "warning" : "info";

                    <text>
                    Swal.fire({
                        title: '@TempData["ToastMessage"]',
                        icon: '@icon',
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                        didOpen: (toast) => {
                            toast.addEventListener('mouseenter', Swal.stopTimer)
                            toast.addEventListener('mouseleave', Swal.resumeTimer)
                        }
                    });
                    </text>
            }
        }

        window.debugEditModal = function(instructionId) {
            console.log('Debug: Testing modal with ID', instructionId);
            openEditInstructionModal(instructionId);
        };
    </script>
}