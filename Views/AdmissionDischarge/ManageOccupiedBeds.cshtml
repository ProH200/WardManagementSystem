@model IEnumerable<Wellness_Wardens_Project.Models.AdministrationSubsystem.Bed>

@{
    ViewData["Title"] = "Occupied Beds";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #CAD5E2; /* Soft background */
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #212529;
        margin: 0;
        padding: 0;
    }

    .bed-card {
        background-color: #D3DCE6; /* Slightly lighter than body */
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .bed-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.1);
        }

        .bed-card h5 {
            margin-bottom: 0.2rem;
        }

        .bed-card small {
            font-size: 0.85rem;
        }

    .badge-status {
        font-size: 0.85rem;
    }
</style>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-door-closed me-2"></i> Occupied Beds
            </h2>
            <p class="text-muted mb-0">
                View all beds that are currently occupied by patients.
            </p>
        </div>
        <a asp-action="WardAdminDashboard" asp-controller="Administration"
           class="btn btn-outline-secondary shadow-sm rounded-pill px-4">
            <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
        </a>
    </div>

    <!-- Beds List -->
    <div class="d-flex flex-column gap-3">
        @foreach (var bed in Model)
        {
            // Safely handle nulls
            var activeAdmission = bed.PatientAdmissions?
            .FirstOrDefault();

            <div class="bed-card p-4 rounded-3 shadow-sm d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold">Bed #: @bed.BedNumber</h5>
                    <small class="text-muted">
                        Room: @(bed.Room?.RoomNumber ?? "-") | Ward: @(bed.Room?.Ward?.Name ?? "-")
                    </small>
                    @if (activeAdmission.AssignedEmployee != null)
                    {
                        <small class="text-muted d-block mt-1">
                            Assigned Staff: <strong>@activeAdmission.AssignedEmployee.Title @activeAdmission.AssignedEmployee.LastName</strong>
                        </small>
                    }
                </div>
                <div class="text-end">
                    @if (activeAdmission != null)
                    {
                        <h5 class="fw-bold">@activeAdmission.Patient?.FirstName @activeAdmission.Patient?.LastName</h5>
                        <small class="text-muted">@activeAdmission.Patient?.Email</small>
                        <div class="mt-1">
                            <span class="badge bg-warning text-dark badge-status">Occupied</span>
                        </div>
                    }
                </div>
               
            </div>
        }

    </div>
</div>
