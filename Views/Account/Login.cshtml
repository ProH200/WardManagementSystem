@using Wellness_Wardens_Project.ViewModels
@using Wellness_Wardens_Project.ViewModels.Account
@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/AccountLayout.cshtml";
}

<!-- Toast Container -->
<div class="position-fixed top-0 start-50 translate-middle-x mt-3" style="z-index: 2000; width: 100%; max-width: 600px; pointer-events: none;">
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="successToast" class="toast align-items-center text-white bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5000" style="pointer-events: auto;">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["SuccessMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    }
    else if (TempData["ErrorMessage"] != null)
    {
        <div id="errorToast" class="toast align-items-center text-white bg-danger border-0 show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5000" style="pointer-events: auto;">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["ErrorMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    }
</div>

<!-- Login Page Main Layout -->
<div class="container-fluid login-wrapper p-0">
    <div class="row g-0 w-100 min-vh-100">
        <!-- Left: Login Form -->
        <div class="col-lg-6 d-flex justify-content-center align-items-center form-section">
            <div class="account-box">
                <h2 class="text-center mb-4">Login</h2>
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address:</label>
                        <input asp-for="Email" class="form-control" placeholder="Enter email address" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password:</label>
                        <input asp-for="Password" class="form-control" placeholder="Enter password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="float-end mb-2">
                        <a href="#" data-bs-toggle="modal" data-bs-target="#verifyEmailModal" class="text-decoration-none">Forgot password?</a>
                    </div>

                    <div class="form-check mb-3">
                        <label class="form-check-label">
                            <input asp-for="RememberMe" class="form-check-input" />
                            @Html.DisplayNameFor(a => a.RememberMe)
                        </label>
                    </div>

                    <input type="submit" value="Login" class="btn btn-primary w-100 p-2" />
                    <p class="mt-3">
                        Don't have an account? <a asp-controller="Account" asp-action="Register">Register</a>
                        <a asp-controller="Home" asp-action="Index" style="padding-left: 6em;">Back</a>
                    </p>
                </form>
            </div>
        </div>

        <!-- Right: Branding Section -->
        <div class="col-lg-6 d-flex justify-content-center align-items-center branding-section flex-column text-white text-center px-5">
            <div class="mb-4 d-flex align-items-center gap-3">
                <h1 class="fw-bold mb-0">Wellness Wardens</h1>
            </div>

            <h4 class="mb-3 fw-semibold fst-italic text-light">Hospital Patient Management System</h4>
            <p class="lead mb-5 px-3 text-white-50">
                Smart tools for doctors, nurses, and administrators to manage wards, admissions, records, and care efficiently.
            </p>

            <div class="row w-100 justify-content-center feature-grid px-3">
                <div class="col-6 col-md-4 mb-4 feature-card">
                    <i class="bi bi-person-vcard-fill display-5"></i>
                    <p class="mt-2 fw-semibold">Patient Profiles</p>
                </div>
                <div class="col-6 col-md-4 mb-4 feature-card">
                    <i class="bi bi-clipboard2-pulse-fill display-5"></i>
                    <p class="mt-2 fw-semibold">Ward & Beds</p>
                </div>
                <div class="col-6 col-md-4 mb-4 feature-card">
                    <i class="bi bi-capsule-pill display-5"></i>
                    <p class="mt-2 fw-semibold">Medication</p>
                </div>
                <div class="col-6 col-md-4 mb-4 feature-card">
                    <i class="bi bi-person-gear display-5"></i>
                    <p class="mt-2 fw-semibold">Staff Roles</p>
                </div>
                <div class="col-6 col-md-4 mb-4 feature-card">
                    <i class="bi bi-search display-5"></i>
                    <p class="mt-2 fw-semibold">Quick Search</p>
                </div>
                <div class="col-6 col-md-4 mb-4 feature-card">
                    <i class="bi bi-activity display-5"></i>
                    <p class="mt-2 fw-semibold">Visit Logs</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Verify Email Modal -->
<div class="modal fade" id="verifyEmailModal" tabindex="-1" aria-labelledby="verifyEmailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content account-box p-4 text-white">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold text-white" id="verifyEmailModalLabel">Verify Email</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="VerifyEmail" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address:</label>
                        <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="modal-footer border-0">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light px-4 py-2">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 py-2">Verify</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Toast container for Verify Email error -->
<div class="position-fixed top-0 end-0 p-3" style="z-index: 2100; pointer-events:none;">
    @if (TempData["VerifyEmailError"] != null)
    {
        <div id="verifyEmailErrorToast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5000" style="pointer-events:auto;">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["VerifyEmailError"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        window.onload = function () {
            // Show login success/error toasts
            const successToastEl = document.getElementById('successToast');
            const errorToastEl = document.getElementById('errorToast');
            if (successToastEl) {
                new bootstrap.Toast(successToastEl).show();
            }
            if (errorToastEl) {
                new bootstrap.Toast(errorToastEl).show();
            }

            // Show verify email error toast AND open modal
            const verifyEmailErrorToastEl = document.getElementById('verifyEmailErrorToast');
            if (verifyEmailErrorToastEl) {
                // Show toast
                new bootstrap.Toast(verifyEmailErrorToastEl).show();
                // Open modal
                const verifyEmailModal = new bootstrap.Modal(document.getElementById('verifyEmailModal'));
                verifyEmailModal.show();
            }
        }
    </script>
}