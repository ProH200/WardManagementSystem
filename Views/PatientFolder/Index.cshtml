@model IEnumerable<Wellness_Wardens_Project.Models.PatientManagementSubsystem.Patient>

@{
    ViewData["Title"] = "My Patient Folders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="fw-bold text-primary mb-4">
        <i class="bi bi-folder-fill me-2"></i>My Patient Folders
    </h2>
    <a asp-action="Doctors" asp-controller="Home" class="btn btn-outline-secondary me-md-2">
        <i class="bi bi-arrow-left me-1"></i> Dashboard
    </a>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-info-circle display-4 d-block mb-3"></i>
            <h4>No Patients Assigned</h4>
            <p class="mb-0">You don't have any patients assigned to you yet.</p>
        </div>
    }

    else
    {
        <p class="text-muted mb-4">You have <strong>@Model.Count()</strong> assigned patients.</p>

        <div class="row g-3">
            @foreach (var patient in Model)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body text-center">
                            <i class="bi bi-person-fill display-4 text-success mb-3"></i>
                            <h5>@patient.FirstName @patient.LastName</h5>
                            <p class="text-muted small mb-1">ID: @patient.IdentityNumber</p>
                            <p class="text-muted small">DOB: @patient.DateOfBirth.ToString("dd MMM yyyy")</p>

                            <a asp-action="Details" asp-controller="PatientFolder"
                               asp-route-id="@patient.PatientId"
                               class="btn btn-outline-primary w-100">
                                Open Folder
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>