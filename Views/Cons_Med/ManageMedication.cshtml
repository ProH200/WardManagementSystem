@model IEnumerable<Wellness_Wardens_Project.Models.AdministrationSubsystem.Medication>

@{
    ViewData["Title"] = "Manage Medication";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-capsule-pill me-2"></i> Medication</h2>
        <div>
            <a asp-controller="Administration" asp-action="Dashboard" class="btn btn-outline-primary me-2">
                <i class="bi bi-house-door me-1"></i> Dashboard
            </a>
            <!-- Add Medication Modal Trigger -->
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addMedicationModal">
                <i class="bi bi-plus-circle me-1"></i> Add Medication
            </button>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <input class="form-control" id="searchInput" placeholder="Search medication..." />
        </div>
        <div class="col-md-4">
            <select id="sortSelect" class="form-select">
                <option value="name-asc">Sort by: Name (A-Z)</option>
                <option value="name-desc">Sort by: Name (Z-A)</option>
                <option value="quantity-asc">Sort by: Quantity (Low to High)</option>
                <option value="quantity-desc">Sort by: Quantity (High to Low)</option>
                <option value="scheduled-asc">Sort by: Scheduled (No to Yes)</option>
                <option value="scheduled-desc">Sort by: Scheduled (Yes to No)</option>
            </select>
        </div>
    </div>

    <!-- Medication Table -->
    <div class="table-responsive">
        <table id="medicationTable" class="table table-hover align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Quantity Available</th>
                    <th>Scheduled?</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="medicationTableBody">
                @if (Model != null && Model.Any())
                {
                    foreach (var med in Model)
                    {
                        <tr class="medication-row">
                            <td>@med.Name</td>
                            <td>@med.QuantityAvailable</td>
                            <td>@(med.IsScheduledMedication ? "Yes" : "No")</td>
                            <td>
                                <!-- Edit Button -->
                                <button type="button" class="btn btn-sm btn-outline-primary me-2" data-bs-toggle="modal" data-bs-target="#editModal-@med.MedicationId">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </button>

                                <!-- Delete Button -->
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@med.MedicationId">
                                    <i class="bi bi-trash3-fill"></i> Delete
                                </button>
                            </td>
                        </tr>

                        <!-- Edit Modal -->
                        <div class="modal fade" id="editModal-@med.MedicationId" tabindex="-1"
                             aria-labelledby="editModalLabel-@med.MedicationId" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form asp-action="EditMedication" method="post">
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("MedicationId", med.MedicationId)

                                        <div class="modal-header bg-primary text-white">
                                            <h5 class="modal-title">
                                                <i class="bi bi-pencil-square me-2"></i> Edit Medication
                                            </h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                        </div>

                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label">Name</label>
                                                <input name="Name" class="form-control" value="@med.Name" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Quantity Available</label>
                                                <input name="QuantityAvailable" type="number" class="form-control" value="@med.QuantityAvailable" required />
                                            </div>
                                            <div class="form-check mb-3">
                                                <input name="IsScheduledMedication" type="checkbox" class="form-check-input" id="isScheduled-@med.MedicationId" value="true" @(med.IsScheduledMedication ? "checked" : "") />
                                                <label class="form-check-label" for="isScheduled-@med.MedicationId">Scheduled Medication</label>
                                            </div>
                                        </div>

                                        <div class="modal-footer">
                                            <button type="submit" class="btn btn-primary">Save Changes</button>
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Delete Confirmation Modal -->
                        <div class="modal fade" id="deleteModal-@med.MedicationId" tabindex="-1"
                             aria-labelledby="deleteModalLabel-@med.MedicationId" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form asp-action="SoftDeleteMedication" method="post">
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", med.MedicationId)

                                        <div class="modal-header bg-danger text-white">
                                            <h5 class="modal-title">
                                                <i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Medication
                                            </h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                        </div>

                                        <div class="modal-body">
                                            <p class="fw-bold">Are you sure you want to delete this medication?</p>
                                            <ul class="list-group">
                                                <li class="list-group-item"><strong>Name:</strong> @med.Name</li>
                                                <li class="list-group-item"><strong>Quantity:</strong> @med.QuantityAvailable</li>
                                                <li class="list-group-item"><strong>Scheduled:</strong> @(med.IsScheduledMedication ? "Yes" : "No")</li>
                                            </ul>
                                        </div>

                                        <div class="modal-footer">
                                            <button type="submit" class="btn btn-danger">Yes, Delete</button>
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">No medication found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Container -->
    <div class="mt-3" id="medicationPagination"></div>
</div>

<!-- Add Medication Modal -->
<div class="modal fade" id="addMedicationModal" tabindex="-1" aria-labelledby="addMedicationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddMedication" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="addMedicationModalLabel">
                        <i class="bi bi-plus-circle me-2"></i> Add Medication
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Quantity Available</label>
                        <input name="QuantityAvailable" type="number" class="form-control" required />
                    </div>
                    <div class="form-check mb-3">
                        <input name="IsScheduledMedication" type="checkbox" class="form-check-input" id="isScheduled" value="true" />
                        <label class="form-check-label" for="isScheduled">Scheduled Medication</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Search Filter -->
    <script>
        const searchInput = document.getElementById('searchInput');
        const medicationTableBody = document.getElementById('medicationTableBody');
        let allMedicationRows = Array.from(medicationTableBody.querySelectorAll('.medication-row'));
        let filteredMedicationRows = [...allMedicationRows];

        function performSearch() {
            const query = searchInput.value.toLowerCase();

            filteredMedicationRows = allMedicationRows.filter(row => {
                const nameText = row.children[0].textContent.toLowerCase();
                const quantityText = row.children[1].textContent.toLowerCase();
                const scheduledText = row.children[2].textContent.toLowerCase();
                return nameText.includes(query) || quantityText.includes(query) || scheduledText.includes(query);
            });

            displayPage(1);
        }

        searchInput.addEventListener('keyup', performSearch);
    </script>

    <script>
        const sortSelect = document.getElementById('sortSelect');
        const rowsPerPage = 9;
        let currentPage = 1;

        function displayPage(page) {
            currentPage = page;
            const start = (page - 1) * rowsPerPage;
            const end = start + rowsPerPage;

            // Hide all rows first
            allMedicationRows.forEach(row => row.style.display = 'none');

            // Show only filtered rows for current page
            filteredMedicationRows.forEach((medicationRow, index) => {
                if (index >= start && index < end) {
                    medicationRow.style.display = '';
                }
            });

            renderPagination();
        }

        function renderPagination() {
            const paginationContainer = document.getElementById('medicationPagination');
            paginationContainer.innerHTML = '';
            const totalPages = Math.ceil(filteredMedicationRows.length / rowsPerPage);

            if (totalPages > 1) {
                // Previous button
                if (currentPage > 1) {
                    const prevBtn = document.createElement('button');
                    prevBtn.className = 'btn btn-sm btn-outline-primary me-1';
                    prevBtn.innerHTML = '<i class="bi bi-chevron-left"></i>';
                    prevBtn.addEventListener('click', () => displayPage(currentPage - 1));
                    paginationContainer.appendChild(prevBtn);
                }

                // Page buttons
                for (let i = 1; i <= totalPages; i++) {
                    const btn = document.createElement('button');
                    btn.className = 'btn btn-sm me-1 ' + (i === currentPage ? 'btn-primary' : 'btn-outline-primary');
                    btn.innerText = i;
                    btn.addEventListener('click', () => displayPage(i));
                    paginationContainer.appendChild(btn);
                }

                // Next button
                if (currentPage < totalPages) {
                    const nextBtn = document.createElement('button');
                    nextBtn.className = 'btn btn-sm btn-outline-primary me-1';
                    nextBtn.innerHTML = '<i class="bi bi-chevron-right"></i>';
                    nextBtn.addEventListener('click', () => displayPage(currentPage + 1));
                    paginationContainer.appendChild(nextBtn);
                }
            }
        }

        function sortTable(sortValue) {
            const [column, direction] = sortValue.split('-');
            const isAsc = direction === 'asc';

            filteredMedicationRows.sort((a, b) => {
                let aValue, bValue;

                switch (column) {
                    case 'name':
                        aValue = a.children[0].textContent.trim().toLowerCase();
                        bValue = b.children[0].textContent.trim().toLowerCase();
                        break;
                    case 'quantity':
                        aValue = parseInt(a.children[1].textContent) || 0;
                        bValue = parseInt(b.children[1].textContent) || 0;
                        break;
                    case 'scheduled':
                        aValue = a.children[2].textContent.trim().toLowerCase();
                        bValue = b.children[2].textContent.trim().toLowerCase();
                        // Convert "yes"/"no" to boolean for proper sorting
                        aValue = aValue === 'yes' ? 1 : 0;
                        bValue = bValue === 'yes' ? 1 : 0;
                        break;
                    default:
                        aValue = a.children[0].textContent.trim().toLowerCase();
                        bValue = b.children[0].textContent.trim().toLowerCase();
                }

                if (aValue < bValue) return isAsc ? -1 : 1;
                if (aValue > bValue) return isAsc ? 1 : -1;
                return 0;
            });

            filteredMedicationRows.forEach(medicationRow => {
                medicationTableBody.appendChild(medicationRow);
            });

            displayPage(1);
        }

        sortSelect.addEventListener('change', function() {
            sortTable(this.value);
        });

        sortTable('name-asc');
        displayPage(1);
    </script>

    <!-- Toast Messages -->
    <script>
        function showToast(type, message) {
            if (!message) return;
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: type,
                title: message,
                showConfirmButton: false,
                timer: 3000
            });
        }

        // Success message
        var successMessage = @Html.Raw(Json.Serialize(TempData["SuccessMessage"] ?? ""));
        if (successMessage) showToast('success', successMessage);

        // Error message
        var errorMessage = @Html.Raw(Json.Serialize(TempData["ErrorMessage"] ?? ""));
        if (errorMessage) showToast('error', errorMessage);

        @if (!ViewData.ModelState.IsValid)
        {
                foreach (var modelState in ViewData.ModelState.Values)
                {
                        foreach (var error in modelState.Errors)
                        {
                                <text>
                                    showToast('error', '@error.ErrorMessage');
                                </text>
                        }
                }
        }
    </script>
}