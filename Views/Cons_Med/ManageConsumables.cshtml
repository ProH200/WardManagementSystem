@model IEnumerable<Wellness_Wardens_Project.Models.AdministrationSubsystem.Consumable>

@{
    ViewData["Title"] = "Manage Consumables";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/admin.css" rel="stylesheet" />
<link href="~/css/helpanimation.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-box-seam me-2"></i>Consumables</h2>
        <div>
            <a asp-controller="Administration" asp-action="Dashboard" class="btn btn-outline-primary me-2">
                <i class="bi bi-house-door me-1"></i> Dashboard
            </a>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addConsumableModal">
                <i class="bi bi-plus-circle me-1"></i> Add Consumable
            </button>
        </div>
    </div>

    <input class="form-control mb-3" id="searchInput" placeholder="Search consumables..." />

    <div class="table-responsive">
        <table class="table table-hover align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Quantity Available</th>
                    <th>Ward</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="consumablesTable">
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.QuantityAvailable</td>
                        <td>@item.Ward?.Name</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-primary me-2"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editConsumableModal"
                                    data-id="@item.ConsumableId"
                                    data-name="@item.Name"
                                    data-quantity="@item.QuantityAvailable"
                                    data-ward-id="@item.WardId">
                                <i class="bi bi-pencil-square"></i> Edit
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.ConsumableId">
                                <i class="bi bi-trash3-fill"></i> Delete
                            </button>
                        </td>
                    </tr>

                    <!-- Delete Confirmation Modal -->
                    <div class="modal fade" id="deleteModal-@item.ConsumableId" tabindex="-1"
                         aria-labelledby="deleteModalLabel-@item.ConsumableId" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form asp-action="SoftDeleteConsumable" method="post">
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", item.ConsumableId)

                                    <div class="modal-header bg-danger text-white">
                                        <h5 class="modal-title">
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Consumable
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>

                                    <div class="modal-body">
                                        <p class="fw-bold">Are you sure you want to delete this consumable?</p>
                                        <ul class="list-group">
                                            <li class="list-group-item"><strong>Name:</strong> @item.Name</li>
                                            <li class="list-group-item"><strong>Quantity:</strong> @item.QuantityAvailable</li>
                                            <li class="list-group-item"><strong>Ward:</strong> @item.Ward?.Name</li>
                                        </ul>
                                    </div>

                                    <div class="modal-footer">
                                        <button type="submit" class="btn btn-danger">Yes, Delete</button>
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </tbody>

        </table>
    </div>
</div>

<!-- Add Consumable Modal -->
<div class="modal fade" id="addConsumableModal" tabindex="-1" aria-labelledby="addConsumableModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4">
            <div class="modal-header text-white" style="background-color: #637274;">
                <h5 class="modal-title" id="addConsumableModalLabel"><i class="bi bi-plus-circle me-2"></i>Add Consumable</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="addConsumableForm" asp-action="AddConsumable" asp-controller="Cons_Med" method="post" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Name Field -->
                    <div class="mb-3 position-relative">
                        <label class="form-label fw-bold">Name:</label>
                        <input type="text" name="Name" id="newConsumableName" class="form-control"
                               placeholder="Enter consumable name"
                               pattern="^[A-Za-z0-9\s\-&.,()]+$"
                               minlength="2"
                               maxlength="100"
                               required />
                        <div class="invalid-feedback">
                            Please enter a valid consumable name.
                        </div>
                    </div>

                    <!-- Quantity Field -->
                    <div class="mb-3 position-relative">
                        <label class="form-label fw-bold">Quantity:</label>
                        <input type="number" name="QuantityAvailable" id="newConsumableQuantity" class="form-control"
                               min="0"
                               max="1000000"
                               step="1"
                               required />
                        <div class="invalid-feedback">
                            Please enter a valid quantity.
                        </div>
                    </div>

                    <!-- Ward Field -->
                    <div class="mb-3 position-relative">
                        <label class="form-label fw-bold">Ward:</label>
                        <select name="WardId" class="form-select" id="newConsumableWard" required>
                            <option value="">-- Select Ward --</option>
                            @foreach (var ward in ViewBag.Wards)
                            {
                                <option value="@ward.WardId">@ward.Name</option>
                            }
                        </select>
                        <div class="invalid-feedback">
                            Please select a ward.
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </button>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check2-circle me-1"></i> Add Consumable
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Consumable Modal -->
<div class="modal fade" id="editConsumableModal" tabindex="-1" aria-labelledby="editConsumableModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4">
            <div class="modal-header text-white" style="background-color: #637274;">
                <h5 class="modal-title" id="editConsumableModalLabel"><i class="bi bi-pencil-square me-2"></i>Edit Consumable</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-action="EditConsumable" asp-controller="Cons_Med" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editConsumableId" name="ConsumableId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Name:</label>
                        <input type="text" name="Name" id="editConsumableName" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Quantity:</label>
                        <input type="number" name="QuantityAvailable" id="editConsumableQuantity" class="form-control" min="0" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Ward:</label>
                        <select name="WardId" class="form-select" id="editConsumableWard">
                            <option value="">-- Select Ward --</option>
                            @foreach (var ward in ViewBag.Wards)
                            {
                                <option value="@ward.WardId">@ward.Name</option>
                            }
                        </select>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check2-circle me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<div id="doctor-note" role="alert" aria-live="polite" aria-atomic="true" title="Need help? Click the '?' on the bottom right.">
    <!-- Simple cartoon doctor SVG -->
    <svg xmlns="http://www.w3.org/2000/svg" fill="#0d6efd" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <circle cx="32" cy="14" r="12" fill="#0d6efd" />
        <rect x="18" y="26" width="28" height="30" rx="8" ry="8" fill="#0d6efd" />
        <rect x="28" y="34" width="8" height="12" fill="#f8f9fa" />
        <line x1="32" y1="20" x2="32" y2="14" stroke="#f8f9fa" stroke-width="2" />
        <line x1="28" y1="24" x2="36" y2="24" stroke="#f8f9fa" stroke-width="2" />
    </svg>

    <p>If you are unsure about anything,<br>please click the small '?' bellow.</p>
</div>


@section Scripts {
    <script>
        const searchInput = document.getElementById('searchInput');
        const tableRows = document.querySelectorAll('#consumablesTable tr');

        searchInput.addEventListener('keyup', function () {
            const query = this.value.toLowerCase();
            tableRows.forEach(row => {
                const cells = row.querySelectorAll('td');
                const match = Array.from(cells).some(td => td.textContent.toLowerCase().includes(query));
                row.style.display = match ? '' : 'none';
            });
        });
    </script>

    <script>
        var editModal = document.getElementById('editConsumableModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;

            var id = button.getAttribute('data-id');
            var name = button.getAttribute('data-name');
            var quantity = button.getAttribute('data-quantity');
            var wardId = button.getAttribute('data-ward-id');

            document.getElementById('editConsumableId').value = id;
            document.getElementById('editConsumableName').value = name;
            document.getElementById('editConsumableQuantity').value = quantity;
            document.getElementById('editConsumableWard').value = wardId;
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function showToast(type, message) {
            if (!message) return;
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: type,
                title: message,
                showConfirmButton: false,
                timer: 3000
            });
        }

        var successMessage = @Html.Raw(Json.Serialize(TempData["SuccessMessage"] ?? ""));
        if (successMessage) {
            showToast('success', successMessage);
        }

        @foreach (var modelState in ViewData.ModelState.Values)
        {
                foreach (var error in modelState.Errors)
                {
                        <text>
                            showToast('error', @Html.Raw(Json.Serialize(error.ErrorMessage)));
                        </text>
                }
        }
    </script>
    <script>
                // Add Consumable Modal Validation
        (function () {
            'use strict';

            // Initialize when modal is shown
            const addConsumableModal = document.getElementById('addConsumableModal');
            if (addConsumableModal) {
                addConsumableModal.addEventListener('show.bs.modal', function () {
                    // Add real-time validation for all fields
                    const nameInput = document.getElementById('newConsumableName');
                    const quantityInput = document.getElementById('newConsumableQuantity');
                    const wardSelect = document.getElementById('newConsumableWard');

                    if (nameInput) {
                        nameInput.addEventListener('input', validateConsumableName);
                        nameInput.addEventListener('blur', validateConsumableName);
                    }

                    if (quantityInput) {
                        quantityInput.addEventListener('input', validateQuantity);
                        quantityInput.addEventListener('blur', validateQuantity);
                    }

                    if (wardSelect) {
                        wardSelect.addEventListener('change', validateWard);
                        wardSelect.addEventListener('blur', validateWard);
                    }
                });

                // Clear validation when modal is hidden
                addConsumableModal.addEventListener('hidden.bs.modal', function () {
                    const form = document.getElementById('addConsumableForm');
                    if (form) {
                        form.classList.remove('was-validated');
                        form.reset();
                    }

                    // Remove event listeners and clear validation states
                    const inputs = form.querySelectorAll('input, select');
                    inputs.forEach(input => {
                        input.removeEventListener('input', validateField);
                        input.removeEventListener('blur', validateField);
                        input.classList.remove('is-valid', 'is-invalid');
                    });
                });
            }

            // Consumable Name validation
            function validateConsumableName() {
                const input = this;
                const value = input.value.trim();
                const pattern = /^[A-Za-z0-9\s\-&.,()]+$/;

                if (value.length < 2) {
                    input.setCustomValidity('Consumable name must be at least 2 characters long.');
                } else if (value.length > 100) {
                    input.setCustomValidity('Consumable name cannot exceed 100 characters.');
                } else if (!pattern.test(value)) {
                    input.setCustomValidity('Consumable name can only contain letters, numbers, spaces, hyphens, &, ., ,, ().');
                } else {
                    input.setCustomValidity('');
                }
                updateValidationState(input);
            }

            // Quantity validation
            function validateQuantity() {
                const input = this;
                const value = parseInt(input.value);

                if (isNaN(value) || value < 0) {
                    input.setCustomValidity('Quantity must be a number greater than or equal to 0.');
                } else if (value > 1000000) {
                    input.setCustomValidity('Quantity cannot exceed 1,000,000.');
                } else {
                    input.setCustomValidity('');
                }
                updateValidationState(input);
            }

            // Ward validation
            function validateWard() {
                const input = this;
                const value = input.value;

                if (value === "" || value === null) {
                    input.setCustomValidity('Please select a ward.');
                } else {
                    input.setCustomValidity('');
                }
                updateValidationState(input);
            }

            // Update visual validation state
            function updateValidationState(input) {
                const isValid = input.checkValidity();

                if (input.type === 'select-one' && input.value === "") {
                    input.classList.remove('is-valid', 'is-invalid');
                } else if (input.value === "" && !input.required) {
                    input.classList.remove('is-valid', 'is-invalid');
                } else if (isValid) {
                    input.classList.remove('is-invalid');
                    input.classList.add('is-valid');
                } else {
                    input.classList.remove('is-valid');
                    input.classList.add('is-invalid');
                }
            }

            // Add form submission validation
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();

                        // Trigger validation for all fields on submit
                        const nameInput = document.getElementById('newConsumableName');
                        const quantityInput = document.getElementById('newConsumableQuantity');
                        const wardSelect = document.getElementById('newConsumableWard');

                        if (nameInput) validateConsumableName.call(nameInput);
                        if (quantityInput) validateQuantity.call(quantityInput);
                        if (wardSelect) validateWard.call(wardSelect);
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}
