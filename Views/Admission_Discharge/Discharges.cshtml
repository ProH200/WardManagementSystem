@model IEnumerable<Wellness_Wardens_Project.Models.PatientManagementSubsystem.PatientAdmission>

@{
    ViewData["Title"] = "Discharged Patients";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #CAD5E2;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #212529;
    }

    .discharge-card {
        background-color: #D3DCE6;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .discharge-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.1);
        }

        .discharge-card h5 {
            margin-bottom: 0.2rem;
        }

        .discharge-card small {
            font-size: 0.85rem;
        }

        .discharge-card .text-secondary span {
            display: block;
        }

    .search-bar {
        background-color: #CAD5E2;
    }
</style>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-box-arrow-in-down-right me-2"></i> Discharged Patients
            </h2>
            <p class="text-muted mb-0">
                View all patients who have been discharged, with ward and staff details.
            </p>
        </div>
        <a asp-action="WardAdminDashboard" asp-controller="Administration"
           class="btn btn-outline-secondary shadow-sm rounded-pill px-4">
            <i class="bi bi-speedometer2 me-2"></i> Dashboard
        </a>
    </div>

    <!-- Controls Section -->
    <div class="row mb-4">
        <div class="col-md-6">
            <!-- Search -->
            <div class="input-group shadow search-bar">
                <span class="input-group-text bg-transparent border-0"><i class="bi bi-search"></i></span>
                <input type="text" id="dischargeSearch" class="form-control border-0 bg-transparent"
                       placeholder="Search discharged patients by name, ward, room, or staff..." />
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex justify-content-end">
                <!-- Sort Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="sortDropdown" data-bs-toggle="dropdown">
                        <i class="bi bi-sort-alpha-down me-1"></i> Sort By
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item sort-option" href="#" data-sort="discharge-desc">Discharge Date (Newest First)</a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="discharge-asc">Discharge Date (Oldest First)</a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="name-asc">Patient Name (A-Z)</a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="name-desc">Patient Name (Z-A)</a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="ward-asc">Ward Name (A-Z)</a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="staff-asc">Staff Name (A-Z)</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Discharged List -->
    <div id="dischargeList" class="d-flex flex-column gap-3">
        @foreach (var admission in Model)
        {
            <div class="discharge-card p-4 rounded-3 shadow-sm d-flex justify-content-between align-items-center"
                 data-name="@admission.Patient?.FirstName?.ToLower() @admission.Patient?.LastName?.ToLower()"
                 data-discharge="@admission.Discharges.Max(d => d.DischargeDate).ToString("yyyyMMdd")"
                 data-ward="@admission.Bed?.Room?.Ward?.Name?.ToLower()"
                 data-staff="@admission.AssignedEmployee?.LastName?.ToLower()">

                <!-- Patient Info -->
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center"
                         style="width:50px; height:50px; font-size:1.2rem;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold">@admission.Patient?.FirstName @admission.Patient?.LastName</h5>
                        <small class="text-muted">
                            <i class="bi bi-envelope me-1"></i>@admission.Patient?.Email
                        </small>
                        <div class="mt-2 small text-secondary">
                            <i class="bi bi-calendar-event me-1"></i> Discharged: @(admission.Discharges.Max(d => d.DischargeDate).ToString("dd MMM yyyy"))
                        </div>
                    </div>
                </div>

                <!-- Ward & Staff -->
                <div class="d-flex flex-column text-secondary small">
                    <span><i class="bi bi-building me-1"></i> Ward: <strong>@(admission.Bed?.Room?.Ward?.Name ?? "-")</strong></span>
                    <span><i class="bi bi-door-closed me-1"></i> Room: <strong>@(admission.Bed?.Room?.RoomNumber ?? "-")</strong></span>
                    <span><i class="bi bi-hash me-1"></i> Bed: <strong>@(admission.Bed?.BedNumber ?? "-")</strong></span>
                    <span>
                        <i class="bi bi-person-badge me-1"></i> Staff:
                        @if (admission.AssignedEmployee != null)
                        {
                            @($"{admission.AssignedEmployee.Title} {admission.AssignedEmployee.LastName}")
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </span>
                </div>
                <div class="d-flex m-0">
                    <a asp-action="Details"
                       asp-route-id="@(admission.AdmissionId != 0 ? admission.AdmissionId : (int?)null)"
                       asp-route-patientId="@(admission.AdmissionId == 0 ? admission.Patient.PatientId : (int?)null)"
                       class="btn btn-sm btn-outline-primary rounded-circle"
                       title="View Patient Folder">
                        <i class="bi bi-eye"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const searchInput = document.getElementById('dischargeSearch');
        const dischargeCards = document.querySelectorAll('.discharge-card');

        function showToast(type, message) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: type,
                title: message,
                showConfirmButton: false,
                timer: 2500,
                timerProgressBar: true
            });
        }

        // Search functionality
        searchInput.addEventListener('keyup', function () {
            const query = this.value.toLowerCase().trim();
            let matchFound = false;

            dischargeCards.forEach(card => {
                const nameText = card.querySelector('h5.fw-bold').innerText.toLowerCase();
                const wardText = card.querySelector('span i.bi-building')?.parentElement.innerText.toLowerCase() || '';
                const roomText = card.querySelector('span i.bi-door-closed')?.parentElement.innerText.toLowerCase() || '';
                const bedText = card.querySelector('span i.bi-hash')?.parentElement.innerText.toLowerCase() || '';
                const staffText = card.querySelector('span i.bi-person-badge')?.parentElement.innerText.toLowerCase() || '';

                const isMatch = nameText.includes(query) || wardText.includes(query) || roomText.includes(query)
                                || bedText.includes(query) || staffText.includes(query);

                card.style.display = isMatch ? 'flex' : 'none';
                if (isMatch) matchFound = true;
            });

            if (!matchFound && query !== "") {
                showToast('warning', 'No discharged patients found.');
            }
        });

        // Sorting functionality
        document.querySelectorAll('.sort-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                const sortType = this.getAttribute('data-sort');
                sortDischarges(sortType);

                const dropdownButton = document.getElementById('sortDropdown');
                const icon = dropdownButton.querySelector('i');
                dropdownButton.innerHTML = icon.outerHTML + ' ' + this.textContent;
            });
        });

        function sortDischarges(sortType) {
            const container = document.getElementById('dischargeList');
            const items = Array.from(container.querySelectorAll('.discharge-card'));

            items.sort((a, b) => {
                switch(sortType) {
                    case 'discharge-desc':
                        return (b.getAttribute('data-discharge') || '').localeCompare(a.getAttribute('data-discharge') || '');
                    case 'discharge-asc':
                        return (a.getAttribute('data-discharge') || '').localeCompare(b.getAttribute('data-discharge') || '');
                    case 'name-asc':
                        return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
                    case 'name-desc':
                        return (b.getAttribute('data-name') || '').localeCompare(a.getAttribute('data-name') || '');
                    case 'ward-asc':
                        return (a.getAttribute('data-ward') || '').localeCompare(b.getAttribute('data-ward') || '');
                    case 'staff-asc':
                        return (a.getAttribute('data-staff') || '').localeCompare(b.getAttribute('data-staff') || '');
                    default:
                        return 0;
                }
            });

            items.forEach(item => container.appendChild(item));
        }
    </script>
}