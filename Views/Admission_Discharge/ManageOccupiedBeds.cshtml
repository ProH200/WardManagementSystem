@model IEnumerable<Wellness_Wardens_Project.Models.AdministrationSubsystem.Bed>

@{
    ViewData["Title"] = "Occupied Beds";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #CAD5E2; 
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #212529;
        margin: 0;
        padding: 0;
    }

    .bed-card {
        background-color: #D3DCE6;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .bed-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.1);
        }

        .bed-card h5 {
            margin-bottom: 0.2rem;
        }

        .bed-card small {
            font-size: 0.85rem;
        }

    .badge-status {
        font-size: 0.85rem;
    }

    .search-bar {
        background-color: #CAD5E2;
    }
</style>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-door-closed me-2"></i> Occupied Beds
            </h2>
            <p class="text-muted mb-0">
                View all beds that are currently occupied by patients.
            </p>
        </div>
        <a asp-action="WardAdminDashboard" asp-controller="Administration"
           class="btn btn-outline-secondary shadow-sm rounded-pill px-4">
            <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <!-- Search bar -->
            <div class="input-group shadow search-bar">
                <span class="input-group-text bg-transparent border-0"><i class="bi bi-search"></i></span>
                <input type="text" id="bedSearch" class="form-control border-0 bg-transparent"
                       placeholder="Search by bed number, room, ward, patient name, or staff..." />
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex justify-content-end">
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="sortDropdown" data-bs-toggle="dropdown">
                        <i class="bi bi-sort-alpha-down me-1"></i> Sort By
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item sort-option" href="#" data-sort="ward-asc">Ward Name (A-Z)</a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="patient-asc">Patient Name (A-Z)</a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="patient-desc">Patient Name (Z-A)</a></li>
                        <li><a class="dropdown-item sort-option" href="#" data-sort="staff-asc">Staff Name (A-Z)</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Beds List -->
    <div id="bedsList" class="d-flex flex-column gap-3">
        @foreach (var bed in Model)
        {
            var activeAdmission = bed.PatientAdmissions?.FirstOrDefault();

            <div class="bed-card p-4 rounded-3 shadow-sm d-flex justify-content-between align-items-center"
                 data-bed="@bed.BedNumber"
                 data-room="@(bed.Room?.RoomNumber ?? "")"
                 data-ward="@(bed.Room?.Ward?.Name?.ToLower() ?? "")"
                 data-patient="@(activeAdmission?.Patient?.FirstName?.ToLower() ?? "") @(activeAdmission?.Patient?.LastName?.ToLower() ?? "")"
                 data-staff="@(activeAdmission?.AssignedEmployee?.LastName?.ToLower() ?? "")">

                <div>
                    <h5 class="fw-bold">Bed #: @bed.BedNumber</h5>
                    <small class="text-muted">
                        Room: @(bed.Room?.RoomNumber ?? "-") | Ward: @(bed.Room?.Ward?.Name ?? "-")
                    </small>
                    @if (activeAdmission?.AssignedEmployee != null)
                    {
                        <small class="text-muted d-block mt-1">
                            Assigned Staff: <strong>@activeAdmission.AssignedEmployee.Title @activeAdmission.AssignedEmployee.LastName</strong>
                        </small>
                    }
                </div>
                <div class="text-end">
                    @if (activeAdmission != null)
                    {
                        <h5 class="fw-bold">@activeAdmission.Patient?.FirstName @activeAdmission.Patient?.LastName</h5>
                        <small class="text-muted">@activeAdmission.Patient?.Email</small>
                        <div class="mt-1">
                            <span class="badge bg-warning text-dark badge-status">Occupied</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const searchInput = document.getElementById('bedSearch');
        const bedCards = document.querySelectorAll('.bed-card');

        function showToast(type, message) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: type,
                title: message,
                showConfirmButton: false,
                timer: 2500,
                timerProgressBar: true
            });
        }

        searchInput.addEventListener('keyup', function () {
            const query = this.value.toLowerCase().trim();
            let matchFound = false;

            bedCards.forEach(card => {
                const text = card.textContent.toLowerCase();
                const isMatch = text.includes(query);
                card.style.display = isMatch ? 'flex' : 'none';
                if (isMatch) matchFound = true;
            });

            if (!matchFound && query !== "") {
                showToast('warning', 'No occupied beds found matching your search.');
            }
        });

        document.querySelectorAll('.sort-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                const sortType = this.getAttribute('data-sort');
                sortBeds(sortType);

                const dropdownButton = document.getElementById('sortDropdown');
                const icon = dropdownButton.querySelector('i');
                dropdownButton.innerHTML = icon.outerHTML + ' ' + this.textContent;
            });
        });

        function sortBeds(sortType) {
            const container = document.getElementById('bedsList');
            const items = Array.from(container.querySelectorAll('.bed-card'));

            items.sort((a, b) => {
                switch(sortType) {
                    case 'bed-asc':
                        return parseInt(a.getAttribute('data-bed')) - parseInt(b.getAttribute('data-bed'));
                    case 'bed-desc':
                        return parseInt(b.getAttribute('data-bed')) - parseInt(a.getAttribute('data-bed'));
                    case 'room-asc':
                        return (a.getAttribute('data-room') || '').localeCompare(b.getAttribute('data-room') || '');
                    case 'room-desc':
                        return (b.getAttribute('data-room') || '').localeCompare(a.getAttribute('data-room') || '');
                    case 'ward-asc':
                        return (a.getAttribute('data-ward') || '').localeCompare(b.getAttribute('data-ward') || '');
                    case 'patient-asc':
                        return (a.getAttribute('data-patient') || '').localeCompare(b.getAttribute('data-patient') || '');
                    case 'patient-desc':
                        return (b.getAttribute('data-patient') || '').localeCompare(a.getAttribute('data-patient') || '');
                    case 'staff-asc':
                        return (a.getAttribute('data-staff') || '').localeCompare(b.getAttribute('data-staff') || '');
                    default:
                        return 0;
                }
            });

            items.forEach(item => container.appendChild(item));
        }
    </script>
}