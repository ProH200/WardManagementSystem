@model IEnumerable<Wellness_Wardens_Project.Models.PatientManagementSubsystem.PatientAdmission>

@{
    ViewData["Title"] = "Patient Admissions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    body {
        background-color: #CAD5E2; /* Soft body background */
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #212529;
        margin: 0;
        padding: 0;
    }

    .admission-item {
        background-color: #D3DCE6; /* Slightly lighter than body */
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .admission-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
        }

        .admission-item .badge {
            font-size: 0.85rem;
        }

        .admission-item h5 {
            margin-bottom: 0.2rem;
        }

        .admission-item small {
            font-size: 0.85rem;
        }

        .admission-item .text-secondary span {
            display: block;
        }
</style>

<div class="container mt-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        @if (User.IsInRole("Ward Admin"))
        {
            <div>
                <h2 class="fw-bold text-primary mb-1">
                    <i class="bi bi-hospital me-2"></i> Patient Admissions
                </h2>
                <p class="text-muted mb-0">
                    Manage ward allocations, admission tracking, and assigned staff efficiently.
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="WardAdminDashboard" asp-controller="Administration"
                   class="btn btn-outline-secondary shadow-sm rounded-pill px-4">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
                <a asp-action="SelectPatient"
                   class="btn btn-primary shadow-sm rounded-pill px-4">
                    <i class="bi bi-plus-circle me-2"></i> New Admission
                </a>
            </div>
        }
        else
        {
            <div>
                <h2 class="fw-bold text-primary mb-1">
                    <i class="bi bi-folder2-open me-2"></i> Patient Folder
                </h2>
                <p class="text-muted mb-0">
                    Review patient admission history and monitor discharge details with ease.
                </p>
            </div>
            <a asp-action="Dashboard" asp-controller="Administration"
               class="btn btn-outline-secondary shadow-sm rounded-pill px-4">
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
        }
    </div>


    <!-- Search bar -->
    <div class="input-group mb-4 shadow" style="background-color:#CAD5E2;">
        <span class="input-group-text bg-transparent border-0"><i class="bi bi-search"></i></span>
        <input type="text" id="admissionSearch" class="form-control border-0 bg-transparent"
               placeholder="Search patients by name, ward, room, bed, or staff..." />
    </div>


    <!-- Admissions List -->
    <div id="admissionList" class="d-flex flex-column gap-3">
        @foreach (var admission in Model)
        {
            <div class="admission-item p-4 rounded-3 shadow-sm d-flex justify-content-between align-items-center">

                <!-- Left: Patient Details -->
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center"
                         style="width:50px; height:50px; font-size:1.2rem;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                        <h5 class="mb-1 fw-bold">@admission.Patient?.FirstName @admission.Patient?.LastName</h5>
                        <small class="text-muted">
                            <i class="bi bi-envelope me-1"></i>@(admission.Patient?.Email ?? "N/A")
                        </small>
                        <div class="mt-2 small text-secondary">
                            <i class="bi bi-calendar-event me-1"></i> @(admission.AdmissionDate?.ToString("dd MMM yyyy") ?? "-") <br />
                            <i class="bi bi-clipboard-check me-1"></i> @(admission.Reason ?? "-")
                        </div>
                    </div>
                </div>

                <!-- Middle: Allocation Details -->
                <div class="d-flex flex-column text-secondary small">
                    <span><i class="bi bi-building me-1"></i> Ward: <strong>@(admission.Bed?.Room?.Ward?.Name ?? "-")</strong></span>
                    <span><i class="bi bi-door-closed me-1"></i> Room: <strong>@(admission.Bed?.Room?.RoomNumber ?? "-")</strong></span>
                    <span><i class="bi bi-hash me-1"></i> Bed: <strong>@(admission.Bed?.BedNumber ?? "-")</strong></span>
                    <span>
                        <i class="bi bi-person-badge me-1"></i> Staff:
                        @if (admission.AssignedEmployee != null)
                        {
                            @($"{admission.AssignedEmployee.Title} {admission.AssignedEmployee.LastName}")
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </span>
                </div>

                <!-- Right: Status + Actions -->
                <div class="d-flex flex-column align-items-end">
                    <span class="badge rounded-pill px-3 py-2 mb-2 @(admission.Discharges?.Any() == true ? "bg-success" : "bg-warning text-dark")">
                        @(admission.Discharges?.Any() == true ? "Discharged" : (admission.AdmissionDate != null ? "Admitted" : "Not Admitted"))
                    </span>

                    <div class="d-flex gap-2">
                        @if (User.IsInRole("Ward Admin") && admission.AdmissionDate != null)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary rounded-circle"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editAdmissionModal"
                                    data-id="@admission.AdmissionId"
                                    title="Edit Admission">
                                <i class="bi bi-pencil"></i>
                            </button>
                        }
                        <a asp-action="Details"
                           asp-route-id="@(admission.AdmissionId != 0 ? admission.AdmissionId : (int?)null)"
                           asp-route-patientId="@(admission.AdmissionId == 0 ? admission.Patient.PatientId : (int?)null)"
                           class="btn btn-sm btn-outline-primary rounded-circle"
                           title="View Patient Folder">
                            <i class="bi bi-eye"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


<div class="modal fade" id="editAdmissionModal" tabindex="-1" aria-labelledby="editAdmissionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="editAdmissionModalLabel"><i class="bi bi-pencil-square me-2"></i>Edit Admission</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="editAdmissionFormContainer">
                <!-- Form will load via PartialView -->
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3 text-muted">Loading admission details...</p>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
       const searchInput = document.getElementById('admissionSearch');
       const admissionItems = document.querySelectorAll('.admission-item');

    function showToast(type, message) {
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: type,
            title: message,
            showConfirmButton: false,
            timer: 2500,
            timerProgressBar: true
        });
    }

    searchInput.addEventListener('keyup', function () {
        const query = this.value.toLowerCase().trim();
        let matchFound = false;

        admissionItems.forEach(item => {
            // Get the patient name element
            const nameElement = item.querySelector('h5.fw-bold');
            if (nameElement) {
                const nameText = nameElement.innerText.toLowerCase();
                const isMatch = nameText.includes(query);
                item.style.display = isMatch ? 'flex' : 'none';
                if (isMatch) matchFound = true;
            }
        });

        // Show toast if nothing found
        if (!matchFound && query !== "") {
            showToast('warning', 'No patients found matching your search.');
        }
    });
    </script>

    <!-- Edit Admission Modal (no toast here) -->
    <script>
               // Edit Admission Modal (fixed controller path)
        const editModal = document.getElementById('editAdmissionModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const admissionId = button.getAttribute('data-id');
            const container = document.getElementById('editAdmissionFormContainer');

            container.innerHTML = `
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3 text-muted">Loading admission details...</p>
                </div>`;

            fetch(`/Admission_Discharge/EditAdmission/${admissionId}`)
                .then(res => res.text())
                .then(html => container.innerHTML = html)
                .catch(() => container.innerHTML = `<div class="alert alert-danger">Failed to load form.</div>`);
        });
    </script>

    <!-- TempData Toasts after full-page reload -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const successMessage = '@TempData["SuccessMessage"]';
            const errorMessage = '@TempData["ErrorMessage"]';

            if (successMessage) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: successMessage,
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            }

            if (errorMessage) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: errorMessage,
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            }
        });
    </script>
}
