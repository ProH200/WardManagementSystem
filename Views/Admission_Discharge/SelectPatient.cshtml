@model Wellness_Wardens_Project.ViewModels.PatientManagementSubsystem.PatientAdmissionViewModel

@{
    ViewData["Title"] = "Patient Admission";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #CAD5E2;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #212529;
        margin: 0;
        padding: 0;
    }

    .card {
        background-color: #D6E0EB;
    }

        .card input, .card select, .card textarea {
            background-color: #E0E8F0;
            border: 1px solid #B0C4D0;
            border-radius: 6px;
        }

            .card input:focus, .card select:focus, .card textarea:focus {
                background-color: #EDF2F7;
                border-color: #0d6efd;
                box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
            }

    .btn {
        min-width: 120px;
    }

    .required-asterisk {
        color: #dc3545;
        font-weight: bold;
        margin-left: 2px;
    }

    .form-label.required::after {
        content: " *";
        color: #dc3545;
        font-weight: bold;
    }
</style>

<div class="container mt-5">
    <div class="card shadow-sm p-4">
        <h3 class="mb-4">Patient Admission</h3>

        <!-- Step 1: Select Patient -->
        <div id="selectPatientStep">
            <div class="mb-3 position-relative">
                <label class="form-label fw-bold required">Select Patient</label>
                <select id="patientSelect" class="form-select" required>
                    <option value="">-- Select Patient --</option>
                    @foreach (var patient in ViewBag.Patients)
                    {
                        <option value="@patient.Value" data-name="@patient.Text">@patient.Text</option>
                    }
                </select>
                <div class="invalid-feedback">
                    Please select a patient.
                </div>
            </div>
            <div class="d-flex">
                <a asp-controller="Admission_Discharge" asp-action="Admissions" class="btn btn-secondary me-3">Cancel</a>
                <button type="button" id="nextStepBtn" class="btn btn-primary">Next</button>
            </div>
        </div>

        <!-- Step 2: Admission Form -->
        <div id="admissionFormStep" style="display:none; margin-top:20px;">
            <h5 class="mb-3">Admit Patient: <span id="selectedPatientName"></span></h5>
            <form asp-action="AdmitPatient" method="post" id="admitPatientForm" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="PatientId" name="PatientId" required />

                <div class="mb-3 position-relative">
                    <label class="form-label fw-bold required">Ward</label>
                    <select id="wardSelect" name="WardId" class="form-select" required>
                        <option value="">-- Select Ward --</option>
                        @foreach (var ward in ViewBag.Wards)
                        {
                            <option value="@ward.Value">@ward.Text</option>
                        }
                    </select>
                    <div class="invalid-feedback">
                        Please select a ward.
                    </div>
                </div>

                <div class="mb-3 position-relative">
                    <label class="form-label fw-bold required">Room</label>
                    <select id="roomSelect" name="RoomId" class="form-select" required>
                        <option value="">-- Select Room --</option>
                    </select>
                    <div class="invalid-feedback">
                        Please select a room.
                    </div>
                </div>

                <div class="mb-3 position-relative">
                    <label class="form-label fw-bold required">Bed</label>
                    <select id="bedSelect" name="BedId" class="form-select" required>
                        <option value="">-- Select Bed --</option>
                    </select>
                    <div class="invalid-feedback">
                        Please select a bed.
                    </div>
                </div>

                <div class="mb-3 position-relative">
                    <label class="form-label fw-bold required">Assign Doctor/Nurse</label>
                    <select asp-for="EmployeeId" asp-items="Model.Employees" class="form-select" required>
                        <option value="">-- Select Doctor/Nurse --</option>
                    </select>
                    <div class="invalid-feedback">
                        Please select a doctor or nurse.
                    </div>
                </div>

                <div class="mb-3 position-relative">
                    <label class="form-label fw-bold required">Admission Date</label>
                    <input type="date" name="AdmissionDate" class="form-control"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                           max="@DateTime.Today.ToString("yyyy-MM-dd")"
                           min="@DateTime.Today.AddYears(-1).ToString("yyyy-MM-dd")"
                           required />
                    <div class="invalid-feedback">
                        Please select a valid admission date (cannot be in the future).
                    </div>
                </div>

                <div class="mb-3 position-relative">
                    <label class="form-label fw-bold required">Reason</label>
                    <textarea name="Reason" class="form-control"
                              placeholder="Enter reason for admission"
                              minlength="10"
                              maxlength="500"
                              required></textarea>
                    <div class="invalid-feedback">
                        Please enter a reason for admission (10-500 characters).
                    </div>
                </div>

                <div class="d-flex">
                    <button type="submit" class="btn btn-success me-2">Admit Patient</button>
                    <button type="button" id="cancelBtn" class="btn btn-secondary">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            // Initialize form validation
            (function () {
                'use strict';
                const forms = document.querySelectorAll('.needs-validation');
                Array.from(forms).forEach(form => {
                    form.addEventListener('submit', event => {
                        if (!form.checkValidity()) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            })();

            // Real-time validation for form fields
            function setupFormValidation() {
                // Ward validation
                $('#wardSelect').on('change input', function() {
                    validateSelectField(this, 'Please select a ward.');
                });

                // Room validation
                $('#roomSelect').on('change input', function() {
                    validateSelectField(this, 'Please select a room.');
                });

                // Bed validation
                $('#bedSelect').on('change input', function() {
                    validateSelectField(this, 'Please select a bed.');
                });

                // Employee validation
                $('#EmployeeId').on('change input', function() {
                    validateSelectField(this, 'Please select a doctor or nurse.');
                });

                // Admission date validation
                $('input[name="AdmissionDate"]').on('change input', function() {
                    validateDateField(this);
                });

                // Reason validation
                $('textarea[name="Reason"]').on('input', function() {
                    validateReasonField(this);
                });
            }

            // Validation functions
            function validateSelectField(field, message) {
                const value = $(field).val();
                if (!value) {
                    field.setCustomValidity(message);
                } else {
                    field.setCustomValidity('');
                }
                updateValidationState(field);
            }

            function validateDateField(field) {
                const value = $(field).val();
                const selectedDate = new Date(value);
                const today = new Date();
                today.setHours(0, 0, 0, 0);

                if (!value) {
                    field.setCustomValidity('Please select an admission date.');
                } else if (selectedDate > today) {
                    field.setCustomValidity('Admission date cannot be in the future.');
                } else {
                    field.setCustomValidity('');
                }
                updateValidationState(field);
            }

            function validateReasonField(field) {
                const value = $(field).val().trim();

                if (!value) {
                    field.setCustomValidity('Please enter a reason for admission.');
                } else if (value.length < 10) {
                    field.setCustomValidity('Reason must be at least 10 characters long.');
                } else if (value.length > 500) {
                    field.setCustomValidity('Reason cannot exceed 500 characters.');
                } else {
                    field.setCustomValidity('');
                }
                updateValidationState(field);
            }

            function updateValidationState(field) {
                const isValid = field.checkValidity();
                const $field = $(field);

                if (field.value === "" && !field.required) {
                    $field.removeClass('is-valid is-invalid');
                } else if (isValid) {
                    $field.removeClass('is-invalid');
                    $field.addClass('is-valid');
                } else {
                    $field.removeClass('is-valid');
                    $field.addClass('is-invalid');
                }
            }

            // Step 1: Next button → Check admission status
            $('#nextStepBtn').click(function () {
                var selectedOption = $('#patientSelect option:selected');
                var patientId = selectedOption.val();
                var patientName = selectedOption.data('name');

                if (!patientId) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Please select a patient first.',
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000
                    });
                    // Trigger validation
                    $('#patientSelect')[0].setCustomValidity('Please select a patient.');
                    updateValidationState($('#patientSelect')[0]);
                    return;
                } else {
                    $('#patientSelect')[0].setCustomValidity('');
                    updateValidationState($('#patientSelect')[0]);
                }

                // Call backend check
                $.getJSON('@Url.Action("CheckActiveAdmission", "Admission_Discharge")', { patientId: patientId })
                            .done(function (response) {
                        if (response.isAdmitted) {
                            Swal.fire({
                                icon: 'error',
                                title: '⚠️ Patient is already admitted and not discharged!',
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 3000
                            });
                            return;
                        }

                        // Passed → Show admission form
                        $('#PatientId').val(patientId);
                        $('#selectedPatientName').text(patientName);
                        $('#admissionFormStep').slideDown();
                        $('#selectPatientStep').slideUp();

                        // Initialize form validation for step 2
                        setupFormValidation();
                    })
                    .fail(function () {
                        Swal.fire({
                            icon: 'error',
                            title: '❌ Error checking patient admission status.',
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 3000
                        });
                    });
            });

            // Cancel button → back to select
            $('#cancelBtn').click(function () {
                $('#admissionFormStep').slideUp();
                $('#selectPatientStep').slideDown();
                $('#admitPatientForm')[0].reset();
                $('#admitPatientForm').removeClass('was-validated');

                // Clear validation states
                $('#admitPatientForm').find('select, input, textarea').each(function() {
                    $(this).removeClass('is-valid is-invalid');
                    this.setCustomValidity('');
                });
            });

            // Ward → Room → Bed cascading
            $('#wardSelect').change(function () {
                var wardId = $(this).val();
                if (!wardId) {
                    $('#roomSelect').empty().append('<option value="">-- Select Room --</option>');
                    $('#bedSelect').empty().append('<option value="">-- Select Bed --</option>');
                    return;
                }

                $.getJSON('/Admission_Discharge/GetRooms', { wardId: wardId }, function (rooms) {
                    var roomSelect = $('#roomSelect');
                    roomSelect.empty().append('<option value="">-- Select Room --</option>');
                    $.each(rooms, function (i, room) {
                        roomSelect.append('<option value="' + room.roomId + '">' + room.roomNumber + '</option>');
                    });
                    $('#bedSelect').empty().append('<option value="">-- Select Bed --</option>');

                    // Trigger validation
                    validateSelectField(roomSelect[0], 'Please select a room.');
                });
            });

            $('#roomSelect').change(function () {
                var roomId = $(this).val();
                if (!roomId) {
                    $('#bedSelect').empty().append('<option value="">-- Select Bed --</option>');
                    return;
                }

                $.getJSON('/Admission_Discharge/GetBeds', { roomId: roomId }, function (beds) {
                    var bedSelect = $('#bedSelect');
                    bedSelect.empty().append('<option value="">-- Select Bed --</option>');
                    $.each(beds, function (i, bed) {
                        bedSelect.append('<option value="' + bed.bedId + '">' + bed.bedNumber + '</option>');
                    });

                    // Trigger validation
                    validateSelectField(bedSelect[0], 'Please select a bed.');
                });
            });

            // TempData success handling
            var successMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"] ?? null));
            if (successMessage) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: successMessage,
                    showConfirmButton: false,
                    timer: 3000
                });
            }
        });
    </script>
}