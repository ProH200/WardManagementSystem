@using Wellness_Wardens_Project.ViewModels.PatientManagementSubsystem
@model WardAdminDashboardViewModel

@{
    ViewData["Title"] = "Ward Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #CAD5E2; /* Body background */
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #212529;
        margin: 0;
        padding: 0;
    }

    .btn-custom {
        border-radius: 50px;
        padding: 10px 20px;
        font-weight: 600;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 10px rgba(0,0,0,0.15);
        }

    .card, .card-body {
        background-color: #D7E0EB; /* Slightly lighter than body */
        border-radius: 0.75rem;
        box-shadow: 0 3px 6px rgba(0,0,0,0.05);
    }

    .card-header {
        border-radius: 0.75rem 0.75rem 0 0;
    }

    .text-muted {
        color: #495057 !important;
    }

    h2, h4, h5 {
        color: #1A1A2E;
    }

    .activity-item {
        border-left: 3px solid #0d6efd;
        padding-left: 15px;
        margin-bottom: 15px;
    }

    .activity-time {
        font-size: 0.85rem;
        color: #6c757d;
    }

    .activity-badge {
        font-size: 0.75rem;
        padding: 3px 8px;
        border-radius: 15px;
    }
</style>

<div class="container-fluid mt-4">
    <h2 class="mb-4 text-center fw-bold">Ward Administration Dashboard</h2>

    <!-- Navigation Panel -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold">
                    Quick Actions
                </div>
                <div class="card-body d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Patient" asp-action="ManagePatients" class="btn btn-primary btn-custom">
                        <i class="bi bi-people-fill me-1"></i> Patients
                    </a>
                    <a asp-controller="Admission_Discharge" asp-action="Admissions" class="btn btn-info btn-custom">
                        <i class="bi bi-journal-medical me-1"></i> Admissions
                    </a>

                    <a asp-controller="Admission_Discharge" asp-action="Discharges" class="btn btn-warning btn-custom text-dark">
                        <i class="bi bi-box-arrow-right me-1"></i> Discharges
                    </a>
                    <a asp-controller="Admission_Discharge" asp-action="ManageOccupiedBeds" class="btn btn-secondary btn-custom">
                        <i class="bi bi-house-fill me-1"></i> Beds
                    </a>
                    <a asp-controller="PatientMovements" asp-action="Admitted" class="btn btn-dark btn-custom text-white">
                        <i class="bi bi-arrow-left-right me-1"></i> Movements
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Dashboard Overview -->
    <div class="card shadow-sm border-0 mb-5">
        <div class="card-header bg-primary text-white fw-bold">
            Dashboard Overview
        </div>
        <div class="card-body">
            <p>
                This dashboard provides a real-time overview of ward operations.
                Administrators can track <strong>patients</strong>, monitor <strong>bed availability</strong>,
                and review <strong>admission vs discharge trends</strong>. Use the navigation panel above to
                perform quick management actions like admitting patients, reviewing discharges, or reallocating beds.
                The charts and stats below help in making data-driven decisions for effective ward management.
            </p>
        </div>
    </div>

    <!-- Key Metrics -->
    <div class="row g-4 mb-4 text-center">
        <div class="col-md-3">
            <div class="card shadow border-0 p-3">
                <h5 class="text-muted">Total Patients</h5>
                <h2 class="fw-bold text-primary">@Model.TotalPatients</h2>
                <small>Currently registered in the system</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow border-0 p-3">
                <h5 class="text-muted">Active Admissions</h5>
                <h2 class="fw-bold text-success">@Model.ActiveAdmissions</h2>
                <small>Patients admitted and under care</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow border-0 p-3">
                <h5 class="text-muted">Total Discharges</h5>
                <h2 class="fw-bold text-info">@Model.TotalDischarges</h2>
                <small>Patients who have been discharged</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow border-0 p-3">
                <h5 class="text-muted">Total Admissions</h5>
                <h2 class="fw-bold text-warning">@Model.TotalAdmissions</h2>
                <small>Admissions recorded overall</small>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row g-4 mb-5">
        <div class="col-lg-6">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white fw-bold">
                    Bed Availability Overview
                </div>
                <div class="card-body">
                    <canvas id="bedsChart"></canvas>
                    <p class="mt-3 text-muted small">
                        This chart shows the proportion of <strong>occupied</strong> vs <strong>available beds</strong> across all wards.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow border-0">
                <div class="card-header bg-success text-white fw-bold">
                    Admissions vs Discharges
                </div>
                <div class="card-body">
                    <canvas id="admissionsChart"></canvas>
                    <p class="mt-3 text-muted small">
                        Compare the number of <strong>admissions</strong> to <strong>discharges</strong> to identify patient flow trends.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity Section -->
    <div class="row g-4 mb-5">
        <div class="col-12">
            <div class="card shadow border-0">
                <div class="card-header bg-info text-white fw-bold d-flex justify-content-between align-items-center">
                    <span>Recent Activity</span>
                    <a href="#" class="btn btn-sm btn-light">View All</a>
                </div>
                <div class="card-body">
                    @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                    {
                        foreach (var activity in Model.RecentActivities)
                        {
                            <div class="activity-item mb-3 pb-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <strong class="d-block">@activity.Title</strong>
                                        <div class="text-muted small mb-1">@activity.Description</div>
                                    </div>
                                    <span class="badge @GetActivityBadgeClass(activity.Type) activity-badge ms-2">@activity.Type</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-clock-history fs-1"></i>
                            <p class="mt-2">No recent activity to display</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @functions {
        private string FormatTimeAgo(DateTime timestamp)
        {
            var timeSpan = DateTime.Now - timestamp;

            if (timeSpan.TotalMinutes < 1)
                return "Just now";
            if (timeSpan.TotalHours < 1)
                return $"{(int)timeSpan.TotalMinutes} minutes ago";
            if (timeSpan.TotalDays < 1)
                return $"{(int)timeSpan.TotalHours} hours ago";
            if (timeSpan.TotalDays < 7)
                return $"{(int)timeSpan.TotalDays} days ago";

            return timestamp.ToString("MMM dd, yyyy");
        }

        private string GetActivityBadgeClass(string activityType)
        {
            return activityType?.ToLower() switch
            {
                "admission" => "bg-success",
                "discharge" => "bg-info",
                "registration" => "bg-primary",
                "transfer" => "bg-warning text-dark",
                "maintenance" => "bg-secondary",
                _ => "bg-secondary"
            };
        }
    }

    <!-- Beds Summary -->
    <h4 class="fw-bold mb-3">Bed Status Summary</h4>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow text-center border-0 bg-secondary text-white">
                <div class="cards-body">
                    <h5>Total Beds</h5>
                    <h2 class="fw-bold">@Model.TotalBeds</h2>
                    <small>System-wide registered beds</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow text-center border-0 bg-danger text-white">
                <div class="cards-body">
                    <h5>Occupied Beds</h5>
                    <h2 class="fw-bold">@Model.OccupiedBeds</h2>
                    <small>Currently assigned to patients</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow text-center border-0 bg-success text-white">
                <div class="cards-body">
                    <h5>Available Beds</h5>
                    <h2 class="fw-bold">@Model.AvailableBeds</h2>
                    <small>Ready for new admissions</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Bed Availability Chart
        var ctx1 = document.getElementById('bedsChart').getContext('2d');
        new Chart(ctx1, {
            type: 'doughnut',
            data: {
                labels: ['Occupied Beds', 'Available Beds'],
                datasets: [{
                    data: [@Model.OccupiedBeds, @Model.AvailableBeds],
                    backgroundColor: ['#dc3545', '#28a745']
                }]
            },
            options: {
                plugins: { legend: { position: 'bottom' } },
                responsive: true
            }
        });

        // Admissions vs Discharges Chart
        var ctx2 = document.getElementById('admissionsChart').getContext('2d');
        new Chart(ctx2, {
            type: 'bar',
            data: {
                labels: ['Admissions', 'Discharges'],
                datasets: [{
                    label: 'Count',
                    data: [@Model.TotalAdmissions, @Model.TotalDischarges],
                    backgroundColor: ['#0d6efd', '#20c997']
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                responsive: true
            }
        });
    </script>
}