@model Wellness_Wardens_Project.ViewModels.StockManagerDashboardViewModel
@{
    ViewData["Title"] = "Stock Manager Dashboard";
    Layout = "_Layout";
}

<!-- Header Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="dashboard-header bg-success text-white p-4 rounded-3">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-6 fw-bold">Welcome, @ViewData["WelcomeName"]!</h1>
                </div>
                <div class="col-md-4 text-end">
                    <i class="fas fa-warehouse fa-5x text-white opacity-75"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Notification Alert for Pending Requests -->
@if (Model.PendingRequestsCount > 0)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="fas fa-bell me-2"></i>
                <strong>Attention Required!</strong> You have <strong>@Model.PendingRequestsCount</strong> pending consumable requests that need action.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    </div>
}

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                            Low Stock Items
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.LowStockCount</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-danger shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                            Critical Items
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.CriticalStockItems</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-skull-crossbones fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                            Pending Orders
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.PendingRequestsCount</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-clipboard-list fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-3 mb-3">
                        <a href="@Url.Action("Index", "ConsumablesRequest")" class="btn btn-warning btn-lg w-100 py-3">
                            <i class="fas fa-exclamation-triangle fa-2x mb-2"></i><br>
                            View Requests<br>
                            <small>(@Model.PendingRequestsCount pending)</small>
                        </a>
                    </div>
                    <div class="col-md-3 mb-3">
                        <a href="@Url.Action("Create", "ConsumablesRequest")" class="btn btn-primary btn-lg w-100 py-3">
                            <i class="fas fa-cart-plus fa-2x mb-2"></i><br>
                            New Order<br>
                            <small>Request</small>
                        </a>
                    </div>
                    <div class="col-md-3 mb-3">
                        <a href="@Url.Action("WeeklyStockTake", "ConsumablesRequest")" class="btn btn-info btn-lg w-100 py-3">
                            <i class="fas fa-clipboard-check fa-2x mb-2"></i><br>
                            Weekly<br>
                            <small>Stock Take</small>
                        </a>
                    </div>
                    <div class="col-md-3 mb-3">
                        <a href="@Url.Action("ViewInventory","ConsumablesRequest")" class="btn btn-warning btn-lg w-100 py-3">
                            <i class="fas fa-boxes fa-2x mb-2"></i><br>
                            View Inventory<br>
                            <small>View consumables</small>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="row">
    <!-- Low Stock Items Section -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow h-100">
            <div class="card-header bg-warning text-white">
                <h5 class="card-title mb-0">
                    ⚠️ Low Stock Items
                </h5>
            </div>
            <div class="card-body">
                @if (Model.LowStockItems.Any())
                {
                    <div class="list-group">
                        @foreach (var item in Model.LowStockItems)
                        {
                            <div class="list-group-item list-group-item-action">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@item.Name</h6>
                                    <span class="badge bg-@item.StatusColor">@item.StockStatus</span>
                                </div>
                                <p class="mb-1">Ward: @item.WardName</p>
                                <p class="mb-1">Quantity: <strong class="text-@item.StatusColor">@item.QuantityAvailable</strong></p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                        <p class="text-muted">All stock levels are adequate!</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Pending Orders Section -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow h-100">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0">
                    Pending Orders
                </h5>
            </div>
            <div class="card-body">
                @if (Model.PendingRequests.Any())
                {
                    <div class="list-group">
                        @foreach (var request in Model.PendingRequests)
                        {
                            <div class="list-group-item list-group-item-action">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@request.ConsumableName</h6>
                                    <small>@request.RequestedDate.ToString("MMM dd, yyyy")</small>
                                </div>
                                <span class="badge bg-info">@request.Status</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-clipboard-check fa-3x text-success mb-3"></i>
                        <p class="text-muted">No pending orders</p>
                    </div>
                }
            </div>
            <div class="card-footer">
                <a href="@Url.Action("Index", "ConsumablesRequest")" class="btn btn-outline-info btn-sm">
                    <i class="fas fa-list me-1"></i>View All Orders
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .dashboard-header {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        }

        .card {
            border: none;
            border-radius: 15px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
            }

        .border-left-primary {
            border-left: 4px solid #4e73df !important;
        }

        .border-left-warning {
            border-left: 4px solid #f6c23e !important;
        }

        .border-left-danger {
            border-left: 4px solid #e74a3b !important;
        }

        .border-left-info {
            border-left: 4px solid #36b9cc !important;
        }

        .border-left-success {
            border-left: 4px solid #1cc88a !important;
        }

        .btn-lg {
            border-radius: 10px;
            transition: all 0.3s ease;
        }

            .btn-lg:hover {
                transform: scale(1.05);
            }

        .stock-indicator {
            width: 20px;
            height: 20px;
            border-radius: 4px;
            display: inline-block;
        }

        .stock-legend {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
        }

        .list-group-item {
            border-radius: 10px;
            margin-bottom: 10px;
            border: 1px solid #e3e6f0;
        }

        .badge {
            font-size: 0.75em;
        }

        .alert {
            border-radius: 10px;
            border: none;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Initialize dashboard
        document.addEventListener('DOMContentLoaded', function() {
            console.log("Dashboard loaded");
            initializeStockChart();
        });

       
        // Generate the actual report file
        function generateReportFile(reportType) {
            Swal.fire({
                title: 'Generating Report...',
                text: 'Please wait while we generate your report',
                icon: 'info',
                showConfirmButton: false,
                allowOutsideClick: false
            });

            // CORRECT URL - Use ReportsController
            fetch(`/Reports/GenerateStockReport?reportType=${reportType}`)
                .then(response => {
                    if (response.ok) {
                        return response.blob();
                    }
                    throw new Error('Report generation failed');
                })
                .then(blob => {
                    // Create download link
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;

                    // Set filename based on report type
                    const filename = getReportFilename(reportType);
                    a.download = filename;

                    // Trigger download
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(url);

                    Swal.fire({
                        title: 'Report Generated!',
                        text: `Your ${getReportTypeName(reportType)} has been downloaded`,
                        icon: 'success',
                        confirmButtonText: 'OK'
                    });
                })
                .catch(error => {
                    Swal.fire({
                        title: 'Error!',
                        text: 'Failed to generate report: ' + error.message,
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                });
        }

        function getReportFilename(reportType) {
            const date = new Date().toISOString().split('T')[0];
            switch(reportType) {
                case 'weekly':
                    return `weekly-stock-take-${date}.xlsx`;
                case 'lowstock':
                    return `low-stock-alert-${date}.pdf`;
                case 'all':
                    return `all-consumables-${date}.xlsx`;
                default:
                    return `stock-report-${date}.xlsx`;
            }
        }

        function getReportTypeName(reportType) {
            switch(reportType) {
                case 'weekly':
                    return 'Weekly Stock Take Report';
                case 'lowstock':
                    return 'Low Stock Alert Report';
                case 'all':
                    return 'All Consumables Inventory Report';
                default:
                    return 'Stock Report';
            }
        }

        // Check if button exists
        document.addEventListener('DOMContentLoaded', function() {
            const reportButton = document.querySelector('button[onclick="generateStockReport()"]');
            if (reportButton) {
                console.log("✅ Report button found");
                // Add direct click listener as backup
                reportButton.addEventListener('click', function(e) {
                    generateStockReport();
                });
            } else {
                console.error("❌ Report button NOT found!");
            }
        });
    </script>
}
