@model Wellness_Wardens_Project.ViewModels.ScriptManagerDashboardViewModel
@{
    ViewData["Title"] = "Script Manager Dashboard";
    Layout = "_Layout";
}

<!-- Header Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="dashboard-header bg-primary text-white p-4 rounded-3">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-6 fw-bold">Welcome, @ViewData["WelcomeName"]!</h1>
                    <p class="lead mb-0">Manage prescriptions</p>
                </div>
                <div class="col-md-4 text-end">
                    <i class="fas fa-prescription-bottle-alt fa-5x text-white opacity-75"></i>
                </div>
            </div>
        </div>
    </div>
</div>
    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Pending Prescriptions
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.PendingCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clipboard-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Sent to Pharmacy
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.ProcessedCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-truck-loading fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3 mb-3">
                            <a href="@Url.Action("Pending", "Prescriptions")" class="btn btn-primary btn-lg w-100 py-3">
                                <i class="fas fa-inbox fa-2x mb-2"></i><br>
                                Process Pending Prescriptions
                               
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="@Url.Action("Index", "Prescriptions")" class="btn btn-info btn-lg w-100 py-3">
                                <i class="fas fa-list fa-2x mb-2"></i><br>
                                View All<br>
                                <small>Prescriptions</small>
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <button class="btn btn-success btn-lg w-100 py-3" onclick="generateReport()">
                                <i class="fas fa-chart-bar fa-2x mb-2"></i><br>
                                Generate <br>
                                <small> PDF Reports</small>
                            </button>
                        </div>
                        <div class="col-md-3 mb-3">
                            <button class="btn btn-warning btn-lg w-100 py-3" onclick="showStatistics()">
                                <i class="fas fa-chart-pie fa-2x mb-2"></i><br>
                                View<br>
                                <small>Statistics</small>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="row">
        <!-- Pending Prescriptions Section -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-warning text-white">
                    <h5 class="card-title mb-0">
                        ⏳ Pending Prescriptions
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.PendingPrescriptions.Any())
                    {
                        <div class="list-group">
                            @foreach (var prescription in Model.PendingPrescriptions)
                            {
                                <div class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">Rerefence: @($"{prescription.DateWritten:MMdd}-{prescription.DoctorName.Split(' ')[0][0]}{prescription.DoctorName.Split(' ').Last()[0]}-{prescription.PrescriptionId % 1000:D3}")</h6>
                                </div>
                                    <p class="mb-1">Doctor: @prescription.DoctorName</p>
                                    <span class="badge bg-@prescription.StatusColor">@prescription.Status</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                            <p class="text-muted">No pending prescriptions!</p>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("Pending", "Prescriptions")" class="btn btn-outline-warning btn-sm">
                        <i class="fas fa-eye me-1"></i>View All Pending
                    </a>
                </div>
            </div>
        </div>

        <!-- Recent Activity Section -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">
                        Sent to Pharmacy
                        <span class="badge bg-light text-dark float-end">@Model.ProcessedCount</span>
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentProcessed.Any())
                    {
                        <div class="timeline">
                            @foreach (var prescription in Model.RecentProcessed)
                            {
                                <div class="timeline-item mb-3">
                                    <div class="timeline-marker bg-@prescription.StatusColor"></div>
                                    <div class="timeline-content p-3 bg-light rounded">
                                        <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-1">Reference: @($"{prescription.DateWritten:MMdd}-{prescription.DoctorName.Split(' ')[0][0]}{prescription.DoctorName.Split(' ').Last()[0]}-{prescription.PrescriptionId % 1000:D3}")</h6>
                                    </div>
                                        <p class="mb-1 text-sm">Doctor: @prescription.DoctorName</p>
                                        <small class="text-muted">@prescription.DateWritten.ToString("MMM dd, yyyy hh:mm tt")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-clock fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No recent activity</p>
                        </div>
                    }
                </div>
            </div>
        </div>
        <!-- Statistics Side Panel -->
        <div id="statsPanel" class="stats-panel">
            <div class="stats-panel-header">
                <h5 class="mb-0">📊 Prescription Statistics</h5>
                <button class="btn-close btn-close-white" onclick="hideStatistics()"></button>
            </div>
            <div class="stats-panel-body">
                <!-- Quick Stats Cards -->
                <div class="row mb-4">
                    <div class="col-6">
                        <div class="stat-card text-center p-3 bg-warning text-white rounded">
                            <h4 class="mb-0">@Model.PendingCount</h4>
                            <small>Pending</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-card text-center p-3 bg-info text-white rounded">
                            <h4 class="mb-0">@Model.ProcessedCount</h4>
                            <small>In Pharmacy</small>
                        </div>
                    </div>
                </div>

                <!-- Main Chart -->
                <div class="chart-container">
                    <canvas id="statsChart" height="250"></canvas>
                </div>

                <!-- Statistics Details -->
                <div class="stats-details mt-4">
                    <h6 class="mb-3">📈 Detailed Breakdown</h6>
                    <div class="d-flex justify-content-between border-bottom py-2">
                        <span class="text-warning">● Pending Prescriptions:</span>
                        <strong>@Model.PendingCount</strong>
                    </div>
                    <div class="d-flex justify-content-between border-bottom py-2">
                        <span class="text-info">● Sent to Pharmacy:</span>
                        <strong>@Model.ProcessedCount</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 bg-light rounded p-2 mt-2">
                        <span class="text-success"><strong>Total Active Prescriptions:</strong></span>
                        <strong class="text-success">@(Model.PendingCount + Model.ProcessedCount)</strong>
                    </div>
                </div>

                <!-- Last Updated -->
                <div class="text-center mt-4">
                    <small class="text-muted">
                        <i class="fas fa-sync-alt me-1"></i>
                        Last updated: <span id="lastUpdated">Just now</span>
                    </small>
                </div>
            </div>
        </div>

        <div id="statsOverlay" class="stats-overlay"></div>

    </div>
</div>

