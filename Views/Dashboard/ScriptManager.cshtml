@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Store original counts when page loads
        let originalPendingCount = @Model.PendingCount;

        // Initialize dashboard
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Dashboard loaded. Pending count:', originalPendingCount);

            // Show badge immediately if there are pending prescriptions
            if (originalPendingCount > 0) {
                showPrescriptionBadge(originalPendingCount);
            }

            startAutoRefresh();
        });

        function updateDashboardData() {
            console.log('Updating dashboard data...');

            fetch('/Prescriptions/GetDashboardStats')
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok: ' + response.status);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Dashboard stats received:', data);

                    document.querySelector('[class*="border-left-primary"] .h5').textContent = data.pendingCount;
                    document.querySelector('[class*="border-left-warning"] .h5').textContent = data.processedCount;

                    // Update quick action badge
                    const quickActionBadge = document.querySelector('a[href*="Pending"] small');
                    if (quickActionBadge) {
                        quickActionBadge.textContent = `(${data.pendingCount} waiting)`;
                    }

                    updatePrescriptionBadge(data.pendingCount);


                    updateStatisticsPanel(data);
                })
                .catch(error => {
                    console.error('Dashboard update failed:', error);
                });
        }

        // Update statistics panel with new data
        function updateStatisticsPanel(data) {
            const panel = document.getElementById('statsPanel');
            if (panel.classList.contains('show')) {

                document.getElementById('lastUpdated').textContent = new Date().toLocaleTimeString();

                if (window.statsChartInstance) {
                    window.statsChartInstance.data.datasets[0].data = [data.pendingCount, data.processedCount];
                    window.statsChartInstance.update();
                }
            }
        }

        // Update prescription badge based on current count
        function updatePrescriptionBadge(currentCount) {
            console.log('Updating badge. Current count:', currentCount);

            if (currentCount > 0) {
                showPrescriptionBadge(currentCount);
            } else {
                removePrescriptionBadge();
            }
        }

        function showPrescriptionBadge(count) {

            removePrescriptionBadge();

            console.log('Showing badge for', count, 'pending prescriptions');

            // Create badge ONLY for Process Pending button
            const buttonBadge = document.createElement('span');
            buttonBadge.className = 'prescription-badge badge bg-danger position-absolute';
            buttonBadge.textContent = count;
            buttonBadge.title = 'Prescriptions waiting for action';
            buttonBadge.style.cssText = 'font-size: 0.7rem; padding: 0.35em 0.55em; top: -8px; right: -8px; z-index: 100; animation: pulse 2s infinite;';

            // Add to Process Pending button container
            const pendingButtonContainer = document.querySelector('a[href*="Pending"]').parentElement;
            if (pendingButtonContainer) {
                pendingButtonContainer.classList.add('position-relative');
                pendingButtonContainer.appendChild(buttonBadge);
            }
        }

        function removePrescriptionBadge() {
            const badges = document.querySelectorAll('.prescription-badge');
            badges.forEach(badge => badge.remove());
        }

        function startAutoRefresh() {

            updateDashboardData();

            setInterval(() => {
                updateDashboardData();
            }, 30000);
        }

        //report generation
        function generateReport() {
            Swal.fire({
                title: 'Generate Report',
                input: 'select',
                inputOptions: {
                    'pending': 'Pending Prescriptions',
                    'processed': 'Processed & Delivered',
                    'all': 'All Prescriptions'
                },
                inputPlaceholder: 'Select report type',
                showCancelButton: true,
                confirmButtonText: 'Generate PDF',
                cancelButtonText: 'Cancel',
                width: 350,
                padding: '1rem',
                inputValidator: (value) => {
                    if (!value) {
                        return 'Please select a report type';
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    switch (result.value) {
                        case 'pending':
                            generatePendingReport();
                            break;
                        case 'processed':
                            generateProcessedReport();
                            break;
                        case 'all':
                            generateAllReport();
                            break;
                    }
                }
            });
        }

        //pending prescriptions report
        function generatePendingReport() {
            showReportProgress('Pending Prescriptions Report');

            fetch('/Prescriptions/GeneratePendingReport')
                .then(response => {
                    if (!response.ok) throw new Error('Network response was not ok');
                    return response.blob();
                })
                .then(blob => {
                    downloadPdfFile(blob, 'pending_prescriptions_report.pdf');
                    Swal.fire({
                        title: 'Report Generated!',
                        text: 'Pending prescriptions PDF report has been downloaded',
                        icon: 'success',
                        confirmButtonText: 'OK'
                    });
                })
                .catch(error => {
                    console.error('Report generation error:', error);
                    Swal.fire({
                        title: 'Error!',
                        text: 'Failed to generate report. Please try again.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                });
        }

        //processed & delivered report
        function generateProcessedReport() {
            showReportProgress('Processed & Delivered Report');

            fetch('/Prescriptions/GenerateProcessedReport')
                .then(response => {
                    if (!response.ok) throw new Error('Network response was not ok');
                    return response.blob();
                })
                .then(blob => {
                    downloadPdfFile(blob, 'processed_prescriptions_report.pdf');
                    Swal.fire({
                        title: 'Report Generated!',
                        text: 'Processed prescriptions PDF report has been downloaded',
                        icon: 'success',
                        confirmButtonText: 'OK'
                    });
                })
                .catch(error => {
                    console.error('Report generation error:', error);
                    Swal.fire({
                        title: 'Error!',
                        text: 'Failed to generate report. Please try again.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                });
        }

                //all prescriptions report
        function generateAllReport() {
            showReportProgress('All Prescriptions Report');

            fetch('/Prescriptions/GenerateAllReport')
                .then(response => {
                    console.log('Response status:', response.status);
                    console.log('Response headers:', response.headers);

                    if (!response.ok) {
                        return response.text().then(errorText => {
                            console.error('Server error details:', errorText);

                            let errorMessage = 'Server error occurred';
                            try {
                                const errorJson = JSON.parse(errorText);
                                errorMessage = errorJson.message || errorJson.title || errorText;
                            } catch {
                                errorMessage = errorText || `HTTP ${response.status}: ${response.statusText}`;
                            }

                            throw new Error(errorMessage);
                        });
                    }
                    return response.blob();
                })
                .then(blob => {
                    console.log('Blob received:', blob.size, 'bytes');
                    if (blob.size === 0) {
                        throw new Error('PDF file is empty (0 bytes)');
                    }

                    if (blob.type !== 'application/pdf') {
                        console.warn('Expected PDF but got:', blob.type);
                 
                        return blob.text().then(text => {
                            if (text.includes('Error') || text.includes('Exception')) {
                                throw new Error(`Server returned error: ${text.substring(0, 200)}...`);
                            }
                            return blob;
                        });
                    }

                    return blob;
                })
                .then(blob => {
                    downloadPdfFile(blob, 'all_prescriptions_report.pdf');
                    Swal.fire({
                        title: 'Report Generated!',
                        text: 'All prescriptions PDF report has been downloaded',
                        icon: 'success',
                        confirmButtonText: 'OK'
                    });
                })
                .catch(error => {
                    console.error('Report generation error:', error);
                    Swal.fire({
                        title: 'Error!',
                        text: `Failed to generate report: ${error.message}`,
                        icon: 'error',
                        confirmButtonText: 'OK',
                        width: 600
                    });
                });
        }

        // report generation progress
        function showReportProgress(reportType) {
            Swal.fire({
                title: 'Generating Report...',
                html: `Creating <strong>${reportType}</strong><br><small>Please wait</small>`,
                icon: 'info',
                showConfirmButton: false,
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
        }

        // Download PDF file
        function downloadPdfFile(blob, filename) {
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.style.display = 'none';
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
            document.body.removeChild(a);
        }

                // Show statistics panel
        function showStatistics() {
            const panel = document.getElementById('statsPanel');
            const overlay = document.getElementById('statsOverlay');

            panel.classList.add('show');
            overlay.classList.add('show');

            document.getElementById('lastUpdated').textContent = new Date().toLocaleTimeString();

            initializeStatisticsChart();
        }

        // Hide statistics panel
        function hideStatistics() {
            const panel = document.getElementById('statsPanel');
            const overlay = document.getElementById('statsOverlay');

            panel.classList.remove('show');
            overlay.classList.remove('show');
        }

        // Initialize statistics chart
        function initializeStatisticsChart() {
            const ctx = document.getElementById('statsChart').getContext('2d');

            if (window.statsChartInstance) {
                window.statsChartInstance.destroy();
            }

            window.statsChartInstance = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Pending Prescriptions', 'Sent to Pharmacy'],
                    datasets: [{
                        data: [@Model.PendingCount, @Model.ProcessedCount],
                        backgroundColor: [
                            '#ffc107', 
                            '#17a2b8' 
                        ],
                        borderColor: '#fff',
                        borderWidth: 3,
                        hoverBorderWidth: 4,
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 20,
                                usePointStyle: true,
                                font: {
                                    size: 12,
                                    weight: '500'
                                },
                                color: '#495057'
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            titleFont: {
                                size: 13,
                                weight: '600'
                            },
                            bodyFont: {
                                size: 13
                            },
                            callbacks: {
                                label: function(context) {
                                    const label = context.label || '';
                                    const value = context.raw || 0;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = Math.round((value / total) * 100);
                                    return `${label}: ${value} (${percentage}%)`;
                                }
                            }
                        }
                    },
                    cutout: '65%',
                    animation: {
                        animateScale: true,
                        animateRotate: true,
                        duration: 1000,
                        easing: 'easeOutQuart'
                    },
                    layout: {
                        padding: {
                            top: 10,
                            bottom: 10
                        }
                    }
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            const overlay = document.getElementById('statsOverlay');
            if (overlay) {
                overlay.onclick = hideStatistics;
            }

            document.addEventListener('keydown', function(event) {
                if (event.key === 'Escape') {
                    hideStatistics();
                }
            });
        });
    </script>
}

