@model IEnumerable<Wellness_Wardens_Project.ViewModels.AdminSubsystem.AllergyViewModel>

@{
    ViewData["Title"] = "Manage Allergies";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg rounded-3 border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0"><i class="fas fa-allergy me-2"></i> Manage Allergies</h3>
            <div class="d-flex gap-2">
                <a asp-controller="Administration" asp-action="Dashboard" class="btn btn-light">
                    <i class="fas fa-house me-1"></i> Dashboard
                </a>
                <a asp-action="AddAllergy" class="btn btn-light">
                    <i class="fas fa-plus-circle me-1"></i> Add Allergy
                </a>
            </div>
        </div>

        <div class="card-body">
            <!-- Search / Filter -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <input type="text" id="allergySearch" class="form-control" placeholder="Search allergies by name or description...">
                </div>
                <div class="col-md-4">
                    <select id="sortSelect" class="form-select">
                        <option value="name-asc">Sort by: Name (A-Z)</option>
                        <option value="name-desc">Sort by: Name (Z-A)</option>
                        <option value="description-asc">Sort by: Description (A-Z)</option>
                        <option value="description-desc">Sort by: Description (Z-A)</option>
                    </select>
                </div>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="allergyTableBody">
                        @foreach (var allergy in Model)
                        {
                            <tr class="allergy-row">
                                <td>
                                    <strong>@allergy.Name</strong>
                                </td>
                                <td>
                                    @if (string.IsNullOrEmpty(allergy.Description))
                                    {
                                        <span class="text-muted">No description</span>
                                    }
                                    else
                                    {
                                        @allergy.Description
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("EditAllergy", "Allergy", new { id = allergy.AllergyId })"
                                       class="btn btn-sm btn-outline-primary me-2">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@allergy.AllergyId">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </td>
                            </tr>

                            <!-- Delete Confirmation Modal -->
                            <div class="modal fade" id="deleteModal-@allergy.AllergyId" tabindex="-1" aria-labelledby="deleteModalLabel-@allergy.AllergyId" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">

                                        <form asp-controller="Allergy" asp-action="DeleteAllergy" asp-route-id="@allergy.AllergyId" method="post">
                                            @Html.AntiForgeryToken()

                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title" id="deleteModalLabel-@allergy.AllergyId">
                                                    <i class="fas fa-exclamation-triangle me-2"></i> Delete Allergy
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>

                                            <div class="modal-body">
                                                <p class="fw-bold">Are you sure you want to delete this allergy?</p>

                                                <ul class="list-group">
                                                    <li class="list-group-item">
                                                        <strong>Name:</strong> @allergy.Name
                                                    </li>
                                                    <li class="list-group-item">
                                                        <strong>Description:</strong>
                                                        @if (string.IsNullOrEmpty(allergy.Description))
                                                        {
                                                            <span class="text-muted">No description</span>
                                                        }
                                                        else
                                                        {
                                                            @allergy.Description
                                                        }
                                                    </li>
                                                </ul>
                                                <div class="alert alert-warning mt-3 mb-0">
                                                    <i class="fas fa-info-circle me-2"></i>
                                                    This action will soft delete the allergy. It can be restored if needed.
                                                </div>
                                            </div>

                                            <div class="modal-footer">
                                                <button type="submit" class="btn btn-danger">
                                                    <i class="fas fa-trash me-1"></i> Yes, Delete
                                                </button>
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    <i class="fas fa-times me-1"></i> Cancel
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>

                <!-- Pagination Container -->
                <div class="mt-3" id="allergyPagination"></div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-allergy fa-4x text-muted mb-3"></i>
                        <h4 class="text-muted">No allergies found</h4>
                        <p class="text-muted">Get started by adding your first allergy.</p>
                        <a asp-action="AddAllergy" class="btn btn-primary mt-2">
                            <i class="fas fa-plus me-2"></i>Add Allergy
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Help Animation-->
<style>
    /* Container fixed bottom right */
    #doctor-note {
        position: fixed;
        bottom: 70px;
        right: 20px;
        z-index: 1050;
        display: flex;
        align-items: center;
        background: #f8f9fa;
        border: 2px solid #0d6efd;
        border-radius: 12px;
        padding: 8px 12px;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
        max-width: 260px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        animation: floatUpDown 4s ease-in-out infinite;
        cursor: default;
        user-select: none;
    }

        /* Doctor SVG size */
        #doctor-note svg {
            width: 40px;
            height: 40px;
            margin-right: 10px;
            flex-shrink: 0;
        }

    /* Floating animation */
    @@keyframes floatUpDown {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-6px);
        }
    }

    /* Message styling */
    #doctor-note p {
        margin: 0;
        color: #0d6efd;
        font-weight: 600;
        font-size: 13px;
        line-height: 1.2;
        font-family: 'Montserrat', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        letter-spacing: 0.03em;
        text-shadow: 0 0 1px rgba(0,0,0,0.1);
    }
</style>

<div id="doctor-note" role="alert" aria-live="polite" aria-atomic="true" title="Need help? Click the '?' on the bottom right.">
    <!-- Simple cartoon doctor SVG -->
    <svg xmlns="http://www.w3.org/2000/svg" fill="#0d6efd" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <circle cx="32" cy="14" r="12" fill="#0d6efd" />
        <rect x="18" y="26" width="28" height="30" rx="8" ry="8" fill="#0d6efd" />
        <rect x="28" y="34" width="8" height="12" fill="#f8f9fa" />
        <line x1="32" y1="20" x2="32" y2="14" stroke="#f8f9fa" stroke-width="2" />
        <line x1="28" y1="24" x2="36" y2="24" stroke="#f8f9fa" stroke-width="2" />
    </svg>

    <p>If you are unsure about anything,<br>please click the small '?' below.</p>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Search Filter -->
    <script>
        const allergySearchInput = document.getElementById('allergySearch');
        const allergyTableBody = document.getElementById('allergyTableBody');
        let allAllergyRows = Array.from(allergyTableBody.querySelectorAll('.allergy-row'));
        let filteredAllergyRows = [...allAllergyRows];

        function performSearch() {
            const query = allergySearchInput.value.toLowerCase();

            filteredAllergyRows = allAllergyRows.filter(row => {
                const nameText = row.children[0].textContent.toLowerCase();
                const descText = row.children[1].textContent.toLowerCase();
                return nameText.includes(query) || descText.includes(query);
            });

            displayPage(1);
        }

        allergySearchInput.addEventListener('keyup', performSearch);

        // Auto-focus search box
        document.addEventListener('DOMContentLoaded', function() {
            const searchBox = document.getElementById('allergySearch');
            if (searchBox) {
                searchBox.focus();
            }
        });
    </script>

    <!-- Sorting + Pagination -->
    <script>
        const sortSelect = document.getElementById('sortSelect');
        const rowsPerPage = 9;
        let currentPage = 1;

        function displayPage(page) {
            currentPage = page;
            const start = (page - 1) * rowsPerPage;
            const end = start + rowsPerPage;

            allAllergyRows.forEach(row => row.style.display = 'none');

            // Show only filtered rows for current page
            filteredAllergyRows.forEach((allergyRow, index) => {
                if (index >= start && index < end) {
                    allergyRow.style.display = '';
                }
            });

            renderPagination();
        }

        function renderPagination() {
            const paginationContainer = document.getElementById('allergyPagination');
            paginationContainer.innerHTML = '';
            const totalPages = Math.ceil(filteredAllergyRows.length / rowsPerPage);

            if (totalPages > 1) {
                // Previous button
                if (currentPage > 1) {
                    const prevBtn = document.createElement('button');
                    prevBtn.className = 'btn btn-sm btn-outline-primary me-1';
                    prevBtn.innerHTML = '<i class="fas fa-chevron-left"></i>';
                    prevBtn.addEventListener('click', () => displayPage(currentPage - 1));
                    paginationContainer.appendChild(prevBtn);
                }

                // Page buttons
                for (let i = 1; i <= totalPages; i++) {
                    const btn = document.createElement('button');
                    btn.className = 'btn btn-sm me-1 ' + (i === currentPage ? 'btn-primary' : 'btn-outline-primary');
                    btn.innerText = i;
                    btn.addEventListener('click', () => displayPage(i));
                    paginationContainer.appendChild(btn);
                }

                // Next button
                if (currentPage < totalPages) {
                    const nextBtn = document.createElement('button');
                    nextBtn.className = 'btn btn-sm btn-outline-primary me-1';
                    nextBtn.innerHTML = '<i class="fas fa-chevron-right"></i>';
                    nextBtn.addEventListener('click', () => displayPage(currentPage + 1));
                    paginationContainer.appendChild(nextBtn);
                }
            }
        }

        function sortTable(sortValue) {
            const [column, direction] = sortValue.split('-');
            const isAsc = direction === 'asc';

            filteredAllergyRows.sort((a, b) => {
                let aValue, bValue;

                switch (column) {
                    case 'name':
                        aValue = a.children[0].textContent.trim().toLowerCase();
                        bValue = b.children[0].textContent.trim().toLowerCase();
                        break;
                    case 'description':
                        aValue = a.children[1].textContent.trim().toLowerCase();
                        bValue = b.children[1].textContent.trim().toLowerCase();
                        // Handle "No description" text
                        if (aValue === 'no description') aValue = '';
                        if (bValue === 'no description') bValue = '';
                        break;
                    default:
                        aValue = a.children[0].textContent.trim().toLowerCase();
                        bValue = b.children[0].textContent.trim().toLowerCase();
                }

                if (aValue < bValue) return isAsc ? -1 : 1;
                if (aValue > bValue) return isAsc ? 1 : -1;
                return 0;
            });

            filteredAllergyRows.forEach(allergyRow => {
                allergyTableBody.appendChild(allergyRow);
            });

            displayPage(1);
        }

        sortSelect.addEventListener('change', function() {
            sortTable(this.value);
        });

        sortTable('name-asc');
        displayPage(1);
    </script>

    <!-- SweetAlert2 Toast -->
    <script>
        @if (TempData["SuccessMessage"] != null)
        {
                <text>
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: '@TempData["SuccessMessage"]',
                            showConfirmButton: false,
                            timer: 3000,
                            timerProgressBar: true
                        });
                </text>
        }

        @if (TempData["ErrorMessage"] != null)
        {
                <text>
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'error',
                            title: '@TempData["ErrorMessage"]',
                            showConfirmButton: false,
                            timer: 4000,
                            timerProgressBar: true
                        });
                </text>
        }
    </script>
}