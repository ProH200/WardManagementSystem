@model IEnumerable<Wellness_Wardens_Project.Models.AdministrationSubsystem.Bed>

@{
    ViewData["Title"] = "Manage Beds";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/helpanimation.css" rel="stylesheet" />
<style>
    body {
        background: linear-gradient(180deg, #e8f0fe 0%, #ffffff 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-height: 100vh;
        margin: 0;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary"><i class="bi bi-hospital-bed"></i> Manage Beds</h2>
    <div>
        <a asp-controller="Administration" asp-action="Dashboard" class="btn btn-outline-primary me-2">
            <i class="bi bi-house-door me-1"></i> Dashboard
        </a>
    </div>
</div>


<div class="mb-3">
    <input type="text" id="bedSearch" class="form-control" placeholder="Search beds by number or room..." />
</div>

<div class="row g-3" id="bedsContainer">
    @foreach (var bed in Model)
    {
        var isOccupied = bed.PatientAdmissions.Any(pa => !pa.Discharges.Any());

        <div class="col-md-4 bed-card" data-bed="@bed.BedNumber.ToLower()" data-room="@bed.Room?.RoomNumber.ToLower()">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Bed: @bed.BedNumber</h5>

                    <div class="d-flex justify-content-between mb-1">
                        <p class="card-text mb-0"><strong>Room:</strong> @(bed.Room?.RoomNumber ?? "N/A")</p>
                        <p class="card-text mb-0"><strong>Ward:</strong> @(bed.Room?.Ward?.Name ?? "N/A")</p>
                    </div>
                    <p class="card-text mb-1">
                        <strong>Status:</strong>
                        <span class="badge @(bed.Status == "Available" ? "bg-success" : "bg-warning")">
                            @bed.Status
                        </span>
                    </p>

                    <div class="mt-3 d-flex justify-content-between">
                        @if (bed.Status == "Occupied")
                        {
                            <!-- Occupied: trigger SweetAlert error -->
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="showOccupiedError('@bed.BedNumber')">
                                <i class="bi bi-trash3-fill me-1"></i> Delete
                            </button>
                        }
                        else
                        {
                            <!-- Available/Other: trigger modal -->
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteBedModal-@bed.BedId">
                                <i class="bi bi-trash3-fill me-1"></i> Delete
                            </button>
                        }
                    </div>

                </div>
            </div>
        </div>

        <!-- Delete Confirmation Modal -->
        <div class="modal fade" id="deleteBedModal-@bed.BedId" tabindex="-1" aria-labelledby="deleteBedModalLabel-@bed.BedId" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-action="SoftDeleteBed" method="post">
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", bed.BedId)

                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title" id="deleteBedModalLabel-@bed.BedId">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Bed
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">
                            <p class="fw-bold">Are you sure you want to delete this bed?</p>
                            <ul class="list-group">
                                <li class="list-group-item"><strong>Bed:</strong> @bed.BedNumber</li>
                                <li class="list-group-item"><strong>Room:</strong> @(bed.Room?.RoomNumber ?? "N/A")</li>
                                <li class="list-group-item"><strong>Status:</strong> @bed.Status</li>
                            </ul>
                        </div>

                        <div class="modal-footer">
                            <button type="submit" class="btn btn-danger">Yes, Delete</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<div id="doctor-note" role="alert" aria-live="polite" aria-atomic="true" title="Need help? Click the '?' on the bottom right.">
    <!-- Simple cartoon doctor SVG -->
    <svg xmlns="http://www.w3.org/2000/svg" fill="#0d6efd" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <circle cx="32" cy="14" r="12" fill="#0d6efd" />
        <rect x="18" y="26" width="28" height="30" rx="8" ry="8" fill="#0d6efd" />
        <rect x="28" y="34" width="8" height="12" fill="#f8f9fa" />
        <line x1="32" y1="20" x2="32" y2="14" stroke="#f8f9fa" stroke-width="2" />
        <line x1="28" y1="24" x2="36" y2="24" stroke="#f8f9fa" stroke-width="2" />
    </svg>

    <p>If you are unsure about anything,<br>please click the small '?' bellow.</p>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Bed search filter
        document.getElementById('bedSearch').addEventListener('input', function () {
            const query = this.value.toLowerCase();
            document.querySelectorAll('.bed-card').forEach(card => {
                const bed = card.getAttribute('data-bed');
                const room = card.getAttribute('data-room');
                card.style.display = (bed.includes(query) || room.includes(query)) ? 'block' : 'none';
            });
        });

        // SweetAlert toast for TempData messages
        @if (TempData["SuccessMessage"] != null)
        {
                <text>
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: '@TempData["SuccessMessage"]',
                        showConfirmButton: false,
                        timer: 3000
                    });
                </text>
        }

        @if (TempData["ErrorMessage"] != null)
        {
                <text>
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: '@TempData["ErrorMessage"]',
                        showConfirmButton: false,
                        timer: 3000
                    });
                </text>
        }
    </script>
    <script>
        function showOccupiedError(bedNumber) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: `Bed '${bedNumber}' is occupied and cannot be deleted.`,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>
}

<style>
    .bed-card .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .bed-card .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

    #bedsContainer {
        display: flex;
        flex-wrap: wrap;
    }

    .bed-card {
        margin-bottom: 20px;
    }
</style>

