@model IEnumerable<Wellness_Wardens_Project.Models.AdministrationSubsystem.Bed>

@{
    ViewData["Title"] = "Manage Beds";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/helpanimation.css" rel="stylesheet" />
<style>
    body {
        background: linear-gradient(180deg, #e8f0fe 0%, #ffffff 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-height: 100vh;
        margin: 0;
    }

    .bed-card .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .bed-card .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

    #bedsContainer.grid-view .bed-card {
        display: block;
    }

    #bedsContainer.list-view .bed-card {
        flex: 0 0 100%;
    }

    .list-view .card-body {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .bed-card {
        margin-bottom: 20px;
    }

    /* Pagination styling */
    .pagination-controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-top: 20px;
    }

        .pagination-controls button {
            min-width: 80px;
        }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary"><i class="bi bi-hospital-bed"></i> Manage Beds</h2>
    <div>
        <a asp-controller="Administration" asp-action="Dashboard" class="btn btn-outline-primary me-2">
            <i class="bi bi-house-door me-1"></i> Dashboard
        </a>
    </div>
</div>

<!-- Controls: Search, Sort, View Toggle -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
    <input type="text" id="bedSearch" class="form-control w-auto flex-grow-1" placeholder="Search beds by number or room..." />

    <div class="d-flex align-items-center gap-2">
        <select id="sortBeds" class="form-select form-select-sm">
            <option value="">Sort by...</option>
            <option value="bed">Bed Number (A–Z)</option>
            <option value="room">Room Number (A–Z)</option>
            <option value="status">Status</option>
        </select>

        <div class="btn-group">
            <button id="gridViewBtn" class="btn btn-outline-primary active" title="Grid view">
                <i class="bi bi-grid"></i>
            </button>
            <button id="listViewBtn" class="btn btn-outline-secondary" title="List view">
                <i class="bi bi-list"></i>
            </button>
        </div>
    </div>
</div>

<div class="row g-3" id="bedsContainer">
    @foreach (var bed in Model)
    {
        var isOccupied = bed.PatientAdmissions.Any(pa => !pa.Discharges.Any());

        <div class="col-md-4 bed-card" data-bed="@bed.BedNumber.ToLower()" data-room="@bed.Room?.RoomNumber.ToLower()" data-status="@bed.Status.ToLower()">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary">Bed: @bed.BedNumber</h5>
                    <div class="d-flex justify-content-between mb-1">
                        <p class="card-text mb-0"><strong>Room:</strong> @(bed.Room?.RoomNumber ?? "N/A")</p>
                        <p class="card-text mb-0"><strong>Ward:</strong> @(bed.Room?.Ward?.Name ?? "N/A")</p>
                    </div>
                    <p class="card-text mb-1">
                        <strong>Status:</strong>
                        <span class="badge @(bed.Status == "Available" ? "bg-success" : "bg-warning")">
                            @bed.Status
                        </span>
                    </p>

                    <div class="mt-3 d-flex justify-content-between">
                        @if (bed.Status == "Occupied")
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="showOccupiedError('@bed.BedNumber')">
                                <i class="bi bi-trash3-fill me-1"></i> Delete
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteBedModal-@bed.BedId">
                                <i class="bi bi-trash3-fill me-1"></i> Delete
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Modal -->
        <div class="modal fade" id="deleteBedModal-@bed.BedId" tabindex="-1" aria-labelledby="deleteBedModalLabel-@bed.BedId" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-action="SoftDeleteBed" method="post">
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", bed.BedId)

                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Bed</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p class="fw-bold">Are you sure you want to delete this bed?</p>
                            <ul class="list-group">
                                <li class="list-group-item"><strong>Bed:</strong> @bed.BedNumber</li>
                                <li class="list-group-item"><strong>Room:</strong> @(bed.Room?.RoomNumber ?? "N/A")</li>
                                <li class="list-group-item"><strong>Status:</strong> @bed.Status</li>
                            </ul>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-danger">Yes, Delete</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.getElementById('bedSearch').addEventListener('input', function () {
            const query = this.value.toLowerCase();
            cards.forEach(card => {
                const bed = card.getAttribute('data-bed');
                const room = card.getAttribute('data-room');
                card.style.display = (bed.includes(query) || room.includes(query)) ? 'block' : 'none';
            });
        });

        //Sorting
        document.getElementById('sortBeds').addEventListener('change', function () {
            const sortBy = this.value;
            const container = document.getElementById('bedsContainer');
            const cards = Array.from(container.children);

            cards.sort((a, b) => {
                const valA = a.getAttribute(`data-${sortBy}`) || '';
                const valB = b.getAttribute(`data-${sortBy}`) || '';
                return valA.localeCompare(valB);
            });

            cards.forEach(c => container.appendChild(c));
            showPage(1);
        });

        //Grid/List toggle
        const gridBtn = document.getElementById('gridViewBtn');
        const listBtn = document.getElementById('listViewBtn');

        gridBtn.addEventListener('click', () => {
            container.classList.add('grid-view');
            container.classList.remove('list-view');
            gridBtn.classList.add('active', 'btn-outline-primary');
            listBtn.classList.remove('active');
        });

        listBtn.addEventListener('click', () => {
            container.classList.add('list-view');
            container.classList.remove('grid-view');
            listBtn.classList.add('active', 'btn-outline-primary');
            gridBtn.classList.remove('active');
        });

        //SweetAlert feedback
        @if (TempData["SuccessMessage"] != null)
        {
                <text>
                    Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: '@TempData["SuccessMessage"]', showConfirmButton: false, timer: 3000 });
                </text>
        }

        @if (TempData["ErrorMessage"] != null)
        {
                <text>
                    Swal.fire({ toast: true, position: 'top-end', icon: 'error', title: '@TempData["ErrorMessage"]', showConfirmButton: false, timer: 3000 });
                </text>
        }

        function showOccupiedError(bedNumber) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: `Bed '${bedNumber}' is occupied and cannot be deleted.`,
                showConfirmButton: false,
                timer: 3000
            });
        }
    </script>
    <script>
        const bedsPerPage = 5;
        const container = document.getElementById("bedsContainer");
        const bedCards = Array.from(container.getElementsByClassName("bed-card"));
        const paginationContainer = document.createElement("div");
        paginationContainer.classList.add("d-flex", "justify-content-center", "mt-3");
        container.after(paginationContainer);

        let currentPage = 1;
        const totalPages = Math.ceil(bedCards.length / bedsPerPage);

        function showPage(page) {
            currentPage = page;
            bedCards.forEach((card, i) => {
                card.style.display = (i >= (page - 1) * bedsPerPage && i < page * bedsPerPage) ? "block" : "none";
            });
            renderPagination();
        }

        function renderPagination() {
            paginationContainer.innerHTML = "";
            const pagination = document.createElement("ul");
            pagination.classList.add("pagination");

            // Page numbers
            for (let i = 1; i <= totalPages; i++) {
                const pageItem = document.createElement("li");
                pageItem.classList.add("page-item", ...(i === currentPage ? ["active"] : []));
                pageItem.innerHTML = `<a class="page-link" href="#">${i}</a>`;
                pageItem.onclick = e => { e.preventDefault(); showPage(i); };
                pagination.appendChild(pageItem);
            }

            paginationContainer.appendChild(pagination);
        }

        //Initialize
        showPage(1);
    </script>

}
