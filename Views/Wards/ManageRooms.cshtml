@model IEnumerable<Wellness_Wardens_Project.Models.AdministrationSubsystem.Room>

@{
    ViewData["Title"] = "Manage Rooms";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var wards = ViewBag.Wards as IEnumerable<Wellness_Wardens_Project.Models.AdministrationSubsystem.Ward>;
}

<link href="~/css/admin.css" rel="stylesheet" />
<link href="~/css/helpanimation.css" rel="stylesheet" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold"><i class="bi bi-hospital me-2"></i>Manage Rooms</h2>
    <div>
        <a asp-controller="Administration" asp-action="Dashboard" class="btn btn-outline-primary me-2">
            <i class="bi bi-house-door me-1"></i> Dashboard
        </a>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addRoomModal">
            <i class="bi bi-plus-circle me-1"></i> Add Room
        </button>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <input type="text" id="roomSearch" class="form-control"
               placeholder="🔍 Search rooms by number, type, or ward..." />
    </div>
    <div class="col-md-4">
        <select id="sortSelect" class="form-select">
            <option value="number-asc">Sort by: Room Number (A-Z)</option>
            <option value="number-desc">Sort by: Room Number (Z-A)</option>
            <option value="type-asc">Sort by: Room Type (A-Z)</option>
            <option value="type-desc">Sort by: Room Type (Z-A)</option>
            <option value="beds-asc">Sort by: Beds (Low to High)</option>
            <option value="beds-desc">Sort by: Beds (High to Low)</option>
            <option value="ward-asc">Sort by: Ward (A-Z)</option>
            <option value="ward-desc">Sort by: Ward (Z-A)</option>
        </select>
    </div>
</div>

<p style="color: red">Click room number to view beds in that room.</p>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle text-center table-fixed" id="roomsTable">
        <thead class="table-success">
            <tr>
                <th style="width:15%;">Room Number</th>
                <th style="width:20%;">Room Type</th>
                <th style="width:15%;">Total Beds</th>
                <th style="width:25%;">Ward</th>
                <th style="width:25%;">Actions</th>
            </tr>
        </thead>
        <tbody id="roomsTableBody">
            @foreach (var room in Model)
            {
                <tr class="room-row">
                    <td data-bs-toggle="collapse" data-bs-target="#beds-@room.RoomId" class="text-primary fw-bold" style="cursor: pointer;">
                        <i class="bi bi-door-open-fill me-1"></i>@room.RoomNumber
                    </td>
                    <td>@room.RoomType</td>
                    <td><span class="badge bg-info text-dark">@room.Beds?.Count()</span></td>
                    <td>@room.Ward?.Name</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-success"
                                data-bs-toggle="modal" data-bs-target="#addBedModal"
                                data-room-id="@room.RoomId">
                            <i class="bi bi-plus-circle"></i> Add Bed
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary me-2"
                                data-bs-toggle="modal"
                                data-bs-target="#editRoomModal"
                                data-id="@room.RoomId"
                                data-number="@room.RoomNumber"
                                data-type="@room.RoomType"
                                data-wardid="@room.WardId">
                            <i class="bi bi-pencil-square"></i> Edit
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#deleteModal-@room.RoomId">
                            <i class="bi bi-trash3-fill"></i> Delete
                        </button>
                    </td>
                </tr>

                <!-- Collapsible beds row -->
                <tr class="collapse bg-light bed-row" id="beds-@room.RoomId">
                    <td colspan="5" class="p-3 text-start">
                        <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-hospital-bed me-1"></i>Beds in Room @room.RoomNumber</h6>
                        @if (room.Beds != null && room.Beds.Any())
                        {
                            <div class="row">
                                @foreach (var bed in room.Beds)
                                {
                                    <div class="col-md-4 mb-2">
                                        <div class="card shadow-sm border-0">
                                            <div class="card-body d-flex justify-content-between align-items-center">
                                                <span>🛏️ <strong>@bed.BedNumber</strong></span>
                                                <span class="badge @(bed.Status == "Available" ? "bg-success" : "bg-danger")">
                                                    @bed.Status
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted fst-italic">No beds assigned to this room.</p>
                        }
                    </td>
                </tr>

                <!-- Delete Modal -->
                <div class="modal fade" id="deleteModal-@room.RoomId" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content rounded-4">
                            <form asp-action="SoftDeleteRoom" method="post">
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", room.RoomId)

                                <div class="modal-header text-white" style="background-color: #F2CB05;">
                                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Room</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>

                                <div class="modal-body">
                                    <p class="fw-bold">Are you sure you want to delete this room?</p>
                                    <ul class="list-group">
                                        <li class="list-group-item"><strong>Room Number:</strong> @room.RoomNumber</li>
                                        <li class="list-group-item"><strong>Room Type:</strong> @room.RoomType</li>
                                        <li class="list-group-item"><strong>Ward:</strong> @room.Ward?.Name</li>
                                    </ul>
                                </div>

                                <div class="modal-footer">
                                    <button type="submit" class="btn text-white" style="background-color: #F2CB05;">Yes, Delete</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>

    <div class="mt-3" id="roomsPagination"></div>
</div>

<!-- Add Room Modal -->
<div class="modal fade" id="addRoomModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4">
            <div class="modal-header text-white" style="background-color: #F2CB05;">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i> Add Room</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-action="AddRoom" method="post" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-3 position-relative">
                        <label class="form-label fw-bold">Room Number:</label>
                        <input type="text" name="RoomNumber" class="form-control" placeholder="R001" value="R" pattern="^R\d{1,3}$" required />
                        <div class="valid-feedback">✅ Looks good!</div>
                        <div class="invalid-feedback">Room number must start with 'R' followed by digits (e.g., R01, R002).</div>
                    </div>

                    <div class="mb-3 position-relative">
                        <label class="form-label fw-bold">Room Type:</label>
                        <select name="RoomType" class="form-select" required>
                            <option value="">-- Select Room Type --</option>
                            <option>Private Room (Single Room)</option>
                            <option>Semi-Private Room (Double Room)</option>
                            <option>Multi-Bed Room</option>
                            <option>Isolation Room</option>
                            <option>ICU Room</option>
                            <option>HDU Room</option>
                            <option>NICU Room</option>
                            <option>Operating Room (Theater)</option>
                            <option>Recovery Room (PACU)</option>
                            <option>Examination Room</option>
                            <option>Treatment Room</option>
                            <option>Labor & Delivery Room</option>
                            <option>Radiology Room</option>
                            <option>Dialysis Room</option>
                            <option>Therapy Room</option>
                            <option>Waiting Room</option>
                            <option>Family Room</option>
                            <option>Mental Health Room</option>
                        </select>
                        <div class="valid-feedback">✅ Looks good!</div>
                        <div class="invalid-feedback">Please select a room type.</div>
                    </div>

                    <div class="mb-3 position-relative">
                        <label class="form-label fw-bold">Ward:</label>
                        <select name="WardId" class="form-select" required>
                            <option value="">-- Select Ward --</option>
                            @foreach (var ward in wards)
                            {
                                <option value="@ward.WardId">@ward.Name</option>
                            }
                        </select>
                        <div class="valid-feedback">✅ Looks good!</div>
                        <div class="invalid-feedback">Please select a ward.</div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn text-white" style="background-color: #F2CB05;">
                            <i class="bi bi-check2-circle me-1"></i> Add Room
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Room Modal -->
<div class="modal fade" id="editRoomModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4">
            <div class="modal-header text-white" style="background-color: #F2CB05;">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i> Edit Room</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-action="EditRoom" method="post" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editRoomId" name="RoomId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Room Number:</label>
                        <input type="text" name="RoomNumber" class="form-control" id="editRoomNumber" readonly />
                    </div>

                    <div class="mb-3 position-relative">
                        <label class="form-label fw-bold">Room Type:</label>
                        <select name="RoomType" class="form-select" id="editRoomType" required>
                            <option value="">-- Select Room Type --</option>
                            <option>Private Room (Single Room)</option>
                            <option>Semi-Private Room (Double Room)</option>
                            <option>Multi-Bed Room</option>
                            <option>Isolation Room</option>
                            <option>ICU Room</option>
                            <option>HDU Room</option>
                            <option>NICU Room</option>
                            <option>Operating Room (Theater)</option>
                            <option>Recovery Room (PACU)</option>
                            <option>Examination Room</option>
                            <option>Treatment Room</option>
                            <option>Labor & Delivery Room</option>
                            <option>Radiology Room</option>
                            <option>Dialysis Room</option>
                            <option>Therapy Room</option>
                            <option>Waiting Room</option>
                            <option>Family Room</option>
                            <option>Mental Health Room</option>
                        </select>
                        <div class="valid-feedback">✅ Looks good!</div>
                        <div class="invalid-feedback">Please select a room type.</div>
                    </div>

                    <div class="mb-3 position-relative">
                        <label class="form-label fw-bold">Ward:</label>
                        <select name="WardId" class="form-select" id="editWardId" required>
                            <option value="">-- Select Ward --</option>
                            @foreach (var ward in wards)
                            {
                                <option value="@ward.WardId">@ward.Name</option>
                            }
                        </select>
                        <div class="valid-feedback">✅ Looks good!</div>
                        <div class="invalid-feedback">Please select a ward.</div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn text-white" style="background-color: #F2CB05;">
                            <i class="bi bi-check2-circle me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Add Bed Modal -->
<div class="modal fade" id="addBedModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-hospital-bed me-2"></i> Add Bed</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-action="AddBed" method="post" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="bedRoomId" name="RoomId" />

                    <div class="mb-3 position-relative">
                        <label class="form-label fw-bold">Bed Number:</label>
                        <input type="text" name="BedNumber" class="form-control" placeholder="B01"
                               value="B" pattern="^B\d{1,3}$" required />
                        <div class="valid-feedback">✅ Looks good!</div>
                        <div class="invalid-feedback">Bed number must start with 'B' followed by digits (e.g., B01, B02).</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Status:</label>
                        <input name="Status" class="form-control" readonly value="Available" />
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check2-circle me-1"></i> Add Bed
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Search Filter -->
    <script>
        const roomSearchInput = document.getElementById('roomSearch');
        const roomsTableBody = document.getElementById('roomsTableBody');
        let allRoomRows = Array.from(roomsTableBody.querySelectorAll('.room-row'));
        let allBedRows = Array.from(roomsTableBody.querySelectorAll('.bed-row'));
        let filteredRoomRows = [...allRoomRows];
        let filteredBedRows = [...allBedRows];

        function performSearch() {
            const query = roomSearchInput.value.toLowerCase();

            filteredRoomRows = allRoomRows.filter(row => {
                const numberText = row.children[0].textContent.toLowerCase();
                const typeText = row.children[1].textContent.toLowerCase();
                const wardText = row.children[3].textContent.toLowerCase();
                return numberText.includes(query) || typeText.includes(query) || wardText.includes(query);
            });

            // Update bed rows to match filtered room rows
            filteredBedRows = [];
            filteredRoomRows.forEach(roomRow => {
                const collapseTarget = roomRow.querySelector('td[data-bs-target]').getAttribute('data-bs-target');
                const bedRow = document.querySelector(collapseTarget);
                if (bedRow) {
                    filteredBedRows.push(bedRow);
                }
            });

            displayPage(1);
        }

        roomSearchInput.addEventListener('keyup', performSearch);
    </script>

    <!-- Sorting + Pagination -->
    <script>
        const sortSelect = document.getElementById('sortSelect');
        const rowsPerPage = 9;
        let currentPage = 1;

        function displayPage(page) {
            currentPage = page;
            const start = (page - 1) * rowsPerPage;
            const end = start + rowsPerPage;

            // Hide all rows first
            allRoomRows.forEach(row => row.style.display = 'none');
            allBedRows.forEach(row => row.style.display = 'none');

            // Show only filtered rows for current page
            filteredRoomRows.forEach((roomRow, index) => {
                if (index >= start && index < end) {
                    roomRow.style.display = '';
                    const collapseTarget = roomRow.querySelector('td[data-bs-target]').getAttribute('data-bs-target');
                    const bedRow = document.querySelector(collapseTarget);
                    if (bedRow) {
                        bedRow.style.display = '';
                    }
                }
            });

            renderPagination();
        }

        function renderPagination() {
            const paginationContainer = document.getElementById('roomsPagination');
            paginationContainer.innerHTML = '';
            const totalPages = Math.ceil(filteredRoomRows.length / rowsPerPage);

            if (totalPages > 1) {
                // Previous button
                if (currentPage > 1) {
                    const prevBtn = document.createElement('button');
                    prevBtn.className = 'btn btn-sm btn-outline-primary me-1';
                    prevBtn.innerHTML = '<i class="bi bi-chevron-left"></i>';
                    prevBtn.addEventListener('click', () => displayPage(currentPage - 1));
                    paginationContainer.appendChild(prevBtn);
                }

                // Page buttons
                for (let i = 1; i <= totalPages; i++) {
                    const btn = document.createElement('button');
                    btn.className = 'btn btn-sm me-1 ' + (i === currentPage ? 'btn-primary' : 'btn-outline-primary');
                    btn.innerText = i;
                    btn.addEventListener('click', () => displayPage(i));
                    paginationContainer.appendChild(btn);
                }

                // Next button
                if (currentPage < totalPages) {
                    const nextBtn = document.createElement('button');
                    nextBtn.className = 'btn btn-sm btn-outline-primary me-1';
                    nextBtn.innerHTML = '<i class="bi bi-chevron-right"></i>';
                    nextBtn.addEventListener('click', () => displayPage(currentPage + 1));
                    paginationContainer.appendChild(nextBtn);
                }
            }
        }

        function sortTable(sortValue) {
            const [column, direction] = sortValue.split('-');
            const isAsc = direction === 'asc';

            filteredRoomRows.sort((a, b) => {
                let aValue, bValue;

                switch (column) {
                    case 'number':
                        aValue = a.children[0].textContent.trim().toLowerCase();
                        bValue = b.children[0].textContent.trim().toLowerCase();
                        break;
                    case 'type':
                        aValue = a.children[1].textContent.trim().toLowerCase();
                        bValue = b.children[1].textContent.trim().toLowerCase();
                        break;
                    case 'beds':
                        aValue = parseInt(a.children[2].textContent) || 0;
                        bValue = parseInt(b.children[2].textContent) || 0;
                        break;
                    case 'ward':
                        aValue = a.children[3].textContent.trim().toLowerCase();
                        bValue = b.children[3].textContent.trim().toLowerCase();
                        break;
                    default:
                        aValue = a.children[0].textContent.trim().toLowerCase();
                        bValue = b.children[0].textContent.trim().toLowerCase();
                }

                if (aValue < bValue) return isAsc ? -1 : 1;
                if (aValue > bValue) return isAsc ? 1 : -1;
                return 0;
            });

            // Rebuild bed rows array to match sorted room rows
            filteredBedRows = [];
            filteredRoomRows.forEach(roomRow => {
                const collapseTarget = roomRow.querySelector('td[data-bs-target]').getAttribute('data-bs-target');
                const bedRow = document.querySelector(collapseTarget);
                if (bedRow) {
                    filteredBedRows.push(bedRow);
                }
            });

            // Reorder DOM elements
            filteredRoomRows.forEach(roomRow => {
                roomsTableBody.appendChild(roomRow);
                const collapseTarget = roomRow.querySelector('td[data-bs-target]').getAttribute('data-bs-target');
                const bedRow = document.querySelector(collapseTarget);
                if (bedRow) {
                    roomsTableBody.appendChild(bedRow);
                    bedRow.classList.remove('show'); 
                    const bsCollapse = new bootstrap.Collapse(bedRow, { toggle: false });
                    bsCollapse.hide();
                    bedRow.style.display = 'none';
                }
            });

            displayPage(1);
        }

        sortSelect.addEventListener('change', function() {
            sortTable(this.value);
        });

        sortTable('number-asc');
        displayPage(1);
    </script>

    <!-- Modal Scripts -->
    <script>
        // Add Bed Modal
        var addBedModal = document.getElementById('addBedModal');
        addBedModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var roomId = button.getAttribute('data-room-id');
            document.getElementById('bedRoomId').value = roomId;
        });

        // Edit Room Modal
        var editRoomModal = document.getElementById('editRoomModal');
        editRoomModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            document.getElementById('editRoomId').value = button.getAttribute('data-id');
            document.getElementById('editRoomNumber').value = button.getAttribute('data-number');
            document.getElementById('editRoomType').value = button.getAttribute('data-type');
            document.getElementById('editWardId').value = button.getAttribute('data-wardid');
        });

        // Toast messages
        function showToast(type, message) {
            if (!message) return;
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: type,
                title: message,
                showConfirmButton: false,
                timer: 3000
            });
        }

        var successMessage = '@TempData["SuccessMessage"]';
        if (successMessage) {
            showToast('success', successMessage);
        }

        @foreach (var modelState in ViewData.ModelState.Values)
        {
                foreach (var error in modelState.Errors)
                {
                        <text>
                            showToast('error', '@error.ErrorMessage');
                        </text>
                }
        }
    </script>

    <!-- Form Validation -->
    <script>
        (function () {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}